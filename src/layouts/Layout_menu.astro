---
import '../styles/global.css';
import polloLogo from '../assets/pollo_fresa.webp';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Menú | Pollo Fresa & Fresa Wings',
  description = 'Elige entre pollo rostizado, alitas, boneless, hamburguesas, combos y acompañamientos de Pollo Fresa y Fresa Wings.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={polloLogo.src} />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; background: #fff4df; }
</style>
