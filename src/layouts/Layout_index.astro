---
import '../styles/global.css'
import polloLogo from '../assets/pollo_fresa.webp';
---


<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={polloLogo.src} />
		<meta name="generator" content={Astro.generator} />
		<title>Pollo Fresa</title>
	</head>
	<body>
		<slot />
	</body>
