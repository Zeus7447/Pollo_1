---
import type { CatalogCategory, CatalogProduct } from '../lib/directus';

interface Props { brand: 'Pollo Fresa' | 'Fresa Wings'; theme: 'pollo' | 'wings'; products: CatalogProduct[]; categories: CatalogCategory[]; demo?: boolean }
const { brand, theme, products, categories, demo = true } = Astro.props;
const leadProduct = products.find((product) => product.featured && product.image) ?? products.find((product) => product.image);
const visibleCategories = categories.filter((category) => products.some((product) => product.categoryId === category.id));
const uncategorized = products.filter((product) => !product.categoryId || !categories.some((category) => category.id === product.categoryId));
const money = (price: string) => price;
---

<div class:list={['prototype', `prototype-${theme}`, !demo && 'production-menu']} id={!demo ? 'fresa-wings-menu' : undefined} data-catalog-brand={!demo ? 'Fresa Wings' : undefined}>
  {demo && <div class="preview-bar"><span>Vista de concepto</span><span>Pedidos desactivados</span></div>}
  {demo && <header class="proto-header">
    <a class="wordmark" href="#inicio" aria-label={`${brand}, inicio`}><span class="mark">{theme === 'pollo' ? 'PF' : 'FW'}</span><span>{brand}<small>{theme === 'pollo' ? 'POLLO · FUEGO · TRADICIÓN' : 'WINGS · BONeless · STREET FOOD'}</small></span></a>
    <nav aria-label="Navegación del menú" class="top-links"><a href={demo ? '#menu' : '#wings-menu-list'}>Menú</a><a href="#categorias">Categorías</a><a href="#nota">Acerca del prototipo</a></nav>
    <span class="demo-pill"><i></i> Solo demostración</span>
  </header>}

  <section class="cover" id={demo ? 'inicio' : 'wings-inicio'} aria-labelledby={demo ? 'cover-title' : 'wings-cover-title'}>
    <div class="cover-copy">
      <p class="kicker">{theme === 'pollo' ? 'Una tradición que se sirve al centro' : 'Sabor sin pedir permiso'}</p>
      <h1 id={demo ? 'cover-title' : 'wings-cover-title'}>{theme === 'pollo' ? <>El fuego<br /><em>se comparte.</em></> : <>Manos listas.<br /><em>Que empiece.</em></>}</h1>
      <p class="cover-intro">{theme === 'pollo' ? 'Pollo hecho para reunir a todos alrededor de la mesa.' : 'Alitas, boneless y antojos para entrarle con todo.'}</p>
      <a class="cover-link" href={demo ? '#menu' : '#wings-menu-list'}>Explorar el menú <span aria-hidden="true">↘</span></a>
      <span class="cover-index">{theme === 'pollo' ? 'RECETA DE CASA · DESDE SIEMPRE' : 'CRUJIENTE. BAÑADO. INOLVIDABLE.'}</span>
    </div>
    <div class="cover-art" aria-label={leadProduct ? `Fotografía del producto ${leadProduct.name}` : undefined}>
      {leadProduct?.image ? <img src={leadProduct.image} alt={leadProduct.name} fetchpriority="high" /> : <div class="photo-unavailable">Fotografía no disponible</div>}
      <div class="art-note"><span>DEL MENÚ</span><b>{leadProduct?.name ?? brand}</b></div>
      <span class="art-number">01</span>
    </div>
    <span class="vertical-note" aria-hidden="true">{brand} — MENÚ</span>
  </section>

  <section class="category-band" id={demo ? 'categorias' : 'wings-categorias'} aria-label="Explorar categorías">
    <span>ENCUENTRA TU ANTOJO</span>
    <div class="category-links">
      {visibleCategories.map((category, index) => <a href={`#categoria-${category.id}`}><i>{String(index + 1).padStart(2, '0')}</i>{category.name}<b aria-hidden="true">↗</b></a>)}
      {uncategorized.length > 0 && <a href="#categoria-otros"><i>+</i>Más del menú<b aria-hidden="true">↗</b></a>}
    </div>
  </section>

  <section class="menu-area" id={demo ? 'menu' : 'wings-menu-list'}>
    <div class="menu-heading"><p class="kicker">{theme === 'pollo' ? 'El menú de la casa' : 'Elige tu siguiente obsesión'}</p><h2>Hecho para<br /><em>{theme === 'pollo' ? 'disfrutarse.' : 'compartirse.'}</em></h2><p>{products.length} productos disponibles en esta vista</p></div>
    {visibleCategories.map((category, categoryIndex) => {
      const categoryProducts = products.filter((product) => product.categoryId === category.id);
      return <section class:list={['product-section', categoryIndex % 2 === 1 && 'reverse']} id={`categoria-${category.id}`} aria-labelledby={`heading-${category.id}`}>
        <header class="section-title"><span>{String(categoryIndex + 1).padStart(2, '0')}</span><h3 id={`heading-${category.id}`}>{category.name}</h3><i>{String(categoryProducts.length).padStart(2, '0')} opciones</i></header>
        <div class="product-list">
          {categoryProducts.map((product, productIndex) => <article class:list={['product', product.featured && 'featured-product', !demo && 'product-card', !demo && 'product-wings']} data-product-id={!demo ? product.id : undefined}>
            <div class="product-photo">
              {product.image ? <img src={product.image} alt={product.name} loading="lazy" /> : <div class="photo-unavailable">Fotografía no disponible</div>}
              {product.featured && <span class="featured-label">Favorito de la casa</span>}
              <span class="photo-count">{String(productIndex + 1).padStart(2, '0')}</span>
            </div>
            <div class="product-copy">
              <span class="product-category">{product.category}</span>
              <h4>{product.name}</h4>
              <p>{product.description}</p>
              {product.optionGroups.length > 0 && <div class="option-note"><span>Personalización disponible</span><b>{product.optionGroups.map((group) => group.name).join(' · ')}</b></div>}
              <div class="buy-row"><strong>{money(product.price)}</strong>{demo ? <button type="button" disabled aria-describedby={`disabled-${product.id}`}>Agregar <span aria-hidden="true">＋</span></button> : <button type="button" class="add-button" aria-label={`Agregar ${product.name} al pedido`}>Agregar <span>＋</span></button>}{demo && <small id={`disabled-${product.id}`}>Desactivado en esta demostración</small>}</div>
            </div>
          </article>)}
        </div>
      </section>;
    })}
    {uncategorized.length > 0 && <section class="product-section" id="categoria-otros"><header class="section-title"><span>+</span><h3>Más del menú</h3><i>{uncategorized.length} opciones</i></header><div class="product-list">{uncategorized.map((product, productIndex) => <article class:list={['product', !demo && 'product-card', !demo && 'product-wings']} data-product-id={!demo ? product.id : undefined}><div class="product-photo">{product.image ? <img src={product.image} alt={product.name} loading="lazy" /> : <div class="photo-unavailable">Fotografía no disponible</div>}<span class="photo-count">{String(productIndex + 1).padStart(2, '0')}</span></div><div class="product-copy"><span class="product-category">{product.category}</span><h4>{product.name}</h4><p>{product.description}</p><div class="buy-row"><strong>{product.price}</strong>{demo ? <button type="button" disabled>Agregar <span aria-hidden="true">＋</span></button> : <button type="button" class="add-button" aria-label={`Agregar ${product.name} al pedido`}>Agregar <span>＋</span></button>}</div></div></article>)}</div></section>}
    {products.length === 0 && <p class="empty-catalog">No hay productos disponibles para esta marca en este momento.</p>}
  </section>

  {demo && <footer class="proto-footer" id="nota"><span>{brand}</span><p>Prototipo visual conectado al catálogo disponible. El carrito y los pedidos permanecen desactivados.</p><a href="#inicio">Volver arriba ↑</a></footer>}
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Barlow+Condensed:wght@500;600;700;800;900&display=swap');
  .prototype{--accent:#b93827;--paper:#f1e9da;--ink:#251e19;--muted:#756d62;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;--display:'Barlow Condensed',Impact,sans-serif;color:var(--ink);font-family:var(--sans);overflow:hidden}
  .prototype-wings{--accent:#ff5835;--paper:#151312;--ink:#fff8eb;--muted:#b7aaa0;background:#151312}
  .preview-bar{min-height:28px;display:flex;justify-content:space-between;align-items:center;padding:4px 5vw;background:#221d18;color:#fff3e6;font:700 9px var(--sans);letter-spacing:.14em;text-transform:uppercase}
  .prototype-wings .preview-bar{background:#ff5835;color:#1d1512}
  .proto-header{height:76px;padding:0 6vw;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}
  .wordmark{display:flex;align-items:center;gap:12px;font-weight:800;font-size:14px;letter-spacing:-.04em}.wordmark small{display:block;margin-top:4px;color:var(--muted);font-size:8px;letter-spacing:.12em}.mark{width:36px;height:36px;border:1px solid var(--accent);display:grid;place-items:center;color:var(--accent);font:700 13px var(--display);transform:rotate(-8deg)}
  .top-links{display:flex;gap:30px;color:var(--muted);font-size:11px;font-weight:700}.top-links a:hover,.top-links a:focus-visible{color:var(--accent)}.demo-pill{display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid color-mix(in srgb,var(--ink) 22%,transparent);border-radius:99px;font-size:9px;font-weight:700}.demo-pill i{width:7px;height:7px;background:#d69536;border-radius:50%}
  .cover{min-height:590px;display:grid;grid-template-columns:.94fr 1.06fr;align-items:center;position:relative;padding:46px 10vw 76px;gap:4vw}.cover-copy{position:relative;z-index:2}.kicker{text-transform:uppercase;letter-spacing:.18em;font-size:9px;font-weight:800;color:var(--accent)}.cover h1{max-width:560px;margin:24px 0;font:600 clamp(58px,8.4vw,125px)/.91 var(--serif);letter-spacing:-.075em}.cover h1 em,.menu-heading h2 em{color:var(--accent);font-weight:600}.cover-intro{max-width:310px;color:var(--muted);font-size:14px;line-height:1.7}.cover-link{display:inline-flex;gap:22px;align-items:center;margin-top:23px;padding-bottom:9px;border-bottom:1px solid var(--accent);font-size:11px;font-weight:800}.cover-link span{font-size:20px;color:var(--accent)}.cover-index{display:block;margin-top:72px;color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.18em}
  .cover-art{height:480px;position:relative;margin-right:-6vw}.cover-art:before{content:'';position:absolute;inset:8% 12% 2% 2%;background:#d5c5aa;transform:rotate(-5deg)}.prototype-wings .cover-art:before{background:#ff5835;inset:4% 8% 4% 8%;transform:rotate(5deg)}.cover-art>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;clip-path:polygon(8% 0,100% 4%,95% 100%,0 92%);filter:saturate(1.05)}.art-note{position:absolute;z-index:2;left:0;bottom:22px;min-width:190px;padding:15px 20px;background:var(--paper);box-shadow:0 10px 40px #0002}.art-note span,.art-note b{display:block}.art-note span{font-size:8px;letter-spacing:.16em;color:var(--accent);font-weight:800}.art-note b{margin-top:6px;font:600 18px var(--serif)}.art-number{position:absolute;right:8px;top:2px;color:var(--ink);font:800 14px var(--display)}.vertical-note{position:absolute;right:2vw;top:40%;writing-mode:vertical-rl;font-size:8px;letter-spacing:.2em;color:var(--muted)}.photo-unavailable{display:grid;place-items:center;width:100%;height:100%;background:color-mix(in srgb,var(--ink) 8%,var(--paper));color:var(--muted);font-size:12px}
  .category-band{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:start;padding:26px 10vw 29px;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);border-bottom:1px solid color-mix(in srgb,var(--ink) 20%,transparent)}.category-band>span{padding-top:12px;font-size:8px;font-weight:800;letter-spacing:.16em;color:var(--muted)}.category-links{display:flex;flex-wrap:wrap;gap:9px}.category-links a{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid color-mix(in srgb,var(--ink) 20%,transparent);font-size:10px;font-weight:700;transition:background .2s,color .2s,transform .2s}.category-links a:hover{background:var(--accent);color:#fff;transform:translateY(-2px)}.category-links i{font:700 11px var(--display);color:var(--accent)}.category-links a:hover i,.category-links a:hover b{color:#fff}.category-links b{margin-left:4px;color:var(--accent)}
  .menu-area{padding:115px 10vw 100px}.menu-heading{display:grid;grid-template-columns:1fr 1fr;align-items:end;margin-bottom:86px}.menu-heading .kicker{grid-column:1/-1}.menu-heading h2{margin-top:9px;font:600 clamp(48px,7vw,90px)/.94 var(--serif);letter-spacing:-.07em}.menu-heading>p:last-child{justify-self:end;margin:0 0 6px;color:var(--muted);font-size:10px}
  .product-section{margin-bottom:92px;scroll-margin-top:24px}.section-title{display:grid;grid-template-columns:42px auto 1fr;align-items:center;gap:13px;padding-bottom:16px;border-bottom:1px solid color-mix(in srgb,var(--ink) 28%,transparent)}.section-title>span{color:var(--accent);font:700 14px var(--display)}.section-title h3{font:700 32px var(--serif);letter-spacing:-.045em}.section-title i{justify-self:end;color:var(--muted);font:700 9px var(--sans);letter-spacing:.1em;text-transform:uppercase}
  .product-list{display:grid;grid-template-columns:1fr 1fr;gap:48px 5vw;padding-top:30px}.product{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:20px;min-width:0}.product:nth-child(even){transform:translateY(38px)}.product-photo{height:245px;position:relative;background:color-mix(in srgb,var(--ink) 7%,var(--paper));overflow:hidden}.product-photo img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.75,.2,1)}.product:hover .product-photo img{transform:scale(1.045)}.featured-product .product-photo{height:305px}.featured-label,.photo-count{position:absolute;top:11px;padding:7px 9px;background:var(--paper);color:var(--accent);font-size:8px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.featured-label{left:11px}.photo-count{right:11px;color:var(--ink)}.product-copy{padding:8px 0}.product-category{color:var(--accent);font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.product-copy h4{margin:10px 0 9px;font:600 clamp(18px,2vw,27px)/1.05 var(--serif);letter-spacing:-.04em}.product-copy>p{margin:0;color:var(--muted);font-size:10px;line-height:1.7}.buy-row{display:grid;grid-template-columns:1fr auto;align-items:center;gap:8px 10px;margin-top:20px}.buy-row strong{font:700 22px var(--display);letter-spacing:-.02em}.buy-row button{min-height:38px;padding:0 12px;border:0;background:var(--accent);color:#fff;font:700 10px var(--sans)}.buy-row button span{padding-left:8px;font-size:15px}.buy-row button:disabled{opacity:.72;cursor:not-allowed}.buy-row small{grid-column:1/-1;color:var(--muted);font-size:8px}.option-note{display:flex;flex-direction:column;gap:4px;margin-top:12px;padding-left:9px;border-left:2px solid var(--accent);font-size:8px;color:var(--muted)}.option-note b{color:var(--ink);font-size:9px}.reverse .product:nth-child(odd){transform:translateY(38px)}.reverse .product:nth-child(even){transform:none}
  .prototype-wings .cover h1,.prototype-wings .menu-heading h2{font-family:var(--display);font-weight:900;font-size:clamp(74px,11vw,158px);line-height:.78;letter-spacing:-.055em;text-transform:uppercase}.prototype-wings .cover h1 em,.prototype-wings .menu-heading h2 em{color:#ff5835;font-style:normal}.prototype-wings .cover-copy .kicker,.prototype-wings .menu-heading .kicker{color:#ff7756}.prototype-wings .cover-art>img{clip-path:polygon(0 0,92% 0,100% 89%,10% 100%)}.prototype-wings .art-note{background:#ff5835;color:#171311}.prototype-wings .art-note span{color:#27140f}.prototype-wings .product-section{padding:26px 28px 34px;background:#211e1b;clip-path:polygon(0 1%,100% 0,98.8% 100%,1% 98%)}.prototype-wings .section-title{border-color:#ffffff33}.prototype-wings .section-title h3{font:800 38px var(--display);letter-spacing:.01em;text-transform:uppercase}.prototype-wings .product-photo{background:#332a24}.prototype-wings .product-photo img{clip-path:polygon(0 4%,100% 0,96% 100%,4% 94%)}.prototype-wings .product-copy h4{font:800 clamp(22px,2.4vw,34px)/.95 var(--display);text-transform:uppercase;letter-spacing:.005em}.prototype-wings .buy-row strong{font-size:28px}.prototype-wings .buy-row button{font-weight:800;text-transform:uppercase;letter-spacing:.05em}.prototype-wings .product:nth-child(even){transform:translateY(20px)}.prototype-wings .reverse .product:nth-child(odd){transform:translateY(20px)}
  .proto-footer{display:grid;grid-template-columns:1fr 2fr 1fr;align-items:center;gap:20px;padding:25px 10vw;border-top:1px solid color-mix(in srgb,var(--ink) 20%,transparent);font-size:9px}.proto-footer>span{font:700 17px var(--serif)}.proto-footer p{color:var(--muted);line-height:1.6}.proto-footer a{justify-self:end;color:var(--accent);font-weight:800}.empty-catalog{padding:50px 0;color:var(--muted)}
  /* Public catalog cards inherit the storefront's light .product-card and .add-button rules.
     Keep this override inside the production Fresa Wings root; demo and Pollo styles stay untouched. */
  .production-menu.prototype-wings{--ink:#fff5e8;--muted:#cbbdb4;--accent:#ff5037;background:#151211;color:#fff5e8}
  .production-menu.prototype-wings .menu-area{background:#151211;color:#fff5e8}
  .production-menu.prototype-wings .menu-heading>p:last-child,
  .production-menu.prototype-wings .product-copy>p,
  .production-menu.prototype-wings .option-note{color:#cbbdb4}
  .production-menu.prototype-wings .section-title{border-color:#51423b}
  .production-menu.prototype-wings .section-title h3,
  .production-menu.prototype-wings .product-copy h4,
  .production-menu.prototype-wings .option-note b{color:#fff5e8}
  .production-menu.prototype-wings .product-section{background:#151211}
  .production-menu.prototype-wings .product-card{padding:14px;background:#24201e;color:#fff5e8;border:1px solid #51423b;box-shadow:none}
  .production-menu.prototype-wings .product-photo{background:#24201e}
  .production-menu.prototype-wings .product-category{color:#ff725e}
  .production-menu.prototype-wings .featured-label,
  .production-menu.prototype-wings .photo-count{background:#24201e;color:#fff5e8;border:1px solid #51423b}
  .production-menu.prototype-wings .buy-row strong{color:#fff5e8}
  .production-menu.prototype-wings .buy-row button.add-button{position:relative;isolation:isolate;min-height:44px;border:1px solid #ff5037;background:#ff5037;color:#151211;cursor:pointer}
  .production-menu.prototype-wings .buy-row button.add-button::before{content:none}
  .production-menu.prototype-wings .buy-row button.add-button .add-button-label,
  .production-menu.prototype-wings .buy-row button.add-button>span{position:relative;z-index:1;color:#151211;-webkit-text-fill-color:#151211;opacity:1}
  .production-menu.prototype-wings .buy-row button.add-button:hover:not(.is-added){background:#ff725e;color:#151211;border-color:#ff725e;box-shadow:0 6px 16px #ff503733}
  .production-menu.prototype-wings .buy-row button.add-button:hover:not(.is-added) span{color:#151211}
  .production-menu.prototype-wings .buy-row button.add-button:focus-visible{outline:3px solid #fff5e8;outline-offset:3px}
  .production-menu.prototype-wings .buy-row button.add-button.is-added{background:#151211;color:#fff5e8;border-color:#ff5037}
  .production-menu.prototype-wings .buy-row button.add-button.is-added .add-button-label{color:#fff5e8;-webkit-text-fill-color:#fff5e8}
  .production-menu.prototype-wings .buy-row button.add-button.is-added>span{color:#ff725e;-webkit-text-fill-color:#ff725e}
  .production-menu.prototype-wings .buy-row button:disabled{background:#51423b;color:#cbbdb4;border-color:#51423b;opacity:1}
  /* The storefront script replaces button contents at runtime; those new spans do not
     receive Astro's scoped attribute, so target them globally beneath this isolated root. */
  :global(.production-menu.prototype-wings .buy-row button.add-button .add-button-label),
  :global(.production-menu.prototype-wings .buy-row button.add-button>span){position:relative;z-index:2;color:#151211;-webkit-text-fill-color:#151211;opacity:1}
  :global(.production-menu.prototype-wings .buy-row button.add-button:hover:not(.is-added) .add-button-label),
  :global(.production-menu.prototype-wings .buy-row button.add-button:hover:not(.is-added)>span){color:#151211;-webkit-text-fill-color:#151211}
  :global(.production-menu.prototype-wings .buy-row button.add-button.is-added .add-button-label){color:#fff5e8;-webkit-text-fill-color:#fff5e8}
