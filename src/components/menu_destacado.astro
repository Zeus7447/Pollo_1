---
import rostizado from '../assets/rostizado/rortizado_1.webp';
import frito from '../assets/frito/10_piezas.webp';
import asado from '../assets/asado/asado_1.webp';

const products = [
  { label: 'El favorito', name: 'Pollo rostizado', description: 'Dorado lentamente hasta quedar jugoso y lleno de sabor.', price: '$249', image: rostizado, accent: 'red' },
  { label: 'Para compartir', name: 'Alitas fritas', description: 'Diez piezas crujientes para disfrutar con tu salsa favorita.', price: 'Desde $139', image: frito, accent: 'yellow' },
  { label: 'Sabor al fuego', name: 'Pollo asado', description: 'Asado al fuego para conseguir un sabor intenso y casero.', price: 'Desde $179', image: asado, accent: 'orange' },
];

const loopProducts = products.map((product, index) => ({
  ...product,
  realIndex: index,
}));
---

<section class="featured" aria-labelledby="menu-destacado" data-carousel>
  <div class="inner">
    <header class="heading">
      <div><p class="eyebrow"><span></span> Nuestros favoritos</p><h2 id="menu-destacado">Menú <i>destacado</i></h2></div>
      <div class="controls"><button type="button" data-prev aria-label="Anterior">←</button><button type="button" data-next aria-label="Siguiente">→</button></div>
    </header>

    <div class="carousel" data-stage tabindex="0" aria-roledescription="carrusel">
      <div class="carousel-track" data-track>
      {loopProducts.map((product, index) => (
        <article class="slide" data-slide data-real-index={product.realIndex} aria-hidden={index === 1 ? 'false' : 'true'}>
          <div class="visual"><img src={product.image.src} alt={product.name} /><span class:list={['tag', product.accent]}>{product.label}</span><span class="counter">0{index + 1} / 0{products.length}</span></div>
          <div class="content"><span class="mini">POLLO FRESA · RECIÉN HECHO</span><h3>{product.name}</h3><p>{product.description}</p><strong>{product.price}</strong><a href="/menu">Ver producto <span>↗</span></a></div>
        </article>
      ))}
      </div>
    </div>

    <footer class="carousel-footer">
      <div class="dots">{products.map((product, index) => <button type="button" class:list={{ active: index === 0 }} data-dot={index} aria-label={`Mostrar ${product.name}`}><span></span></button>)}</div>
      <span class="autoplay"><i></i> Deslizamiento automático</span>
      <a href="/menu">Ver menú completo <span>↗</span></a>
    </footer>
  </div>
</section>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const stage = root.querySelector('[data-stage]');
    let current = 0;
    let timer;
    let touchStart = 0;

    const show = (next) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.classList.toggle('active', index === current);
        slide.classList.toggle('previous', index < current);
        slide.setAttribute('aria-hidden', index === current ? 'false' : 'true');
      });
      dots.forEach((dot, index) => dot.classList.toggle('active', index === current));
    };
    const start = () => { window.clearInterval(timer); timer = window.setInterval(() => show(current + 1), 4500); };
    const stop = () => window.clearInterval(timer);

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(current - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(current + 1); start(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index); start(); }));
    stage?.addEventListener('mouseenter', stop);
    stage?.addEventListener('mouseleave', start);
    stage?.addEventListener('focusin', stop);
    stage?.addEventListener('focusout', start);
    stage?.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') show(current - 1); if (event.key === 'ArrowRight') show(current + 1); });
    stage?.addEventListener('touchstart', (event) => { touchStart = event.touches[0].clientX; stop(); }, { passive: true });
    stage?.addEventListener('touchend', (event) => { const distance = event.changedTouches[0].clientX - touchStart; if (Math.abs(distance) > 45) show(current + (distance < 0 ? 1 : -1)); start(); }, { passive: true });
    start();
  });
</script>

<style>
  .featured { padding: 108px 32px 118px; overflow: hidden; background: #fff4df; }.inner { width: min(1160px, 100%); margin: auto; }.heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 42px; }.eyebrow { margin: 0 0 13px; color: #c51f2b; font-size: 10px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }.eyebrow span { display: inline-block; width: 29px; height: 2px; margin: 0 11px 3px 0; background: #c51f2b; }h2 { margin: 0; color: #422018; font-family: 'Playfair Display', serif; font-size: clamp(43px, 5vw, 68px); letter-spacing: -.06em; line-height: .88; }h2 i { color: #c51f2b; font-weight: 600; }.controls { display: flex; gap: 9px; }.controls button { display: grid; width: 50px; height: 50px; place-items: center; border: 1px solid #42201855; border-radius: 50%; color: #422018; background: transparent; font-size: 20px; cursor: pointer; transition: .2s ease; }.controls button:hover { color: #fff4df; background: #c51f2b; border-color: #c51f2b; transform: scale(1.06); }.carousel { position: relative; height: 520px; overflow: hidden; background: #422018; outline: none; }.slide { position: absolute; inset: 0; display: grid; grid-template-columns: 64% 36%; visibility: hidden; opacity: 0; transform: translateX(8%); transition: opacity .65s ease, transform .65s cubic-bezier(.22,.8,.24,1), visibility .65s; pointer-events: none; }.slide.previous { transform: translateX(-8%); }.slide.active { z-index: 2; visibility: visible; opacity: 1; transform: translateX(0); pointer-events: auto; }.visual { position: relative; overflow: hidden; }.visual::after { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 60%, #422018); content: ''; }.visual img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 5s ease; }.slide.active .visual img { transform: scale(1); }.tag { position: absolute; z-index: 1; top: 25px; left: 25px; padding: 10px 13px; color: #fff; font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }.tag.red { background: #c51f2b; }.tag.yellow { color: #422018; background: #ffd36a; }.tag.orange { background: #f28c16; }.tag.brown { background: #422018; }.counter { position: absolute; z-index: 1; right: 24px; bottom: 22px; color: #ffd36a; font-family: 'Playfair Display', serif; font-size: 15px; font-style: italic; }.content { display: flex; flex-direction: column; justify-content: center; padding: 45px 48px 45px 35px; color: #fff4df; background: #422018; }.mini { color: #ffd36a; font-size: 8px; font-weight: 700; letter-spacing: .17em; }.content h3 { margin: 18px 0 15px; font-family: 'Playfair Display', serif; font-size: clamp(40px, 4vw, 61px); letter-spacing: -.055em; line-height: .88; }.content > p { max-width: 280px; margin: 0 0 24px; color: #fff4dfb8; font-size: 13px; line-height: 1.65; }.content strong { margin-bottom: 36px; color: #ffd36a; font-size: 17px; }.content > a { align-self: start; padding: 15px 18px; color: #fff; background: #c51f2b; font-size: 11px; font-weight: 700; text-decoration: none; }.content > a span { margin-left: 25px; color: #ffd36a; font-size: 17px; }.carousel-footer { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-top: 20px; }.dots { display: flex; gap: 6px; }.dots button { width: 42px; height: 12px; padding: 4px 0; border: 0; background: transparent; cursor: pointer; }.dots button span { display: block; height: 2px; background: #4220183d; transition: .25s ease; }.dots button.active span { height: 4px; background: #c51f2b; }.autoplay { color: #80695b; font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }.autoplay i { display: inline-block; width: 6px; height: 6px; margin-right: 7px; background: #f28c16; border-radius: 50%; animation: pulse 1.5s infinite; }.carousel-footer > a { justify-self: end; padding-bottom: 8px; border-bottom: 2px solid #c51f2b; color: #c51f2b; font-size: 11px; font-weight: 700; text-decoration: none; }.carousel-footer > a span { margin-left: 9px; font-size: 17px; }@keyframes pulse { 50% { opacity: .3; transform: scale(.7); } }
  @media (max-width: 800px) { .carousel { height: 650px; }.slide { grid-template-columns: 1fr; grid-template-rows: 60% 40%; }.visual::after { background: linear-gradient(180deg, transparent 70%, #422018); }.content { padding: 25px 30px; }.content h3 { margin: 10px 0; }.content > p { margin-bottom: 12px; }.content strong { margin-bottom: 15px; }.autoplay { display: none; }.carousel-footer { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .featured { padding: 78px 18px 84px; }.heading { margin-bottom: 30px; }.controls button { width: 40px; height: 40px; }.controls button:first-child { display: none; }.carousel { height: 600px; }.slide { grid-template-rows: 56% 44%; }.content { padding: 22px; }.content h3 { font-size: 39px; }.content > p { font-size: 12px; }.carousel-footer > a { font-size: 9px; }.dots button { width: 28px; } }
  @media (prefers-reduced-motion: reduce) { .slide, .visual img { transition: none; }.autoplay { display: none; } }
</style>

<style>
  /* Composición promocional inspirada en piezas publicitarias de menú */
  .featured {
    padding: 82px 32px 95px;
    overflow: hidden;
    background: #f04419;
  }

  .featured .inner { width: min(1160px, 100%); }
  .featured .heading { align-items: center; margin-bottom: 34px; }
  .featured .eyebrow { color: #fff4df; }
  .featured .eyebrow span { background: #ffd36a; }
  .featured h2 { color: #fff4df; }
  .featured h2 i { color: #ffd36a; }
  .featured .controls button { border-color: #fff4df88; color: #fff4df; }
  .featured .controls button:hover { color: #f04419; background: #fff4df; border-color: #fff4df; }

  .featured .carousel {
    height: 260px;
    overflow: visible;
    background: transparent;
  }

  .featured .slide {
    grid-template-columns: 56% 44%;
    align-items: stretch;
    overflow: hidden;
    border-radius: 38px;
    background: #fff4df;
    box-shadow: 0 18px 0 #b92f16, 0 24px 40px #9b241855;
    transform: translateX(8%) scale(.98);
  }

  .featured .slide.previous { transform: translateX(-8%) scale(.98); }
  .featured .slide.active { transform: translateX(0) scale(1); }

  .featured .visual { order: 2; min-width: 0; }
  .featured .visual::after { background: linear-gradient(90deg, #fff4df00 58%, #fff4df18); }
  .featured .visual img { object-fit: cover; object-position: center; transform: scale(1.08); }
  .featured .slide.active .visual img { transform: scale(1); }

  .featured .content {
    order: 1;
    justify-content: center;
    padding: 32px 30px 28px 58px;
    color: #3f3f3b;
    background: #fff4df;
  }

  .featured .mini { color: #e43a18; }
  .featured .content h3 {
    max-width: 330px;
    margin: 8px 0 8px;
    color: #3f3f3b;
    font-family: var(--font-display);
    font-size: clamp(38px, 4vw, 61px);
    line-height: .88;
  }

  .featured .content > p { max-width: 290px; margin-bottom: 14px; color: #655d53; }
  .featured .content strong { margin: 0; color: #e43a18; font-family: var(--font-display); font-size: 32px; }
  .featured .content > a { display: none; }
  .featured .tag { z-index: 3; top: 22px; left: auto; right: 22px; color: #fff; background: #e43a18; }
  .featured .counter { color: #e43a18; }

  .featured .slide:nth-child(even) { grid-template-columns: 44% 56%; }
  .featured .slide:nth-child(even) .visual { order: 1; }
  .featured .slide:nth-child(even) .content { order: 2; padding-right: 58px; padding-left: 30px; }
  .featured .slide:nth-child(even) .visual::after { background: linear-gradient(270deg, #fff4df00 58%, #fff4df18); }

  .featured .carousel-footer { margin-top: 28px; }
  .featured .dots button span { background: #fff4df66; }
  .featured .dots button.active span { background: #ffd36a; }
  .featured .autoplay, .featured .carousel-footer > a { color: #fff4df; }
  .featured .carousel-footer > a { border-color: #ffd36a; }

  @media (max-width: 800px) {
    .featured .carousel { height: 570px; }
    .featured .slide, .featured .slide:nth-child(even) { grid-template-columns: 1fr; grid-template-rows: 57% 43%; }
    .featured .visual, .featured .slide:nth-child(even) .visual { order: 1; }
    .featured .content, .featured .slide:nth-child(even) .content { order: 2; padding: 22px 28px; }
    .featured .content h3 { margin: 5px 0 7px; font-size: 42px; }
    .featured .content > p { margin-bottom: 5px; }
    .featured .content strong { font-size: 26px; }
  }

  @media (max-width: 560px) {
    .featured { padding: 68px 18px 78px; }
    .featured .heading { align-items: end; }
    .featured .carousel { height: 520px; }
    .featured .slide, .featured .slide:nth-child(even) { border-radius: 25px; grid-template-rows: 55% 45%; }
    .featured .content, .featured .slide:nth-child(even) .content { padding: 19px 22px; }
    .featured .content h3 { font-size: 36px; }
    .featured .content > p { font-size: 11px; }
    .featured .tag { top: 15px; right: 15px; }
    .featured .controls button { width: 40px; height: 40px; }
  }

  /* En escritorio se muestran las tres promociones, como un menú impreso. */
  .featured .carousel {
    display: grid;
    height: auto;
    gap: 38px;
    overflow: visible;
  }

  .featured .slide,
  .featured .slide.previous,
  .featured .slide.active {
    position: relative;
    inset: auto;
    display: grid;
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    min-height: 278px;
    border: 1px solid #fff4dfaa;
    box-shadow: 0 13px 0 #b92f16, 0 25px 42px #8d241c55;
    transition: transform .35s ease, box-shadow .35s ease;
  }

  .featured .slide:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 0 #b92f16, 0 30px 48px #8d241c66;
  }

  .featured .slide.active { transform: translateY(0); }
  .featured .slide.active:hover { transform: translateY(-5px); }

  .featured .visual img { transition: transform .7s cubic-bezier(.2,.7,.2,1), filter .35s ease; }
  .featured .slide:hover .visual img { transform: scale(1.045); filter: saturate(1.08) contrast(1.03); }
  .featured .content { position: relative; }
  .featured .content::after {
    position: absolute;
    right: 28px;
    bottom: 22px;
    width: 34px;
    height: 2px;
    background: #e43a18;
    content: '';
  }

  @media (max-width: 800px) {
    .featured .carousel { display: grid; gap: 30px; height: auto; }
    .featured .slide, .featured .slide.previous, .featured .slide.active { min-height: 520px; }
  }

  @media (max-width: 560px) {
    .featured .carousel { gap: 24px; }
    .featured .slide, .featured .slide.previous, .featured .slide.active { min-height: 500px; }
    .featured .content::after { right: 22px; bottom: 16px; }
  }
</style>
