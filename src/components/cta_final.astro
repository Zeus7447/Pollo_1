---
import combo from '../assets/menu-combo.png';
---

<section class="final-cta" aria-labelledby="cta-title">
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <div class="ticker-group"><span>POLLO DORADITO</span><b>✦</b><span>RECIÉN HECHO</span><b>✦</b><span>PARA COMPARTIR</span><b>✦</b><span>POLLO FRESA</span><b>✦</b></div>
      <div class="ticker-group"><span>POLLO DORADITO</span><b>✦</b><span>RECIÉN HECHO</span><b>✦</b><span>PARA COMPARTIR</span><b>✦</b><span>POLLO FRESA</span><b>✦</b></div>
    </div>
  </div>

  <div class="cta-grid">
    <div class="cta-copy">
      <p class="eyebrow"><span></span> Tu antojo está listo</p>
      <h2 id="cta-title">¿Listo para<br /><i>pedir?</i></h2>
      <p class="description">Elige tu favorito, agrega tus acompañamientos y nosotros lo preparamos para que llegue calientito a tu mesa.</p>
      <div class="actions"><a class="primary" href="/pedir">Hacer mi pedido <span>↗</span></a><a class="secondary" href="/ubicaciones">Ver sucursales <span>→</span></a></div>
      <div class="benefits"><span>Preparado al día</span><span>Listo para llevar</span><span>Sabor de casa</span></div>
    </div>

    <div class="cta-visual">
      <img src={combo.src} alt="Combo de pollo rostizado con papas, tortillas, salsa y bebida" loading="lazy" />
      <div class="visual-shade"></div>
      <span class="round-label"><small>DESDE</small><strong>$179</strong><em>COMBOS</em></span>
      <span class="visual-caption">01 / EL FAVORITO DE LA CASA</span>
    </div>
  </div>

  <div class="cta-bottom"><strong>Pollo Fresa</strong><p>El sabor que reúne a todos.</p><a href="/menu">Explorar el menú <span>↗</span></a></div>
</section>

<style>
  .final-cta { overflow: hidden; color: #fff4df; background: #c51f2b; }.ticker { overflow: hidden; color: #422018; background: #ffd36a; white-space: nowrap; }.ticker div { display: flex; width: max-content; gap: 28px; align-items: center; padding: 13px 0; animation: ticker 24s linear infinite; }.ticker span { font-size: 9px; font-weight: 800; letter-spacing: .17em; }.ticker b { color: #c51f2b; font-size: 11px; }.cta-grid { display: grid; min-height: 625px; grid-template-columns: 52% 48%; }.cta-copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding: 70px max(45px, calc((100vw - 1160px) / 2)); padding-right: 70px; }.cta-copy::before { position: absolute; z-index: -1; top: 50%; left: 8%; width: 430px; height: 430px; border: 1px solid #ffd36a26; border-radius: 50%; content: ''; transform: translateY(-50%); }.eyebrow { margin: 0 0 20px; color: #ffd36a; font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }.eyebrow span { display: inline-block; width: 29px; height: 2px; margin: 0 11px 3px 0; background: #ffd36a; }h2 { margin: 0 0 25px; font-family: var(--font-display); font-size: clamp(63px, 7vw, 103px); font-weight: 400; letter-spacing: -.03em; line-height: .76; }h2 i { color: #ffd36a; font-style: normal; }.description { max-width: 480px; margin: 0; color: #fff4dfcf; font-size: 14px; line-height: 1.75; }.actions { display: flex; gap: 24px; align-items: center; margin-top: 31px; }.actions a { font-size: 11px; font-weight: 800; text-decoration: none; }.primary { padding: 17px 20px; color: #422018; background: #ffd36a; box-shadow: 0 10px 25px #4220182b; }.primary span { margin-left: 28px; color: #c51f2b; font-size: 18px; }.secondary { padding: 14px 2px 8px; border-bottom: 1px solid #fff4df8c; color: #fff4df; }.secondary span { margin-left: 12px; color: #ffd36a; font-size: 17px; }.benefits { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 42px; }.benefits span { padding: 8px 10px; border: 1px solid #ffd36a65; color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }.cta-visual { position: relative; min-width: 0; overflow: hidden; }.cta-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1), filter .8s ease; }.cta-visual:hover img { filter: saturate(1.1); transform: scale(1.035); }.visual-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #c51f2b 0%, transparent 21%), linear-gradient(0deg, #2b0e0870, transparent 42%); }.round-label { position: absolute; top: 31px; right: 31px; display: flex; width: 105px; height: 105px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #ffd36a; border-radius: 50%; color: #ffd36a; background: #422018d9; transform: rotate(7deg); }.round-label small { font-size: 7px; letter-spacing: .15em; }.round-label strong { margin: 2px 0; font-family: var(--font-display); font-size: 28px; font-weight: 400; }.round-label em { font-size: 7px; font-style: normal; font-weight: 800; letter-spacing: .14em; }.visual-caption { position: absolute; right: 27px; bottom: 25px; color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .16em; }.cta-bottom { display: grid; grid-template-columns: 1fr auto 1fr; gap: 30px; align-items: center; padding: 22px max(32px, calc((100vw - 1160px) / 2)); color: #fff4df; background: #422018; }.cta-bottom strong { color: #ffd36a; font-family: var(--font-display); font-size: 20px; font-weight: 400; }.cta-bottom p { margin: 0; color: #fff4df9c; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }.cta-bottom a { justify-self: end; color: #fff4df; font-size: 10px; font-weight: 800; text-decoration: none; }.cta-bottom a span { margin-left: 10px; color: #ffd36a; font-size: 16px; }@keyframes ticker { to { transform: translateX(-45%); } }
  @media (max-width: 850px) { .cta-grid { grid-template-columns: 1fr; }.cta-copy { min-height: 600px; padding-inline: 32px; }.cta-visual { min-height: 490px; }.visual-shade { background: linear-gradient(0deg, #2b0e0870, transparent 42%); }.cta-bottom { grid-template-columns: 1fr 1fr; }.cta-bottom p { display: none; } }
  @media (max-width: 560px) { .cta-copy { min-height: 570px; padding: 65px 18px; }.description { font-size: 13px; }.actions { align-items: stretch; flex-direction: column; }.actions a { text-align: center; }.benefits { margin-top: 30px; }.cta-visual { min-height: 390px; }.round-label { top: 20px; right: 20px; width: 90px; height: 90px; }.cta-bottom { padding-inline: 18px; }.cta-bottom a { font-size: 9px; } }
  @media (prefers-reduced-motion: reduce) { .ticker div { animation: none; }.cta-visual img { transition: none; } }
  .ticker .ticker-track { display: flex; width: max-content; gap: 0; align-items: center; padding: 0; animation: ticker-loop 18s linear infinite; will-change: transform; }
  .ticker .ticker-group { display: flex; width: 100vw; min-width: 100vw; flex: 0 0 auto; justify-content: space-around; gap: 28px; align-items: center; padding: 13px 22px; animation: none; }
  @keyframes ticker-loop { to { transform: translate3d(-50%, 0, 0); } }
  @media (prefers-reduced-motion: reduce) { .ticker .ticker-track { animation: none; } }
  .final-cta { background: radial-gradient(circle at 16% 45%, #e13a31 0, transparent 34%), linear-gradient(120deg, #b81725, #c51f2b 62%, #9f151f); }
  .ticker { position: relative; border-top: 1px solid #c51f2b55; border-bottom: 1px solid #c51f2b55; box-shadow: 0 7px 24px #42201820; }
  .ticker::after { position: absolute; inset: 0; background: linear-gradient(90deg, #fff4df33, transparent 22%, transparent 78%, #fff4df33); content: ''; pointer-events: none; }
  .ticker .ticker-track { animation-duration: 22s; }
  .ticker .ticker-group { padding-block: 16px; }
  .ticker span { color: #422018; font-family: var(--font-display); font-size: 12px; font-weight: 400; letter-spacing: .11em; }
  .ticker span:nth-of-type(even) { color: #c51f2b; }
  .ticker b { display: grid; width: 23px; height: 23px; flex: 0 0 auto; place-items: center; border: 1px solid #c51f2b88; border-radius: 50%; color: #c51f2b; background: #fff4df45; font-size: 9px; }
  .cta-copy::after { position: absolute; z-index: -1; top: 12%; left: -3%; color: #ffd36a0b; font-family: var(--font-display); font-size: 290px; line-height: 1; content: 'PF'; pointer-events: none; }
  .primary, .secondary, .cta-bottom a { transition: transform .2s ease, box-shadow .2s ease, color .2s ease; }
  .primary:hover { box-shadow: 0 15px 30px #42201848; transform: translateY(-3px); }
  .secondary:hover, .cta-bottom a:hover { color: #ffd36a; transform: translateY(-2px); }
  .round-label { box-shadow: 0 10px 28px #210b0655; animation: label-float 3.2s ease-in-out infinite; }
  .cta-visual::after { position: absolute; inset: 0; border: 1px solid #ffd36a40; content: ''; pointer-events: none; }
  @keyframes label-float { 50% { transform: rotate(4deg) translateY(-7px); } }
  @media (max-width: 560px) { .ticker span { font-size: 10px; }.ticker .ticker-group { gap: 14px; }.ticker .ticker-group span:nth-of-type(n+3), .ticker .ticker-group b:nth-of-type(n+3) { display: none; } }
  @media (prefers-reduced-motion: reduce) { .round-label { animation: none; } }
</style>
