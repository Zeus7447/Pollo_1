---
import type { CatalogProduct } from '../lib/directus';
import polloLogo from '../assets/pollo_fresa.webp';
import wingsLogo from '../assets/alitas_logo.png';
import wingsFood from '../assets/fresa_wings_cool.webp';

interface Props { pollo: CatalogProduct | undefined; wings: CatalogProduct | undefined }
const { pollo } = Astro.props;
---

<section class="brand-launch" id="inicio" aria-labelledby="launch-title">
  <header class="launch-heading">
    <p class="launch-kicker">POLLO FRESA <i aria-hidden="true">×</i> FRESA WINGS</p>
    <h1 id="launch-title">Dos marcas.<br /><em>Un mismo antojo.</em></h1>
  </header>

  <div class="launch-stage">
    <article class="pollo-stage" aria-labelledby="pollo-stage-title">
      <div class="pollo-copy">
        <img class="pollo-logo" src={polloLogo.src} width={polloLogo.width} height={polloLogo.height} alt="Pollo Fresa" />
        <p class="stage-label">POLLO · FUEGO · FAMILIA</p>
        <h2 id="pollo-stage-title">El sabor<br />que reúne.</h2>
        <a class="stage-link pollo-link" href="#pollo-menu">Explorar Pollo Fresa <span aria-hidden="true">↘</span></a>
      </div>
      <div class="pollo-food" aria-label={pollo ? `Fotografía de ${pollo.name}` : 'Pollo Fresa'}>
        {pollo?.image
          ? <img src={pollo.image} width="900" height="900" alt={pollo.name} fetchpriority="high" loading="eager" decoding="async" />
          : <img class="pollo-fallback-logo" src={polloLogo.src} width={polloLogo.width} height={polloLogo.height} alt="Pollo Fresa" />}
      </div>
      <span class="pollo-index" aria-hidden="true">01</span>
    </article>

    <article class="wings-stage" aria-labelledby="wings-stage-title">
      <div class="wings-copy">
        <p class="stage-label">CRUJIENTE · BAÑADO · INTENSO</p>
        <h2 id="wings-stage-title">Sube el<br /><em>nivel.</em></h2>
        <a class="stage-link wings-link" href="#fresa-wings-menu">Explorar Fresa Wings <span aria-hidden="true">↘</span></a>
      </div>
      <img class="wings-food" src={wingsFood.src} width={wingsFood.width} height={wingsFood.height} alt="Empaque de Fresa Wings con alitas" fetchpriority="auto" loading="eager" decoding="async" />
      <img class="wings-logo" src={wingsLogo.src} width={wingsLogo.width} height={wingsLogo.height} alt="Fresa Wings" />
      <span class="wings-index" aria-hidden="true">02 / STREET FOOD</span>
    </article>
  </div>
</section>

<style>
  .brand-launch{--red:#e52b20;--yellow:#ffbe0b;--orange:#ff7417;--cream:#fff8e9;--ink:#231b19;overflow:hidden;padding:24px clamp(18px,5vw,88px) 48px;background:var(--cream);color:var(--ink)}
  .launch-heading{display:flex;max-width:1600px;align-items:end;justify-content:space-between;gap:28px;margin:0 auto 18px}
  .launch-kicker{margin:0 0 8px;color:var(--red);font-size:clamp(9px,.8vw,12px);font-weight:900;letter-spacing:.17em}
  .launch-kicker i{padding:0 5px;color:var(--orange);font-style:normal}
  .launch-heading h1{margin:0;font:950 clamp(36px,4.5vw,68px)/.84 Arial,sans-serif;letter-spacing:-.075em;text-transform:uppercase}
  .launch-heading h1 em{color:var(--red);font-style:normal}
  .launch-stage{display:grid;grid-template-columns:1.15fr .85fr;width:min(100%,1600px);min-height:clamp(410px,36vw,540px);margin:0 auto;background:var(--red)}
  .pollo-stage{position:relative;display:grid;grid-template-columns:.82fr 1.18fr;align-items:center;min-width:0;overflow:hidden;padding:clamp(22px,3.2vw,48px);background:var(--red);color:white}
  .pollo-stage:after{position:absolute;right:-36px;bottom:-86px;width:260px;height:260px;border:34px solid #ffbe0b66;border-radius:50%;content:"";pointer-events:none}
  .pollo-copy{position:relative;z-index:2;min-width:0}
  .pollo-logo{width:clamp(58px,6vw,88px);height:auto;object-fit:contain;margin-bottom:20px}
  .stage-label{margin:0 0 12px;color:#ffe5a4;font-size:9px;font-weight:900;letter-spacing:.15em}
  .pollo-copy h2,.wings-copy h2{margin:0;font:950 clamp(40px,5.1vw,76px)/.8 Arial,sans-serif;letter-spacing:-.075em;text-transform:uppercase}
  .pollo-copy h2{max-width:360px}
  .stage-link{position:relative;z-index:3;display:inline-flex;min-height:48px;align-items:center;justify-content:space-between;gap:12px;margin-top:23px;padding:0 15px;font-size:11px;font-weight:900;text-decoration:none;transition:transform .18s ease,background-color .18s ease}
  .stage-link span{font-size:18px}
  .stage-link:hover{transform:translateY(-2px);background:white;color:var(--ink)}
  .pollo-link{background:var(--yellow);color:var(--ink)}
  .pollo-food{position:relative;z-index:1;display:grid;min-width:0;height:100%;min-height:310px;place-items:center}
  .pollo-food>img{display:block;width:100%;height:100%;max-height:430px;object-fit:contain;object-position:center;filter:drop-shadow(0 20px 16px #3b090958)}
  .pollo-food>.pollo-fallback-logo{width:62%;height:62%;filter:none}
  .pollo-index{position:absolute;right:23px;top:18px;color:#ffffff77;font-size:10px;font-weight:900;letter-spacing:.14em}
  .wings-stage{position:relative;display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;min-width:0;overflow:hidden;padding:clamp(22px,3vw,44px);background:var(--ink);color:white}
  .wings-stage:before{position:absolute;top:-120px;right:-90px;width:300px;height:300px;border:2px solid #ff741755;border-radius:50%;content:"";pointer-events:none}
  .wings-copy{position:relative;z-index:2;min-width:0}
  .wings-copy .stage-label{max-width:150px;color:var(--orange);line-height:1.5}
  .wings-copy h2{font-family:Impact,"Arial Narrow",Arial,sans-serif;font-size:clamp(42px,5vw,70px);letter-spacing:-.02em}
  .wings-copy h2 em{color:var(--orange);font-style:normal}
  .wings-link{background:var(--orange);color:var(--ink)}
  .wings-food{position:relative;z-index:1;display:block;width:100%;height:100%;max-height:440px;object-fit:contain;object-position:center;filter:drop-shadow(0 20px 18px #0008)}
  .wings-logo{position:absolute;right:18px;top:16px;width:clamp(48px,5vw,72px);height:auto;max-height:55px;object-fit:contain}
  .wings-index{position:absolute;right:20px;bottom:18px;color:#ffffff88;font-size:8px;font-weight:900;letter-spacing:.16em}
  .brand-launch a:focus-visible{outline:3px solid white;outline-offset:4px}
  @media(max-width:900px){.brand-launch{padding:22px 4vw 38px}.launch-heading{margin-bottom:15px}.launch-stage{grid-template-columns:1.05fr .95fr;min-height:420px}.pollo-stage{grid-template-columns:.9fr 1.1fr;padding:22px}.pollo-copy h2{font-size:clamp(36px,6vw,55px)}.pollo-logo{width:58px;margin-bottom:14px}.stage-link{min-height:44px;padding:0 11px;font-size:10px}.wings-stage{grid-template-columns:.8fr 1.2fr;padding:20px}.wings-copy h2{font-size:clamp(38px,5.8vw,56px)}.wings-food{max-height:390px}}
  @media(max-width:680px){.brand-launch{padding:22px 16px 30px}.launch-heading{display:block;margin-bottom:13px}.launch-kicker{margin-bottom:8px;font-size:9px}.launch-heading h1{font-size:clamp(36px,9.6vw,48px);line-height:.9}.launch-stage{grid-template-columns:1fr;min-height:0}.pollo-stage{grid-template-columns:.9fr 1.1fr;min-height:300px;padding:20px 18px}.pollo-stage:after{right:-50px;bottom:-100px}.pollo-copy h2{font-size:clamp(38px,10vw,56px)}.pollo-logo{width:54px;margin-bottom:12px}.pollo-food{min-height:250px}.pollo-food>img{max-height:290px}.stage-link{min-height:46px;margin-top:17px;padding:0 12px;font-size:10px}.wings-stage{grid-template-columns:.8fr 1.2fr;min-height:270px;padding:18px}.wings-copy .stage-label{max-width:130px;font-size:8px}.wings-copy h2{font-size:clamp(38px,10vw,55px)}.wings-food{max-height:285px}.wings-logo{right:12px;top:10px;width:48px}.wings-index{right:12px;bottom:10px;font-size:7px}}
  @media(max-width:390px){.brand-launch{padding-inline:12px}.pollo-stage{grid-template-columns:.92fr 1.08fr;min-height:280px;gap:5px;padding:16px 12px}.pollo-copy h2{font-size:36px}.pollo-food{min-height:220px}.pollo-link{max-width:165px;gap:6px;padding-inline:9px;font-size:9px}.wings-stage{min-height:248px;gap:2px;padding:15px 11px}.wings-copy h2{font-size:37px}.wings-link{max-width:158px;gap:6px;padding-inline:9px;font-size:9px}}
  @media(prefers-reduced-motion:reduce){.stage-link{transition:none}}
</style>
