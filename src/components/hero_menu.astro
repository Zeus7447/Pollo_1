---
import polloEntero from '../assets/menu-pollo-entero.png';
import polloLogo from '../assets/pollo_fresa.webp';
import alitasLogo from '../assets/alitas_logo.png';

const whatsappUrl = `https://wa.me/524463869132?text=${encodeURIComponent('Hola, quiero pedir un pollo rostizado de Pollo Fresa.')}`;
---

<section class="menu-showcase" id="top" aria-labelledby="menu-hero-title">
  <div class="hero-photo" aria-hidden="true">
    <img src={polloEntero.src} alt="" />
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>
  <span class="hero-outline" aria-hidden="true">ROSTIZADO</span>
  <span class="red-rail" aria-hidden="true"></span>

  <div class="showcase-inner">
    <div class="showcase-copy">
      <p class="hero-kicker"><span>MENÚ · POLLO FRESA</span><b>Recién salido del rosticero</b></p>
      <h1 id="menu-hero-title">
        <span>Dorado.</span>
        <span class="accent">Jugoso.</span>
        <span>Muy Fresa.</span>
      </h1>
      <p class="hero-description">Pollo rostizado a fuego lento, acompañado con todo lo necesario para poner la mesa y disfrutar sin complicaciones.</p>

      <div class="hero-actions">
        <a class="primary-action" href={whatsappUrl} target="_blank" rel="noreferrer">
          <span><small>PIDE EN MINUTOS</small>Ordenar por WhatsApp</span><b>↗</b>
        </a>
        <a class="menu-action" href="#pollo-fresa">Ver menú <span>↓</span></a>
      </div>

      <div class="hero-points" aria-label="Características">
        <div><strong>01</strong><span>Rostizado<br />a fuego lento</span></div>
        <div><strong>02</strong><span>Preparado<br />todos los días</span></div>
        <div><strong>03</strong><span>Listo para<br />compartir</span></div>
      </div>
    </div>

    <aside class="hero-price-card" aria-label="Precio del pollo entero">
      <p>EL FAVORITO</p>
      <span>Pollo entero</span>
      <div><small>DESDE</small><strong>$249</strong></div>
      <a href={whatsappUrl} target="_blank" rel="noreferrer">Lo quiero <b>↗</b></a>
    </aside>

    <p class="rotation-note"><span>✦</span> GIRA LENTO · SABE MEJOR</p>
  </div>

  <div class="business-switch" aria-label="Elige un negocio">
    <a class="business chicken" href="#pollo-fresa">
      <span class="business-logo chicken-logo"><img src={polloLogo.src} alt="" /></span>
      <div><small>QUIERO ALGO PARA COMPARTIR</small><strong>Pollo rostizado</strong></div>
      <b>Explorar Pollo Fresa ↘</b>
    </a>
    <a class="business wings" href="#fresa-wings">
      <span class="business-logo wings-logo"><img src={alitasLogo.src} alt="" /></span>
      <div><small>QUIERO ALGO PICANTE Y CRUJIENTE</small><strong>Alitas & boneless</strong></div>
      <b>Explorar Fresa Wings ↘</b>
    </a>
  </div>
</section>

<style>
  .menu-showcase { position: relative; min-height: 990px; overflow: hidden; color: #fff4df; background: #24100c; isolation: isolate; }
  .hero-photo { position: absolute; z-index: -3; inset: 0 0 0 35%; overflow: hidden; }
  .hero-photo::after { position: absolute; inset: 0; border-left: 1px solid #ffd36a38; background: linear-gradient(180deg, #17090615 0%, transparent 48%, #170906a6 100%); content: ''; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 54% center; filter: saturate(1.12) contrast(1.08) brightness(.88); animation: hero-reveal 1.1s cubic-bezier(.2,.75,.25,1) both; }
  .hero-overlay { position: absolute; z-index: -2; inset: 0; background: linear-gradient(90deg, #24100c 0%, #24100c 32%, #24100cf5 41%, #24100c9c 54%, transparent 76%), linear-gradient(0deg, #180806c4 0%, transparent 28%); }
  .hero-outline { position: absolute; z-index: -1; top: 150px; left: -12px; color: transparent; font-family: var(--font-display); font-size: clamp(120px, 17vw, 255px); letter-spacing: -.055em; line-height: .8; opacity: .13; -webkit-text-stroke: 1px #ffd36a; writing-mode: vertical-rl; transform: rotate(180deg); }
  .red-rail { position: absolute; top: 0; bottom: 0; left: 0; width: 8px; background: linear-gradient(#c51f2b 0 72%, #f28c16 72% 90%, #ffd36a 90%); }
  .showcase-inner { position: relative; width: min(1240px, calc(100% - 72px)); min-height: 785px; margin: auto; padding-top: 175px; }
  .showcase-copy { position: relative; z-index: 3; width: 55%; max-width: 675px; }
  .hero-kicker { display: flex; gap: 13px; align-items: center; margin: 0 0 30px; color: #ffd36a; font-size: 8px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .hero-kicker span { padding: 8px 10px; color: #422018; background: #ffd36a; }
  .hero-kicker .hero-kicker-logo { position: relative; display: block; width: 72px; height: 54px; overflow: hidden; flex: 0 0 auto; padding: 0; background: transparent; }
  .hero-kicker-logo img { position: absolute; top: 50%; left: 50%; width: 145px; max-width: none; height: auto; filter: drop-shadow(0 4px 7px #16070480); transform: translate(-50%, -50%); }
  .hero-kicker b { font-weight: 800; }
  .showcase-copy h1 { margin: 0; font-family: var(--font-display); font-size: clamp(75px, 8.2vw, 122px); font-weight: 400; letter-spacing: -.045em !important; line-height: .72; text-shadow: 0 8px 40px #18080665; }
  .showcase-copy h1 span { display: block; }
  .showcase-copy h1 .accent { color: #ffd36a; margin-left: 42px; }
  .hero-description { max-width: 460px; margin: 36px 0 0 45px; padding-left: 19px; border-left: 2px solid #c51f2b; color: #fff4dfc2; font-size: 13px; line-height: 1.75; }
  .hero-actions { display: flex; gap: 25px; align-items: center; margin: 34px 0 0 45px; }
  .primary-action { display: flex; min-width: 245px; justify-content: space-between; align-items: center; padding: 15px 17px; color: #fff4df; background: #c51f2b; box-shadow: 0 13px 35px #1607046b; text-decoration: none; transition: transform .25s ease, background .25s ease; }
  .primary-action:hover { background: #dd2734; transform: translateY(-3px); }
  .primary-action > span { display: grid; gap: 2px; font-size: 11px; font-weight: 900; }
  .primary-action small { color: #ffd36a; font-size: 6px; letter-spacing: .16em; }
  .primary-action > b { color: #ffd36a; font-size: 20px; }
  .menu-action { padding: 12px 2px 8px; border-bottom: 1px solid #ffd36a87; color: #fff4df; font-size: 10px; font-weight: 900; text-decoration: none; text-transform: uppercase; }
  .menu-action span { margin-left: 13px; color: #ffd36a; font-size: 15px; }
  .hero-points { display: flex; gap: 0; width: max-content; margin: 46px 0 0 45px; border-top: 1px solid #fff4df2e; border-bottom: 1px solid #fff4df2e; }
  .hero-points div { display: flex; gap: 10px; align-items: center; padding: 13px 23px 13px 0; margin-right: 23px; border-right: 1px solid #fff4df2e; }
  .hero-points div:last-child { margin: 0; padding-right: 0; border: 0; }
  .hero-points strong { color: #f28c16; font-family: var(--font-display); font-size: 20px; font-weight: 400; }
  .hero-points span { color: #fff4df91; font-size: 7px; font-weight: 800; letter-spacing: .07em; line-height: 1.45; text-transform: uppercase; }
  .hero-price-card { position: absolute; z-index: 4; right: 0; bottom: 80px; width: 230px; padding: 24px; color: #422018; background: #ffd36a; box-shadow: 18px 18px 0 #c51f2b, 0 25px 60px #16070472; transform: rotate(-2deg); animation: price-in .8s .35s ease both; }
  .hero-price-card > p { width: max-content; margin: -39px 0 17px auto; padding: 8px 10px; color: #fff4df; background: #c51f2b; font-size: 7px; font-weight: 900; letter-spacing: .14em; }
  .hero-price-card > span { font-family: var(--font-display); font-size: 27px; }
  .hero-price-card > div { display: flex; justify-content: space-between; align-items: end; margin: 15px 0; padding: 13px 0; border-top: 1px solid #42201840; border-bottom: 1px solid #42201840; }
  .hero-price-card > div small { font-size: 7px; font-weight: 900; letter-spacing: .15em; }
  .hero-price-card > div strong { color: #c51f2b; font-family: var(--font-display); font-size: 43px; font-weight: 400; line-height: .8; }
  .hero-price-card > a { display: flex; justify-content: space-between; color: #422018; font-size: 9px; font-weight: 900; text-decoration: none; text-transform: uppercase; }
  .hero-price-card > a b { color: #c51f2b; font-size: 16px; }
  .rotation-note { position: absolute; z-index: 3; top: 165px; right: 0; margin: 0; color: #ffd36a; font-size: 7px; font-weight: 900; letter-spacing: .17em; writing-mode: vertical-rl; }
  .rotation-note span { margin-bottom: 9px; color: #f28c16; }
  .business-switch { position: absolute; z-index: 5; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .business { display: grid; grid-template-columns: 145px 1fr auto; gap: 24px; align-items: center; min-height: 205px; padding: 24px max(36px, calc((100vw - 1240px) / 2)); text-decoration: none; transition: filter .25s ease; }
  .business:hover { filter: brightness(1.08); }
  .business.chicken { color: #422018; background: #ffd36a; padding-right: 38px; }
  .business.wings { color: #fff4df; background: #080808; padding-left: 38px; }
  .business > span { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-family: var(--font-display); font-size: 13px; }
  .business > .business-logo { position: relative; display: block; width: 145px; height: 135px; overflow: hidden; border: 0; border-radius: 0; }
  .business-logo img { position: absolute; top: 50%; left: 50%; max-width: none; height: auto; transform: translate(-50%, -50%); }
  .chicken-logo img { width: 320px; filter: drop-shadow(0 8px 12px #42201855); }
  .wings-logo { background: #000000; }
  .wings-logo img { width: auto; height: 100%; }
  .business div { display: grid; gap: 3px; }
  .business small { font-size: 6px; font-weight: 900; letter-spacing: .14em; }
  .business strong { font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 35px); font-weight: 400; line-height: 1; }
  .business > b { font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
  .wings > b { color: #ffd36a; }
  @keyframes hero-reveal { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: scale(1); } }
  @keyframes price-in { from { opacity: 0; transform: translateY(30px) rotate(-2deg); } to { opacity: 1; transform: translateY(0) rotate(-2deg); } }
  @media (max-width: 1050px) {
    .menu-showcase { min-height: 1040px; }
    .hero-photo { left: 25%; }
    .hero-overlay { background: linear-gradient(90deg, #24100c 0%, #24100cf5 37%, #24100ccf 55%, #24100c35 100%), linear-gradient(0deg, #180806e7 0%, transparent 48%); }
    .showcase-inner { min-height: 855px; padding-top: 160px; }
    .showcase-copy { width: 70%; }
    .hero-price-card { bottom: 78px; }
    .business { grid-template-columns: 125px 1fr; min-height: 185px; }
    .business > .business-logo { width: 125px; height: 118px; }
    .chicken-logo img { width: 280px; }
    .business > b { display: none; }
  }
  @media (max-width: 700px) {
    .menu-showcase { min-height: 1022px; }
    .hero-photo { inset: 0; }
    .hero-photo img { object-position: 56% center; filter: saturate(1.08) contrast(1.08) brightness(.64); }
    .hero-overlay { background: linear-gradient(180deg, #24100ce8 0%, #24100cc7 42%, #24100cf4 79%, #24100c 100%); }
    .hero-outline, .rotation-note { display: none; }
    .showcase-inner { width: calc(100% - 36px); min-height: 795px; padding-top: 135px; }
    .showcase-copy { width: 100%; }
    .hero-kicker { align-items: flex-start; flex-direction: column; gap: 8px; margin-bottom: 25px; }
    .showcase-copy h1 { font-size: clamp(63px, 19vw, 85px); line-height: .76; }
    .showcase-copy h1 .accent { margin-left: 22px; }
    .hero-description { margin: 29px 0 0 22px; font-size: 12px; }
    .hero-actions { align-items: stretch; flex-direction: column; gap: 12px; margin: 26px 0 0 22px; }
    .primary-action { min-width: 0; }
    .menu-action { width: max-content; }
    .hero-points { display: none; }
    .hero-price-card { right: 5px; bottom: 54px; width: 180px; padding: 18px; }
    .hero-price-card > p { margin-top: -31px; }
    .hero-price-card > span { font-size: 22px; }
    .hero-price-card > div strong { font-size: 35px; }
    .business-switch { grid-template-columns: 1fr; }
    .business { min-height: 126px; grid-template-columns: 82px 1fr; gap: 14px; padding: 12px 18px !important; }
    .business > .business-logo { width: 82px; height: 78px; }
    .chicken-logo img { width: 184px; }
    .wings-logo img { width: auto; height: 100%; }
    .business small { font-size: 5px; }
    .business strong { font-size: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-photo img, .hero-price-card { animation: none; } }
</style>
