---
import pollosRostisados from '../assets/pollo_musculoso.mp4';
---

<main class="site-shell" id="top">
  <section class="hero">
    <div class="hero-video" aria-hidden="true"><video autoplay muted loop playsinline><source src={pollosRostisados} type="video/mp4" /></video></div>
  </section>
</main>

<style>
  :global(*) { box-sizing: border-box; } :global(body) { background: #fff4df; color: #422018; font-family: var(--font-body); }
  .site-shell { position: relative; min-height: 100vh; overflow: hidden; background: #422018; }.hero { position: relative; width: 100vw; min-height: 100vh; margin-left: calc(50% - 50vw); display: flex; align-items: center; padding-inline: max(32px, calc((100vw - 1160px) / 2)); }.hero-video { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; overflow: hidden; background: #422018; }.hero-video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #1f0d0966 0%, #1f0d091c 48%, #1f0d0933 100%); pointer-events: none; }.hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center center; filter: brightness(1.12) contrast(1.1) saturate(1.28); transform: scale(1.015); }
  @media (max-width: 760px) { .hero { min-height: 100svh; padding-inline: 18px; }.hero-copy { padding-top: 80px; }.intro { font-size: 15px; }.hero-video::after { background: linear-gradient(90deg, #1f0d09cc, #1f0d0966); } }
</style>
