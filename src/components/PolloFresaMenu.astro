  .cover{min-height:590px;display:grid;grid-template-columns:.94fr 1.06fr;align-items:center;position:relative;padding:46px 10vw 76px;gap:4vw}.cover-copy{position:relative;z-index:2}.kicker{text-transform:uppercase;letter-spacing:.18em;font-size:9px;font-weight:800;color:var(--accent)}.cover h1{max-width:560px;margin:24px 0;font:600 clamp(58px,8.4vw,125px)/.91 var(--serif);letter-spacing:-.075em}.cover h1 em,.menu-heading h2 em{color:var(--accent);font-weight:600}.cover-intro{max-width:310px;color:var(--muted);font-size:14px;line-height:1.7}.cover-link{display:inline-flex;gap:22px;align-items:center;margin-top:23px;padding-bottom:9px;border-bottom:1px solid var(--accent);font-size:11px;font-weight:800;text-decoration:none;color:inherit}.cover-link span{font-size:20px;color:var(--accent)}.cover-index{display:block;margin-top:72px;color:var(--muted);font-size:8px;font-weight:800;letter-spacing:.18em}.cover-art{height:480px;position:relative;margin-right:-6vw}.cover-art:before{content:'';position:absolute;inset:8% 12% 2% 2%;background:#d5c5aa;transform:rotate(-5deg)}.cover-art>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;clip-path:polygon(8% 0,100% 4%,95% 100%,0 92%)}.art-note{position:absolute;z-index:2;left:0;bottom:22px;min-width:190px;padding:15px 20px;background:var(--paper);box-shadow:0 10px 40px #0002}.art-note span,.art-note b{display:block}.art-note span{font-size:8px;letter-spacing:.16em;color:var(--accent);font-weight:800}.art-note b{margin-top:6px;font:600 18px var(--serif)}.art-number{position:absolute;right:8px;top:2px;color:var(--ink);font:800 14px var(--display)}.vertical-note{position:absolute;right:2vw;top:40%;writing-mode:vertical-rl;font-size:8px;letter-spacing:.2em;color:var(--muted)}
  .category-band{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:start;padding:26px 10vw 29px;border-top:1px solid #251e1933;border-bottom:1px solid #251e1933}.category-band>span{padding-top:12px;font-size:8px;font-weight:800;letter-spacing:.16em;color:var(--muted)}.category-links{display:flex;flex-wrap:wrap;gap:9px}.category-links a{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid #251e1933;font-size:10px;font-weight:700;text-decoration:none;color:inherit;transition:background .2s,color .2s,transform .2s}.category-links a:hover{background:var(--accent);color:#fff;transform:translateY(-2px)}.category-links i{font:700 11px var(--display);color:var(--accent)}.category-links a:hover i,.category-links a:hover b{color:#fff}.category-links b{margin-left:4px;color:var(--accent)}
  .menu-area{padding:100px 8vw 90px}.menu-heading{display:grid;grid-template-columns:1fr 1fr;align-items:end;margin:0 auto 54px;max-width:1320px}.menu-heading .kicker{grid-column:1/-1;margin:0}.menu-heading h2{margin-top:9px;font:600 clamp(48px,6.5vw,82px)/.94 var(--serif);letter-spacing:-.07em}.menu-heading h2 em{font-style:italic}.menu-heading>p:last-child{justify-self:end;margin:0 0 6px;color:var(--muted);font-size:10px}
