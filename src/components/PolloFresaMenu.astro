---
import StorefrontPromotions from './StorefrontPromotions.astro';
import type { CatalogCategory, CatalogProduct, CatalogPromotion } from '../lib/directus';
import polloLogo from '../assets/pollo_fresa.webp';

interface Props { products: CatalogProduct[]; categories: CatalogCategory[]; promotions?: CatalogPromotion[]; demo?: boolean }
const { products, categories, promotions = [], demo = true } = Astro.props;
const leadProduct = products.find((product) => product.featured && product.image) ?? products.find((product) => product.image);
const visibleCategories = categories.filter((category) => products.some((product) => product.categoryId === category.id));
const friedCategory = categories.find((category) => /frit/i.test(category.name));
const roastCategory = categories.find((category) => /asado/i.test(category.name));
const rotisserieCategory = categories.find((category) => /rostizado/i.test(category.name));
const friedProducts = products.filter((product) => product.categoryId === friedCategory?.id)
  .sort((a, b) => Number(a.name.match(/\d+/)?.[0] ?? 0) - Number(b.name.match(/\d+/)?.[0] ?? 0));
const roastProduct = products.find((product) => product.categoryId === roastCategory?.id);
const rotisserieProduct = products.find((product) => product.categoryId === rotisserieCategory?.id);
const handledIds = new Set([...friedProducts, ...(roastProduct ? [roastProduct] : []), ...(rotisserieProduct ? [rotisserieProduct] : [])].map((product) => product.id));
const remainingProducts = products.filter((product) => !handledIds.has(product.id));
const initialCombo = friedProducts.find((product) => product.featured) ?? friedProducts[0];
const productPayload = (product: CatalogProduct) => JSON.stringify(product).replace(/</g, '\\u003c');
---

<div class="pollo-concept" class:production-menu={!demo} id={demo ? undefined : 'pollo-menu'} data-catalog-brand={!demo ? 'Pollo Fresa' : undefined} data-food-motion-scope={!demo ? 'pollo' : undefined}>
  {demo && <div class="preview-bar"><span>Vista de concepto</span><span>Pedidos desactivados</span></div>}
  {demo && <header class="proto-header">
    <a class="wordmark" href="#inicio" aria-label="Pollo Fresa, inicio"><img class="brand-logo" src={polloLogo.src} alt="" /><span>Pollo Fresa<small>POLLO · FUEGO · TRADICIÓN</small></span></a>
    <nav aria-label="Navegación del menú" class="top-links"><a href={demo ? '#menu' : '#pollo-menu-list'}>Menú</a><a href="#categorias">Categorías</a><a href="#nota">Acerca del prototipo</a></nav>
    <span class="demo-pill"><i></i> Solo demostración</span>
  </header>}

  <section class="cover" id={demo ? 'inicio' : 'pollo-inicio'} aria-labelledby={demo ? 'cover-title' : 'pollo-cover-title'}>
    <div class="cover-copy" data-motion-story>
      <p class="kicker" data-motion-step>El sabor que reúne</p>
      <h1 id={demo ? 'cover-title' : 'pollo-cover-title'} data-motion-step>MÁS POLLO.<br /><em>MÁS SABOR.</em></h1>
      <p class="cover-intro" data-motion-step>Pollo frito, asado y rostizado para reunir a todos.</p>
      <a class="cover-link" href={demo ? '#menu' : '#pollo-menu-list'}>VER EL MENÚ <span aria-hidden="true">↘</span></a>
      <span class="cover-index">COMBOS DE 8 A 24 PIEZAS · PARA COMPARTIR</span>
    </div>
    <div class="cover-art" aria-label={leadProduct ? `Fotografía del producto ${leadProduct.name}` : undefined}>
      {leadProduct?.image ? <img src={leadProduct.image} alt={leadProduct.name} fetchpriority="high" data-motion-image data-motion-parallax /> : <div class="photo-unavailable">Fotografía no disponible</div>}
      <div class="art-note"><span>DEL MENÚ</span><b>{leadProduct?.name ?? 'Pollo Fresa'}</b></div>
      <span class="art-number">01</span>
    </div>
    <span class="vertical-note" aria-hidden="true">Pollo Fresa — MENÚ</span>
  </section>

  {!demo && <StorefrontPromotions brand="Pollo Fresa" promotions={promotions} products={products} />}

  <section class="category-band" id={demo ? 'categorias' : 'pollo-categorias'} aria-label="Explorar categorías">
    <span>ENCUENTRA TU ANTOJO</span>
<div class="category-links">
      {visibleCategories.map((category, index) => <a href={`#categoria-${category.id}`} data-motion-hover><i>{String(index + 1).padStart(2, '0')}</i>{category.name}<b aria-hidden="true">↗</b></a>)}
    </div>
  </section>

  <section class="menu-area" id={demo ? 'menu' : 'pollo-menu-list'}>
    <header class="menu-heading" data-motion-story><p class="kicker" data-motion-step>El menú de la casa</p><h2 data-motion-step>Tradición para<br /><em>compartir.</em></h2><p data-motion-step>{products.length} productos disponibles</p></header>

    {friedCategory && friedProducts.length > 0 && <section class:list={['fried-feature', !demo && 'product-card']} id={`categoria-${friedCategory.id}`} aria-labelledby="fried-title" data-product-id={initialCombo?.id}>
      <div class="fried-photo" data-combo-photo>
        <img data-selected-image data-motion-image data-motion-parallax src={initialCombo?.image} alt={initialCombo?.name ?? 'Producto'} fetchpriority="high" hidden={!initialCombo?.image} />
        <div class="photo-unavailable" data-selected-placeholder hidden={Boolean(initialCombo?.image)}>Fotografía no disponible</div>
        <span class="photo-overline">POLLO FRITO · PARA COMPARTIR</span>
        <span class="photo-index" aria-hidden="true">01 / 05</span>
      </div>
      <div class="fried-copy" data-motion-story>
        <p class="kicker" data-motion-step>Combos Pollo Frito</p>
        <h2 id="fried-title" data-motion-step>EL CRUNCH<br /><em>QUE REÚNE.</em></h2>
        <p class="fried-intro" data-motion-step>Crujiente para compartir, con el tamaño que pide la reunión.</p>
        {initialCombo && <div class="selected-combo" aria-live="polite" aria-atomic="true">
          <span>COMBO SELECCIONADO</span>
          <h3 data-selected-name>{initialCombo.name}</h3>
          <strong data-selected-price>{initialCombo.price}</strong>
          <p data-selected-description>{initialCombo.description}</p>
          <div data-selected-options class="selected-options">
            {initialCombo.optionGroups.map((group) => <div data-group-id={group.id}><b>{group.name}</b><span>{group.options.map((option) => option.name).join(' · ')}</span></div>)}
          </div>
          <details class="combo-full-description"><summary>Leer descripción completa</summary><p data-selected-full-description>{initialCombo.description}</p></details>
        </div>}
        <div class="combo-picker" role="group" aria-label="Seleccionar combo de pollo frito">
          <span class="picker-label">ELIGE TU COMBO</span>
          <div class="combo-options">
            {friedProducts.map((product, index) => <button type="button" id={!demo ? `promotion-product-${product.id}` : undefined} class="combo-option" class:active={product.id === initialCombo?.id} aria-pressed={product.id === initialCombo?.id} aria-label={`Seleccionar ${product.name}`} data-combo-product={productPayload(product)} data-motion-hover>
              <b>{product.name.match(/\d+/)?.[0] ?? product.name}</b><small>piezas</small>
            </button>)}
          </div>
        </div>
        <div class="combo-buy">
          {demo
            ? <button type="button" disabled aria-describedby="combo-disabled">Agregar al pedido <span aria-hidden="true">＋</span></button>
            : <button type="button" class="add-button" aria-label={`Agregar ${initialCombo.name} al pedido`} data-add-product={initialCombo.id}>Agregar <span>+</span></button>}
          {demo && <small id="combo-disabled">Compra desactivada en esta demostración</small>}
        </div>
      </div>
    </section>}

    {roastProduct && <section class:list={['roast-feature', !demo && 'product-card']} id={`categoria-${roastCategory?.id}`} aria-labelledby="roast-title" data-product-id={roastProduct.id}>
      <div class="roast-copy" data-motion-story>
        <p class="kicker" data-motion-step>Combos Pollo Asado</p>
        <span class="editorial-number">02 <i>—</i> A LAS BRASAS</span>
        <h2 id="roast-title" data-motion-step>FUEGO.<br /><em>SABOR.</em></h2>
        <h3 data-motion-step>{roastProduct.name}</h3>
        <p class="description-clamp">{roastProduct.description}</p>
        <details class="full-description"><summary>Leer descripción completa</summary><p>{roastProduct.description}</p></details>
        <div class="roast-price"><strong>{roastProduct.price}</strong><span>Precio del catálogo</span></div>
        {roastProduct.optionGroups.length > 0 && <div class="product-options">{roastProduct.optionGroups.map((group) => <span>{group.name}</span>)}</div>}
        {demo
          ? <button class="disabled-action" type="button" disabled>Agregar al pedido <span aria-hidden="true">＋</span></button>
          : <button id={`promotion-product-${roastProduct.id}`} class="disabled-action add-button" type="button" aria-label={`Agregar ${roastProduct.name} al pedido`}>Agregar <span>＋</span></button>}
        {demo && <small class="disabled-note">Compra desactivada en esta demostración</small>}
      </div>
      <figure class="roast-photo">
        {roastProduct.image ? <img src={roastProduct.image} alt={roastProduct.name} loading="lazy" data-motion-image data-motion-parallax /> : <div class="photo-unavailable">Fotografía no disponible</div>}
        <figcaption>{roastProduct.name} <i>·</i> Pollo Fresa</figcaption>
      </figure>
      <span class="roast-side-note" aria-hidden="true">CALOR LENTO · SABOR DE CASA</span>
    </section>}

    {rotisserieProduct && <section class:list={['rotisserie-feature', !demo && 'product-card']} id={`categoria-${rotisserieCategory?.id}`} aria-labelledby="rotisserie-title" data-product-id={rotisserieProduct.id}>
      <div class="rotisserie-image">
        {rotisserieProduct.image ? <img src={rotisserieProduct.image} alt={rotisserieProduct.name} loading="lazy" data-motion-image data-motion-parallax /> : <div class="photo-unavailable">Fotografía no disponible</div>}
        <span class="rotisserie-stamp">HECHO<br />PARA<br /><i>REUNIR</i></span>
      </div>
      <div class="rotisserie-copy" data-motion-story>
        <span class="editorial-number">03 <i>—</i> GIRO A GIRO</span>
        <p class="kicker" data-motion-step>Combos Pollo Rostizado</p>
        <h2 id="rotisserie-title" data-motion-step>GIRO.<br /><em>DORADO.</em><br />JUGOSO.</h2>
        <p class="rotisserie-product-name">{rotisserieProduct.name}</p>
        <p class="description-clamp">{rotisserieProduct.description}</p>
        <details class="full-description"><summary>Leer descripción completa</summary><p>{rotisserieProduct.description}</p></details>
        <div class="rotisserie-price"><strong>{rotisserieProduct.price}</strong><span>Precio del catálogo</span></div>
        {rotisserieProduct.optionGroups.length > 0 && <div class="product-options">{rotisserieProduct.optionGroups.map((group) => <span>{group.name}</span>)}</div>}
        {demo
          ? <button class="disabled-action" type="button" disabled>Agregar al pedido <span aria-hidden="true">＋</span></button>
          : <button id={`promotion-product-${rotisserieProduct.id}`} class="disabled-action add-button" type="button" aria-label={`Agregar ${rotisserieProduct.name} al pedido`}>Agregar <span>＋</span></button>}
        {demo && <small class="disabled-note">Compra desactivada en esta demostración</small>}
      </div>
    </section>}

    {remainingProducts.length > 0 && <section class="remaining-products" aria-label="Otros productos disponibles">
      {remainingProducts.map((product) => <article id={!demo ? `promotion-product-${product.id}` : undefined} class:list={[!demo && 'product-card']} data-product-id={product.id}><span>{product.category}</span><h3>{product.name}</h3><p>{product.description}</p><strong>{product.price}</strong>{demo ? <button type="button" disabled>Agregar al pedido</button> : <button type="button" class="add-button">Agregar <span>+</span></button>}</article>)}
    </section>}
    {!friedProducts.length && !roastProduct && !rotisserieProduct && <p class="empty-catalog">No hay productos disponibles para esta marca en este momento.</p>}
  </section>

  {demo && <footer class="proto-footer" id="nota"><span>Pollo Fresa</span><p>Prototipo visual conectado al catálogo disponible. El carrito y los pedidos permanecen desactivados.</p><a href="#inicio">Volver arriba ↑</a></footer>}
</div>

<script>
  const picker = document.querySelector('.pollo-concept .combo-options');
  const selectedImage = document.querySelector<HTMLImageElement>('[data-selected-image]');
  const selectedName = document.querySelector<HTMLElement>('[data-selected-name]');
  const selectedPrice = document.querySelector<HTMLElement>('[data-selected-price]');
  const selectedDescription = document.querySelector<HTMLElement>('[data-selected-description]');
  const selectedFullDescription = document.querySelector<HTMLElement>('[data-selected-full-description]');
  const selectedOptions = document.querySelector<HTMLElement>('[data-selected-options]');
  const selectedPlaceholder = document.querySelector<HTMLElement>('[data-selected-placeholder]');
  const comboFeature = document.querySelector<HTMLElement>('.fried-feature');
  const purchaseButton = document.querySelector<HTMLButtonElement>('.fried-copy .combo-buy button');

  picker?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-combo-product]');
    if (!button) return;
    const product = JSON.parse(button.dataset.comboProduct ?? '{}') as {
      id: number; name: string; price: string; image?: string; description: string;
      optionGroups: { id: number; name: string; required: boolean; options: { id: number; name: string; priceDelta: number }[] }[];
    };
    picker.querySelectorAll<HTMLButtonElement>('[data-combo-product]').forEach((option) => {
      const active = option === button;
      option.classList.toggle('active', active);
      option.setAttribute('aria-pressed', String(active));
    });
    if (selectedName) selectedName.textContent = product.name;
    if (selectedPrice) selectedPrice.textContent = product.price;
    if (selectedDescription) selectedDescription.textContent = product.description;
    if (selectedFullDescription) selectedFullDescription.textContent = product.description;
    if (comboFeature) comboFeature.dataset.productId = String(product.id);
    if (selectedPlaceholder) selectedPlaceholder.hidden = Boolean(product.image);
    if (selectedImage && product.image) {
      selectedImage.classList.add('is-changing');
      selectedImage.addEventListener('transitionend', () => selectedImage.classList.remove('is-changing'), { once: true });
      selectedImage.src = product.image;
      selectedImage.alt = product.name;
      selectedImage.hidden = false;
    } else if (selectedImage) {
      selectedImage.hidden = true;
    }
    if (purchaseButton) {
      purchaseButton.dataset.productId = String(product.id);
      purchaseButton.dataset.addProduct = String(product.id);
      purchaseButton.dataset.productPrice = product.price;
      purchaseButton.dataset.productImage = product.image ?? '';
      purchaseButton.dataset.productOptions = JSON.stringify(product.optionGroups);
    }
    if (selectedOptions) {
      selectedOptions.replaceChildren(...product.optionGroups.map((group) => {
        const row = document.createElement('div');
        row.dataset.groupId = String(group.id);
        const heading = document.createElement('b');
        heading.textContent = group.name;
        const values = document.createElement('span');
        values.replaceChildren(...group.options.map((option) => {
          const name = document.createElement('span');
          name.dataset.optionId = String(option.id);
          name.textContent = option.name;
          return name;
        }));
        row.append(heading, values);
        return row;
      }));
    }
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Barlow+Condensed:wght@500;600;700;800;900&display=swap');
  .pollo-concept{--accent:#b93827;--paper:#f1e9da;--ink:#251e19;--muted:#756d62;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;--display:'Barlow Condensed',Impact,sans-serif;color:var(--ink);font-family:var(--sans);overflow:hidden;background:var(--paper)}
