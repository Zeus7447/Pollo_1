---
import Layout from '../layouts/Layout_index.astro';
import ScrollVideoHero from '../components/ScrollVideoHero.astro';
import PolloFresaMenu from '../components/PolloFresaMenu.astro';
import FresaWingsShowcase from '../components/FresaWingsShowcase.astro';
import BrandTransition from '../components/BrandTransition.astro';
import StorefrontHeader from '../components/StorefrontHeader.astro';
import logo from '../assets/pollo_fresa.webp';
import polloCool from '../assets/pollo_cool.webp';
import fresaWingsCool from '../assets/fresa_wings_cool.webp';
import todoPoderoso from '../assets/todo_poderoso.webm';
import localPollo from '../assets/local_pollo.webp';
import localFresaWings from '../assets/local_fresa_wings.webp';
import { getCatalog } from '../lib/directus';
const { products: directusProducts, promotions, categories, catalogError } = await getCatalog();
const polloProducts = directusProducts.filter((product) => product.brand === 'Pollo Fresa');
const wingsProducts = directusProducts.filter((product) => product.brand === 'Fresa Wings');
const polloPromotions = promotions.filter((promotion) => promotion.brand === 'Pollo Fresa');
const wingsPromotions = promotions.filter((promotion) => promotion.brand === 'Fresa Wings');
---
<Layout>
<StorefrontHeader />
<ScrollVideoHero />
<BrandTransition />
{promotions.length > 0 && <nav class="promotion-directory" id="promociones" aria-label="Explorar promociones por marca">
  <span>Promociones disponibles</span>
  {polloPromotions.length > 0 && <a href="#promociones-pollo" data-promotion-jump data-promotion-theme="theme-pollo">Pollo Fresa <b>{polloPromotions.length}</b><span aria-hidden="true">&#8599;</span></a>}
  {wingsPromotions.length > 0 && <a href="#promociones-wings" data-promotion-jump data-promotion-theme="theme-wings">Fresa Wings <b>{wingsPromotions.length}</b><span aria-hidden="true">&#8599;</span></a>}
</nav>}
<main id="contenido">
{catalogError ? <section class="catalog-error section-wrap" id="destacados" role="alert"><p class="eyebrow">Menú temporalmente no disponible</p><h2>No pudimos cargar el catálogo.</h2><p>El servicio del catálogo no respondió. Puedes intentarlo de nuevo en unos momentos.</p><a class="catalog-retry" href="/">Intentar de nuevo</a></section> : <div id="menus-integrados"><PolloFresaMenu products={polloProducts} categories={categories.filter((category) => category.brand === 'Pollo Fresa')} promotions={polloPromotions} demo={false} /><FresaWingsShowcase products={wingsProducts} categories={categories.filter((category) => category.brand === 'Fresa Wings')} /></div>}
<section class="location section-wrap" id="ubicacion"><header class="location-heading"><p class="eyebrow">Encuéntranos</p><h2>Ven por tu <em>antojo.</em></h2></header><div class="location-map-panel"><div class="map-placeholder"><iframe id="location-map" title="Mapa de Pollo Fresa en Irapuato" src="https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="location-addresses"><a data-location="pollo" href="https://www.google.com/maps/search/?api=1&query=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>01</span><div><strong>Pollo Fresa</strong><small>Av. Mariano J. García 1254, Los Álamos</small></div></a><a data-location="wings" href="https://www.google.com/maps/search/?api=1&query=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>02</span><div><strong>Fresa Wings</strong><small>Av. Independencia 1811, Miguel Hidalgo</small></div></a></div></div><aside class="location-details"><div class="local-carousel" aria-label="Fotos de los locales"><figure class="local-photo is-active" data-location-photo="pollo"><img src={localPollo.src} alt="Local de Pollo Fresa" /><figcaption>Pollo Fresa</figcaption></figure><figure class="local-photo" data-location-photo="wings"><img src={localFresaWings.src} alt="Local de Fresa Wings" /><figcaption>Fresa Wings</figcaption></figure><div class="carousel-dots" aria-hidden="true"><span class="is-active"></span><span></span></div></div><div class="daily-hours"><p class="eyebrow">Horarios</p><h3>Todos los días</h3><div><p><strong>Pollo Fresa</strong><span>9 AM — 6 PM</span></p><p><strong>Fresa Wings</strong><span>3 PM — 10 PM</span></p></div></div></aside></section>
</main><footer id="contacto"><div class="footer-main"><img src={logo.src} alt="Pollo Fresa" /><p>Dos marcas, un solo lugar<br />para comer delicioso.</p><a class="button button-light" href="#pollo-menu">Pedir ahora</a></div><div class="footer-bottom"><span>© 2026 Pollo Fresa</span><nav class="footer-socials" aria-label="Redes sociales"><a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.7.3-1 1-1Z" /></svg></a><a href="#" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4a9 9 0 0 0-14 11L4 20l5-2a9 9 0 0 0 11-14Zm-8 15a7 7 0 0 1-4-1l-3 1 1-3a7 7 0 1 1 6 3Zm4-5c-.2.4-1 .8-1.4.8-.4.1-1 .1-1.6-.2a8 8 0 0 1-3.2-2.8c-.3-.5-.8-1.4-.8-2.1 0-.7.4-1.2.7-1.4.2-.2.5-.2.7-.2h.5c.2 0 .3.1.4.4l.6 1.4c.1.3.1.4-.1.6l-.4.5c-.1.1-.2.2-.1.4.2.4.6 1 1.1 1.4.6.5 1.1.7 1.5.8.2.1.3 0 .4-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.2.2.4Z" /></svg></a><a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="fill" /></svg></a></nav><span>Hecho para compartir.</span></div></footer>
</Layout>
<script>
  import { installFoodMotion } from '../lib/motion/foodMotion';

  installFoodMotion();
</script>
<div class="cart-ui" data-cart-ui>
  <button class="cart-fab" type="button" data-cart-toggle aria-controls="cart-drawer" aria-expanded="false">
    <svg class="cart-fab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.1 10.1a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6" /><circle cx="10" cy="20" r="1" /><circle cx="18" cy="20" r="1" /></svg>
    <span>Mi pedido</span>
    <b data-cart-count>0</b>
  </button>
  <div class="cart-backdrop" data-cart-close></div>
  <aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true" tabindex="-1" inert>
    <header class="cart-header">
      <div><p>TU CARRITO</p><h2 id="cart-title">Tu pedido</h2></div>
      <button type="button" class="cart-close" data-cart-close aria-label="Cerrar carrito"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </header>
    <div class="cart-hours" data-cart-hours></div>
    <div class="cart-items" data-cart-items></div>
    <p class="cart-checkout-error" data-checkout-error role="alert" hidden></p>
    <footer class="cart-footer">
      <div class="cart-summary" data-cart-summary>
        <div class="cart-total"><span>Total del pedido</span><strong data-cart-total>$0.00</strong></div>
        <button class="cart-checkout" type="button" data-cart-checkout>Confirmar mi carrito <span aria-hidden="true">&#8594;</span></button>
        <p class="cart-note" data-cart-note aria-live="polite">Revisa tus productos antes de continuar.</p>
      </div>
    </footer>
  </aside>
</div>
<div class="product-options-modal" data-product-options-modal hidden>
  <div class="product-options-backdrop" data-product-options-close></div>
  <section class="product-options-dialog" role="dialog" aria-modal="true" aria-labelledby="product-options-title" aria-describedby="product-options-description" tabindex="-1">
    <header class="product-options-header">
      <img class="product-options-image" data-product-options-image alt="" />
      <div class="product-options-heading-copy">
        <h2 id="product-options-title" data-product-options-title></h2>
        <p class="product-options-description" id="product-options-description" data-product-options-description>Personaliza tu pedido</p>
        <p class="product-options-base" data-product-options-base></p>
      </div>
      <button type="button" class="product-options-close" data-product-options-close aria-label="Cerrar opciones">×</button>
    </header>
    <div class="product-options-selection-status" data-product-options-summary aria-live="polite"></div>
    <div class="product-options-groups" data-product-options-groups></div>
    <p class="product-options-error" data-product-options-error role="alert" hidden></p>
    <footer class="product-options-footer">
      <div class="product-options-total"><small>Total por producto</small><strong data-product-options-total>$0.00</strong></div>
      <button type="button" class="product-options-add" data-product-options-add disabled>Agregar al pedido</button>
    </footer>
  </section>
</div>
<div class="theme-switcher" aria-label="Selector de tema para pruebas">
  <button class="theme-switcher-toggle" type="button" aria-expanded="false">Tema <span>⌄</span></button>
  <div class="theme-switcher-menu" role="group" aria-label="Temas disponibles">
    <button type="button" data-theme-choice="auto">Automático</button>
    <button type="button" data-theme-choice="theme-pollo">Pollo Fresa</button>
    <button type="button" data-theme-choice="theme-wings">Fresa Wings</button>
    <button type="button" data-theme-choice="theme-combined">Combinado</button>
  </div>
</div>
<script define:vars={{ polloCoolSrc: polloCool.src, fresaWingsCoolSrc: fresaWingsCool.src, todoPoderosoSrc: todoPoderoso }}>
  document.querySelectorAll('.tab').forEach((tab) => tab.addEventListener('click', () => { document.querySelectorAll('.tab').forEach((item) => item.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('[data-menu]').forEach((menu) => menu.classList.toggle('hidden', menu.getAttribute('data-menu') !== tab.getAttribute('data-brand'))); }));
  let selectedTheme = 'auto'; const themeClasses = ['theme-pollo', 'theme-wings', 'theme-combined', 'theme-closed']; const syncCatalogBrand = (theme) => { const brand = theme === 'theme-pollo' ? 'Pollo Fresa' : theme === 'theme-wings' ? 'Fresa Wings' : null; document.querySelectorAll('[data-catalog-brand], [data-promotion-brand]').forEach((section) => { const sectionBrand = section.getAttribute('data-catalog-brand') ?? section.getAttribute('data-promotion-brand'); section.hidden = Boolean(brand && sectionBrand !== brand); }); }; const applyTheme = (theme, catalogTheme = theme) => { document.body.classList.remove(...themeClasses); document.body.classList.add(theme); syncCatalogBrand(catalogTheme); };
  const updateStatus = () => { const hour = new Date().getHours(); const pollo = hour >= 9 && hour < 18; const wings = hour >= 15 && hour < 22; const automaticTheme = pollo && wings ? 'theme-combined' : pollo ? 'theme-pollo' : wings ? 'theme-wings' : 'theme-closed'; applyTheme(selectedTheme === 'auto' ? automaticTheme : selectedTheme, selectedTheme === 'auto' ? 'theme-combined' : selectedTheme); document.querySelector('.pollo-status')?.classList.toggle('open', pollo); document.querySelector('.wings-status')?.classList.toggle('open', wings); const labels = document.querySelectorAll('.status-label'); if (labels[0]) labels[0].textContent = pollo ? 'Abierto ahora' : hour < 9 ? 'Abre a las 9 AM' : 'Cerrado · abre mañana'; if (labels[1]) labels[1].textContent = wings ? 'Abierto ahora' : hour < 15 ? 'Abre a las 3 PM' : 'Cerrado · abre mañana'; }; updateStatus(); setInterval(updateStatus, 60000);
  const themeToggle = document.querySelector('.theme-switcher-toggle'); const themeMenu = document.querySelector('.theme-switcher-menu'); themeToggle?.addEventListener('click', () => { const open = themeMenu?.classList.toggle('is-open') ?? false; themeToggle.setAttribute('aria-expanded', String(open)); }); document.querySelectorAll('[data-theme-choice]').forEach((choice) => choice.addEventListener('click', () => { selectedTheme = choice.getAttribute('data-theme-choice') ?? 'auto'; updateStatus(); themeMenu?.classList.remove('is-open'); themeToggle?.setAttribute('aria-expanded', 'false'); }));
  document.querySelectorAll<HTMLAnchorElement>('[data-promotion-jump]').forEach((link) => link.addEventListener('click', () => { const theme = link.dataset.promotionTheme; if (theme) { selectedTheme = theme; updateStatus(); } }));
  const polloCard = document.querySelector('.brand-pollo');
  if (polloCard && !polloCard.querySelector('.pollo-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'pollo-cool-visual'; coolVisual.src = polloCoolSrc; coolVisual.alt = 'Pollo Fresa'; polloCard.append(coolVisual); }
  if (polloCard && !polloCard.querySelector('.promo-fresona')) { const promo = document.createElement('div'); promo.className = 'promo-fresona'; promo.innerHTML = '<p>Promociones</p><h3>Disfruta de nuestras<br><em>promos fresonas.</em></h3><a href="#promociones">Ver promociones</a>'; polloCard.append(promo); }
  const wingsCard = document.querySelector('.brand-wings');
  if (wingsCard && !wingsCard.querySelector('.wings-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'wings-cool-visual'; coolVisual.src = fresaWingsCoolSrc; coolVisual.alt = 'Fresa Wings'; wingsCard.append(coolVisual); }
  if (wingsCard && !wingsCard.querySelector('.promo-wings')) { const promo = document.createElement('div'); promo.className = 'promo-wings'; promo.innerHTML = '<p>Promociones</p><h3>Sube el nivel con<br><em>Fresa Wings.</em></h3><a href="#promociones">Ver promociones</a>'; wingsCard.append(promo); }
  const brandsSection = document.querySelector('.brands');
  if (brandsSection && !brandsSection.querySelector('.combined-video')) { const video = document.createElement('video'); video.className = 'combined-video'; video.src = todoPoderosoSrc; video.autoplay = true; video.muted = true; video.loop = true; video.playsInline = true; video.setAttribute('aria-hidden', 'true'); brandsSection.prepend(video); const powerTitle = document.createElement('div'); powerTitle.className = 'combined-power-title'; powerTitle.innerHTML = '<p>De 3 PM a 6 PM</p><h2>Tienes el poder de <em>pedirlo todo.</em></h2><span>Pollo Fresa y Fresa Wings, juntos en un solo pedido.</span>'; video.insertAdjacentElement('beforebegin', powerTitle); }
</script>
<script>
  const mapUrls = {
    pollo: 'https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed',
    wings: 'https://www.google.com/maps?q=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto.&output=embed',
    combined: 'https://www.google.com/maps?q=Pollo%20Fresa%20Irapuato%20Guanajuato&output=embed',
  };
  let carouselIndex = 0;
  const refreshLocations = () => {
    const mode = document.body.classList.contains('theme-combined') ? 'combined' : document.body.classList.contains('theme-wings') ? 'wings' : 'pollo';
    const map = document.querySelector('#location-map');
    if (map instanceof HTMLIFrameElement && map.getAttribute('src') !== mapUrls[mode]) map.src = mapUrls[mode];
    document.querySelectorAll('[data-location]').forEach((item) => item.classList.toggle('is-visible', mode === 'combined' || item.getAttribute('data-location') === mode));
    const photo = mode === 'combined' ? (carouselIndex % 2 === 0 ? 'pollo' : 'wings') : mode;
    document.querySelectorAll('[data-location-photo]').forEach((item) => item.classList.toggle('is-active', item.getAttribute('data-location-photo') === photo));
    document.querySelectorAll('.carousel-dots span').forEach((dot, index) => dot.classList.toggle('is-active', index === (photo === 'pollo' ? 0 : 1)));
  };
  refreshLocations();
  new MutationObserver(refreshLocations).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  setInterval(() => { if (document.body.classList.contains('theme-combined')) carouselIndex += 1; refreshLocations(); }, 4200);
</script>
<script define:vars={{ cartProducts: directusProducts }}>
  const CART_KEY = 'pollo-fresa-cart-v1';
  const schedules = {
    pollo: { label: 'Pollo Fresa', start: 9, end: 18 },
    wings: { label: 'Fresa Wings', start: 15, end: 22 },
  };
  const cartUi = document.querySelector('[data-cart-ui]');
  const cartDrawer = document.querySelector('#cart-drawer');
  const cartItemsElement = document.querySelector('[data-cart-items]');
  const cartHoursElement = document.querySelector('[data-cart-hours]');
  const cartTotalElement = document.querySelector('[data-cart-total]');
  const cartNoteElement = document.querySelector('[data-cart-note]');
  const checkoutButton = document.querySelector('[data-cart-checkout]');
  const cartCountElements = document.querySelectorAll('[data-cart-count]');
  const checkoutError = document.querySelector('[data-checkout-error]');
  const productOptionsModal = document.querySelector('[data-product-options-modal]');
  const productOptionsTitle = document.querySelector('[data-product-options-title]');
  const productOptionsBase = document.querySelector('[data-product-options-base]');
  const productOptionsImage = document.querySelector('[data-product-options-image]');
  const productOptionsDescription = document.querySelector('[data-product-options-description]');
  const productOptionsSummary = document.querySelector('[data-product-options-summary]');
  const productOptionsTotal = document.querySelector('[data-product-options-total]');
  const productOptionsGroups = document.querySelector('[data-product-options-groups]');
  const productOptionsError = document.querySelector('[data-product-options-error]');
  const productOptionsAdd = document.querySelector('[data-product-options-add]');
  let productBeingConfigured = null;
  let configuredSelections = [];
  let editingLineKey = null;
  let focusReturnElement = null;
  let confirmPending = false;
  let cartReturnFocus = null;
  let previousCartOverflow = '';

  const getHour = () => new Date().getHours();
  const isOpen = (brand) => {
    const schedule = schedules[brand] ?? schedules.pollo;
    const hour = getHour();
    return hour >= schedule.start && hour < schedule.end;
  };
  const nextOpening = (brand) => {
    const schedule = schedules[brand] ?? schedules.pollo;
    const hour = getHour();
    return hour < schedule.start ? `Abre a las ${schedule.start > 12 ? schedule.start - 12 : schedule.start} ${schedule.start >= 12 ? 'PM' : 'AM'}` : 'Abre mañana';
  };
  const priceNumber = (price) => Number(String(price).replace(/[^0-9.]/g, '')) || 0;
  const formatPrice = (value) => `$${value.toFixed(2)}`;
  const getProduct = (id) => cartProducts.find((product) => String(product.id) === String(id));
  const getBrandKey = (product) => product?.brand === 'Fresa Wings' ? 'wings' : 'pollo';
  const getOptionGroups = (product) => Array.isArray(product?.optionGroups) ? product.optionGroups : [];
  const selectionKey = (selectedOptions = []) => selectedOptions.map((selection) => `${selection.groupId}:${selection.optionId}`).sort().join('|');
  const lineKey = (item) => `${item.id}:${selectionKey(item.selectedOptions) || 'standard'}`;
  const getLineOptions = (product, item) => (item.selectedOptions ?? []).map((selection) => {
    const group = getOptionGroups(product).find((candidate) => Number(candidate.id) === Number(selection.groupId));
    const option = group?.options?.find((candidate) => Number(candidate.id) === Number(selection.optionId));
    return group && option ? { group, option } : null;
  }).filter(Boolean);
  const getLineUnitPrice = (product, item) => priceNumber(product.price) + getLineOptions(product, item).reduce((sum, selection) => sum + priceNumber(selection.option.priceDelta), 0);
  const loadCart = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
      return Array.isArray(saved) ? saved
        .filter((item) => getProduct(item.id) && Number.isInteger(item.quantity) && item.quantity > 0)
        .map((item) => ({ id: item.id, quantity: item.quantity, selectedOptions: Array.isArray(item.selectedOptions) ? item.selectedOptions.filter((selection) => Number.isInteger(selection?.groupId) && Number.isInteger(selection?.optionId)) : [] })) : [];
    } catch { return []; }
  };
  let cart = loadCart();
  const saveCart = () => localStorage.setItem(CART_KEY, JSON.stringify(cart));
  const setDrawer = (open) => {
    const wasOpen = cartUi?.classList.contains('is-open') ?? false;
    if (open && !wasOpen) {
      cartReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousCartOverflow = document.body.style.overflow;
    }
    cartUi?.classList.toggle('is-open', open);
    document.body.classList.toggle('cart-open', open);
    cartDrawer?.setAttribute('aria-hidden', String(!open));
    if (cartDrawer instanceof HTMLElement) {
      cartDrawer.inert = !open;
      if (open) requestAnimationFrame(() => cartDrawer.focus());
    }
    if (open) document.body.style.overflow = 'hidden';
    else if (wasOpen) {
      document.body.style.overflow = previousCartOverflow;
      if (cartReturnFocus?.isConnected) cartReturnFocus.focus();
      cartReturnFocus = null;
    }
    document.querySelectorAll('[data-cart-toggle]').forEach((button) => button.setAttribute('aria-expanded', String(open)));
  };
  const showCheckoutError = (message = '') => {
    if (!(checkoutError instanceof HTMLElement)) return;
    checkoutError.textContent = message;
    checkoutError.hidden = !message;
  };

  const renderCart = () => {
    const count = cart.reduce((total, item) => total + item.quantity, 0);
    const hydratedItems = cart.map((item) => ({ ...item, product: getProduct(item.id) })).filter((item) => item.product);
    const total = hydratedItems.reduce((sum, item) => sum + getLineUnitPrice(item.product, item) * item.quantity, 0);
    cartCountElements.forEach((element) => { element.textContent = String(count); element.classList.toggle('has-items', count > 0); });
    cartUi?.classList.toggle('is-empty', hydratedItems.length === 0);
    if (cartTotalElement) cartTotalElement.textContent = formatPrice(total);
    if (cartHoursElement) {
      cartHoursElement.innerHTML = Object.entries(schedules).map(([brand, schedule]) => `<p class="${isOpen(brand) ? 'is-open' : ''}"><span></span><strong>${schedule.label}</strong><small>${isOpen(brand) ? 'Disponible ahora' : nextOpening(brand)}</small></p>`).join('');
    }
    if (cartItemsElement) {
      cartItemsElement.innerHTML = hydratedItems.length ? hydratedItems.map((item) => {
        const { quantity, product } = item;
        const brand = getBrandKey(product);
        const available = isOpen(brand);
        const selections = getLineOptions(product, item);
        const selectionLabel = selections.length ? `<p class="cart-item-options">${selections.map(({ group, option }) => `${escapeHtml(group.name)}: ${escapeHtml(option.name)}`).join(' · ')}</p>` : '';
        const key = escapeHtml(lineKey(item));
        const editButton = getOptionGroups(product).length || item.selectedOptions?.length ? `<button type="button" class="cart-item-edit" data-cart-edit="${key}">Editar opciones</button>` : '';
        const image = product.image ? `<img class="cart-item-image" src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : '<div class="cart-item-image cart-item-image-empty" aria-hidden="true"></div>';
        return `<article class="cart-item ${available ? '' : 'is-closed'}">${image}<div class="cart-item-content"><small>${schedules[brand].label}</small><h3>${escapeHtml(product.name)}</h3>${selectionLabel}${editButton}<div class="cart-item-price"><span>${formatPrice(getLineUnitPrice(product, item))} c/u</span><b>${formatPrice(getLineUnitPrice(product, item) * quantity)}</b></div>${available ? '' : `<em>${nextOpening(brand)}</em>`}</div><div class="cart-item-actions"><div class="cart-quantity"><button type="button" data-cart-change="${key}" data-change="-1" aria-label="Quitar una unidad de ${escapeHtml(product.name)}">−</button><span>${quantity}</span><button type="button" data-cart-change="${key}" data-change="1" aria-label="Agregar una unidad de ${escapeHtml(product.name)}">+</button></div><button type="button" class="cart-item-remove" data-cart-remove="${key}" aria-label="Eliminar ${escapeHtml(product.name)} del pedido">Eliminar</button></div></article>`;
      }).join('') : `<section class="cart-empty-state" aria-labelledby="cart-empty-title"><div class="cart-empty-mark" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M8 17h32l-3 25H11L8 17Z"/><path d="M17 18v-5a7 7 0 0 1 14 0v5M19 27v7m10-7v7"/></svg></div><p class="cart-empty-kicker">Tu antojo empieza aquí</p><h3 id="cart-empty-title">Tu carrito está vacío</h3><p class="cart-empty-copy">Elige tus favoritos y arma tu pedido.</p><nav class="cart-empty-brands" aria-label="Explorar marcas"><a href="#pollo-menu" data-cart-browse><span><b>Pollo Fresa</b><small>Frito, asado y rostizado</small></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a href="#fresa-wings-menu" data-cart-browse><span><b>Fresa Wings</b><small>Alitas, boneless y más</small></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></nav><a class="cart-empty-cta" href="#pollo-menu" data-cart-browse>Explorar el menú<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></section>`;
    }
    const canCheckout = hydratedItems.length > 0;
    if (checkoutButton instanceof HTMLButtonElement) checkoutButton.disabled = !canCheckout;
    if (cartNoteElement) cartNoteElement.textContent = !hydratedItems.length ? 'Agrega tus favoritos para empezar.' : 'Elige cómo recibirlo y revisa tu pedido en el siguiente paso.';
  };

  const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
  const showProductOptionsError = (message = '') => {
    if (!(productOptionsError instanceof HTMLElement)) return;
    productOptionsError.textContent = message;
    productOptionsError.hidden = !message;
  };
  const getOptionSelectionError = (product, selections) => {
    if ((selections ?? []).some((selection) => {
      const group = getOptionGroups(product).find((candidate) => Number(candidate.id) === Number(selection.groupId));
      return !group || !group.options.some((option) => Number(option.id) === Number(selection.optionId));
    })) return `Las opciones de ${product.name} cambiaron. Edítalas antes de enviar el pedido.`;
    for (const group of getOptionGroups(product)) {
      if (group.maxSelect && group.minSelect > group.maxSelect) return `La configuración de ${group.name} no es válida. Intenta más tarde o contáctanos.`;
      if (group.minSelect > 0 && group.options.length < group.minSelect) return `No hay suficientes opciones activas para ${group.name}. Intenta más tarde o contáctanos.`;
      const count = selections.filter((selection) => Number(selection.groupId) === Number(group.id)).length;
      if (count < group.minSelect) return `Elige ${group.minSelect === 1 ? 'una opción' : `${group.minSelect} opciones`} para ${group.name}.`;
      if (group.maxSelect && count > group.maxSelect) return `Puedes elegir hasta ${group.maxSelect} opciones para ${group.name}.`;
    }
    return '';
  };
  const renderProductOptions = () => {
    const product = productBeingConfigured;
    if (!product || !(productOptionsGroups instanceof HTMLElement)) return;
    if (productOptionsTitle) productOptionsTitle.textContent = product.name;
    if (productOptionsDescription) productOptionsDescription.textContent = 'Personaliza tu pedido';
    if (productOptionsImage instanceof HTMLImageElement) {
      productOptionsImage.hidden = !product.image;
      productOptionsImage.src = product.image ?? '';
      productOptionsImage.alt = product.image ? product.name : '';
    }
    if (productOptionsBase) productOptionsBase.textContent = `Precio base · ${formatPrice(priceNumber(product.price))}`;
    const optionGroups = getOptionGroups(product);
    productOptionsGroups.innerHTML = optionGroups.map((group) => {
      const selected = new Set(configuredSelections.filter((selection) => Number(selection.groupId) === Number(group.id)).map((selection) => Number(selection.optionId)));
      const selectedCount = selected.size;
      const oneRequiredChoice = group.minSelect === 1 && group.maxSelect === 1;
      const help = group.minSelect > 0 && group.maxSelect ? `Elige de ${group.minSelect} a ${group.maxSelect}` : group.minSelect > 0 ? `Elige al menos ${group.minSelect}` : group.maxSelect ? `Opcional · hasta ${group.maxSelect}` : 'Opcional';
      const count = group.maxSelect ? `${selectedCount} de ${group.maxSelect} seleccionados` : `${selectedCount} seleccionados`;
      const emptyMessage = group.options.length ? '' : '<p class="option-group-empty">No hay opciones activas disponibles en este momento.</p>';
      return `<fieldset data-option-group="${group.id}"><legend><span>${escapeHtml(group.name)}</span><small>${help}</small><b class="product-option-count">${count}</b></legend>${emptyMessage}<div class="product-option-grid">${group.options.map((option) => `<label><input type="${oneRequiredChoice ? 'radio' : 'checkbox'}" name="option-group-${group.id}" value="${option.id}" ${selected.has(Number(option.id)) ? 'checked' : ''} /><span><span class="product-option-name">${escapeHtml(option.name)}</span>${priceNumber(option.priceDelta) > 0 ? `<b>+${formatPrice(priceNumber(option.priceDelta))}</b>` : ''}</span></label>`).join('')}</div></fieldset>`;
    }).join('');
    const unitPrice = priceNumber(product.price) + getLineOptions(product, { selectedOptions: configuredSelections }).reduce((sum, selection) => sum + priceNumber(selection.option.priceDelta), 0);
    const validationError = getOptionSelectionError(product, configuredSelections);
    if (productOptionsSummary) {
      const hasFlavorGroup = optionGroups.some((group) => /sabor|salsa/i.test(group.name));
      const selectedCount = configuredSelections.length;
      productOptionsSummary.textContent = `${optionGroups.length === 1 && hasFlavorGroup ? 'Elige tus sabores' : 'Elige tus opciones'} · ${selectedCount} seleccionado${selectedCount === 1 ? '' : 's'}`;
    }
    if (productOptionsTotal) productOptionsTotal.textContent = formatPrice(unitPrice);
    if (productOptionsAdd instanceof HTMLButtonElement) {
      productOptionsAdd.textContent = editingLineKey ? 'Guardar cambios' : 'Agregar al pedido';
      productOptionsAdd.disabled = Boolean(validationError) || confirmPending;
    }
  };
  const openProductOptions = (product, selectedOptions = [], lineKeyToEdit = null, source = document.activeElement) => {
    productBeingConfigured = product;
    configuredSelections = selectedOptions.filter((selection) => {
      const group = getOptionGroups(product).find((candidate) => Number(candidate.id) === Number(selection.groupId));
      return group?.options.some((option) => Number(option.id) === Number(selection.optionId));
    }).map((selection) => ({ ...selection }));
    editingLineKey = lineKeyToEdit;
    focusReturnElement = source instanceof HTMLElement ? source : null;
    showProductOptionsError(configuredSelections.length < selectedOptions.length ? 'Algunas opciones cambiaron y ya no están disponibles. Revisa la selección actualizada.' : '');
    renderProductOptions();
    if (productOptionsModal instanceof HTMLElement) productOptionsModal.hidden = false;
    document.body.classList.add('product-options-open');
    window.setTimeout(() => productOptionsModal?.querySelector('.product-options-close')?.focus(), 0);
  };
  const closeProductOptions = () => {
    if (productOptionsModal instanceof HTMLElement) productOptionsModal.hidden = true;
    document.body.classList.remove('product-options-open');
    productBeingConfigured = null;
    configuredSelections = [];
    editingLineKey = null;
    confirmPending = false;
    if (focusReturnElement?.isConnected) focusReturnElement.focus();
    focusReturnElement = null;
  };

  const addToCart = (productId, selectedOptions = []) => {
    const product = getProduct(productId);
    if (!product) return false;
    const itemKey = `${product.id}:${selectionKey(selectedOptions) || 'standard'}`;
    const existing = cart.find((item) => lineKey(item) === itemKey);
    if (existing) existing.quantity += 1;
    else cart.push({ id: product.id, quantity: 1, selectedOptions });
    saveCart();
    renderCart();
    setDrawer(true);
    return true;
  };

  const addButtonTimers = new WeakMap();
  const celebrateAdd = (button, card) => {
    const quantity = cart.find((item) => String(item.id) === button.dataset.addProduct && !(item.selectedOptions?.length))?.quantity ?? 1;
    window.clearTimeout(addButtonTimers.get(button));
    button.classList.add('is-added');
    card.classList.remove('is-adding');
    void card.offsetWidth;
    card.classList.add('is-adding');
    button.innerHTML = '<span class="add-button-label">Agregado</span><span aria-hidden="true">&#10003;</span>';
    const cartButton = document.querySelector('.cart-fab');
    const start = button.getBoundingClientRect();
    const target = cartButton?.getBoundingClientRect();
    if (target) {
      const chip = document.createElement('span');
      chip.className = 'cart-fly-chip';
      chip.textContent = `+${quantity}`;
      chip.style.left = `${start.right - 25}px`;
      chip.style.top = `${start.top + start.height / 2}px`;
      document.body.append(chip);
      requestAnimationFrame(() => {
        chip.style.transform = `translate(${target.left - start.right + 34}px, ${target.top - start.top - start.height / 2 + 20}px) scale(.35)`;
        chip.style.opacity = '0';
      });
      window.setTimeout(() => chip.remove(), 520);
      cartButton.classList.remove('is-pulsing');
      void cartButton.offsetWidth;
      cartButton.classList.add('is-pulsing');
    }
    const timer = window.setTimeout(() => {
      button.classList.remove('is-added');
      button.innerHTML = `<span class="add-button-label">Agregar otro</span><span>+</span>`;
    }, 1050);
    addButtonTimers.set(button, timer);
  };

  document.querySelectorAll('.product-card').forEach((card) => {
    const button = card.querySelector('.add-button');
    if (!(button instanceof HTMLButtonElement)) return;
    button.type = 'button';
    const updateButton = (product) => {
      const hasOptions = getOptionGroups(product).length > 0;
      button.innerHTML = hasOptions ? '<span class="add-button-label">Personalizar</span><span>+</span>' : '<span class="add-button-label">Agregar</span><span>+</span>';
      button.dataset.addProduct = String(product.id);
      button.setAttribute('aria-label', `${hasOptions ? 'Personalizar' : 'Agregar'} ${product.name} al pedido`);
    };
    const initialProduct = getProduct(button.dataset.addProduct ?? card.getAttribute('data-product-id'));
    if (!initialProduct) return;
    updateButton(initialProduct);
    button.addEventListener('click', () => {
      const product = getProduct(button.dataset.addProduct ?? card.getAttribute('data-product-id'));
      if (!product) return;
      card.setAttribute('data-product-id', String(product.id));
      updateButton(product);
      if (getOptionGroups(product).length > 0) openProductOptions(product, [], null, button);
      else if (addToCart(product.id)) celebrateAdd(button, card);
    });
  });
  document.querySelectorAll('[data-product-options-close]').forEach((button) => button.addEventListener('click', closeProductOptions));
  productOptionsGroups?.addEventListener('change', (event) => {
    const input = event.target instanceof HTMLInputElement ? event.target : null;
    if (!input || !productBeingConfigured) return;
    const groupId = Number(input.closest('[data-option-group]')?.getAttribute('data-option-group'));
    const optionId = Number(input.value);
    const group = getOptionGroups(productBeingConfigured).find((candidate) => Number(candidate.id) === groupId);
    if (!group || !Number.isInteger(optionId)) return;
    const withoutGroup = configuredSelections.filter((selection) => Number(selection.groupId) !== groupId);
    const withinGroup = configuredSelections.filter((selection) => Number(selection.groupId) === groupId && Number(selection.optionId) !== optionId);
    if (input.checked) {
      if (input.type === 'radio') configuredSelections = [...withoutGroup, { groupId, optionId }];
      else if (group.maxSelect && withinGroup.length >= group.maxSelect) {
        input.checked = false;
        showProductOptionsError(`Puedes elegir hasta ${group.maxSelect} opciones para ${group.name}.`);
        return;
      } else configuredSelections = [...withoutGroup, ...withinGroup, { groupId, optionId }];
    } else configuredSelections = [...withoutGroup, ...withinGroup];
    showProductOptionsError();
    renderProductOptions();
  });
  productOptionsAdd?.addEventListener('click', () => {
    if (!productBeingConfigured) return;
    const error = getOptionSelectionError(productBeingConfigured, configuredSelections);
    if (error) { showProductOptionsError(error); productOptionsGroups?.querySelector('input')?.focus(); return; }
    const product = productBeingConfigured;
    const selections = configuredSelections;
    if (confirmPending) return;
    confirmPending = true;
    if (productOptionsAdd instanceof HTMLButtonElement) productOptionsAdd.disabled = true;
    if (editingLineKey) {
      const editedLine = cart.find((item) => lineKey(item) === editingLineKey);
      if (editedLine) {
        editedLine.selectedOptions = selections;
        const duplicate = cart.find((item) => item !== editedLine && lineKey(item) === lineKey(editedLine));
        if (duplicate) { duplicate.quantity += editedLine.quantity; cart = cart.filter((item) => item !== editedLine); }
        saveCart(); renderCart();
        const resultingLine = cart.find((item) => String(item.id) === String(product.id) && lineKey(item) === lineKey({ ...item, selectedOptions: selections }));
        const nextEditButton = Array.from(cartItemsElement?.querySelectorAll('[data-cart-edit]') ?? []).find((element) => element instanceof HTMLButtonElement && element.dataset.cartEdit === (resultingLine ? lineKey(resultingLine) : ''));
        if (nextEditButton instanceof HTMLButtonElement) focusReturnElement = nextEditButton;
      }
      closeProductOptions();
    } else if (addToCart(product.id, selections)) closeProductOptions();
    confirmPending = false;
  });
  document.addEventListener('keydown', (event) => {
    if (!(productOptionsModal instanceof HTMLElement) || productOptionsModal.hidden) return;
    if (event.key === 'Escape') { closeProductOptions(); return; }
    if (event.key === 'Tab') {
      const focusable = Array.from(productOptionsModal.querySelectorAll('button:not([disabled]), input:not([disabled]), [tabindex="0"]')).filter((element) => element instanceof HTMLElement && element.offsetParent !== null);
      const first = focusable[0]; const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
  document.querySelectorAll('[data-cart-toggle]').forEach((button) => button.addEventListener('click', () => setDrawer(!cartUi?.classList.contains('is-open'))));
  document.querySelectorAll('[data-cart-close]').forEach((button) => button.addEventListener('click', () => setDrawer(false)));
  cartDrawer?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('[data-cart-browse]')) setDrawer(false);
  });
  document.addEventListener('keydown', (event) => {
    if (!cartUi?.classList.contains('is-open')) return;
    if (productOptionsModal instanceof HTMLElement && !productOptionsModal.hidden) return;
    if (event.key === 'Escape') { event.preventDefault(); setDrawer(false); return; }
    if (event.key !== 'Tab' || !(cartDrawer instanceof HTMLElement)) return;
    const focusable = Array.from(cartDrawer.querySelectorAll<HTMLElement>('button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex="0"]')).filter((element) => !element.hidden && element.offsetParent !== null);
    if (!focusable.length) { event.preventDefault(); cartDrawer.focus(); return; }
    const first = focusable[0]; const last = focusable[focusable.length - 1];
    if (event.shiftKey && (document.activeElement === first || !cartDrawer.contains(document.activeElement))) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && (document.activeElement === last || !cartDrawer.contains(document.activeElement))) { event.preventDefault(); first.focus(); }
  });
  cartItemsElement?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const removeButton = target?.closest('[data-cart-remove]');
    if (removeButton instanceof HTMLButtonElement) {
      cart = cart.filter((item) => lineKey(item) !== removeButton.dataset.cartRemove);
      saveCart(); renderCart(); return;
    }
    const editButton = target?.closest('[data-cart-edit]');
    if (editButton instanceof HTMLButtonElement) {
      const item = cart.find((entry) => lineKey(entry) === editButton.dataset.cartEdit);
      const product = item ? getProduct(item.id) : null;
      if (item && product) openProductOptions(product, item.selectedOptions, lineKey(item), editButton);
      return;
    }
    const button = (event.target instanceof Element ? event.target.closest('[data-cart-change]') : null);
    if (!(button instanceof HTMLButtonElement)) return;
    const item = cart.find((entry) => lineKey(entry) === button.dataset.cartChange);
    const change = Number(button.dataset.change);
    if (!item || !change) return;
    item.quantity += change;
    cart = cart.filter((entry) => entry.quantity > 0);
    saveCart(); renderCart();
  });
  checkoutButton?.addEventListener('click', () => {
    const hydratedItems = cart.map((item) => ({ ...item, product: getProduct(item.id) })).filter((item) => item.product);
    if (!hydratedItems.length) { renderCart(); return; }
    const invalidItem = hydratedItems.find((item) => getOptionSelectionError(item.product, item.selectedOptions ?? []));
    if (invalidItem) {
      const message = getOptionSelectionError(invalidItem.product, invalidItem.selectedOptions ?? []);
      showCheckoutError(`Revisa ${invalidItem.product.name}: ${message}`);
      const cartLine = lineKey(invalidItem);
      const editControl = cartItemsElement?.querySelector(`[data-cart-edit="${CSS.escape(cartLine)}"]`);
      if (editControl instanceof HTMLButtonElement) editControl.focus();
      return;
    }
    showCheckoutError();
    window.location.assign('/checkout');
  });
  renderCart();
  if (new URLSearchParams(window.location.search).get('cart') === 'open') {
    requestAnimationFrame(() => setDrawer(true));
    const url = new URL(window.location.href);
    url.searchParams.delete('cart');
    window.history.replaceState(null, '', `${url.pathname}${url.hash}`);
  }
  setInterval(renderCart, 60000);
</script>
