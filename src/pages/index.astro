---
import Layout from '../layouts/Layout_index.astro';
import Hero from '../components/hero_index.astro';
import logo from '../assets/pollo_fresa.webp';
import polloAsado from '../assets/asado/asado_1.webp';
import polloCool from '../assets/pollo_cool.webp';
import fresaWingsCool from '../assets/fresa_wings_cool.webp';
import todoPoderoso from '../assets/todo_poderoso.webm';
import wings from '../assets/fresa-wings-alitas.png';
import localPollo from '../assets/local_pollo.webp';
import localFresaWings from '../assets/local_fresa_wings.webp';
import ProductImage from '../components/ProductImage.astro';
import { getCatalog } from '../lib/directus';
const { products: directusProducts, promotions, categories } = await getCatalog();
---
<Layout>
<header class="site-header"><a class="brand" href="#inicio"><img src={logo.src} alt="Pollo Fresa" /></a><button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false">☰</button><nav class="main-nav"><a href="#inicio">Inicio</a><a href="#marcas">Pollo Fresa</a><a href="#marcas">Fresa Wings</a><a href="#promociones">Promociones</a><a href="#ubicacion">Ubicación</a><a href="#contacto">Contacto</a><a class="button button-small" href="#menu">Pedir ahora</a></nav></header>
<Hero />
<main id="inicio">
<section class="status-strip section-wrap" id="estado"><div><p class="eyebrow">Ahora mismo</p><h2>¿Qué se te antoja?</h2></div><div class="status-grid"><article class="status-card pollo-status"><span class="status-dot"></span><div><strong>Pollo Fresa</strong><small>9 AM — 6 PM</small></div><b class="status-label">Consultando…</b></article><article class="status-card wings-status"><span class="status-dot"></span><div><strong>Fresa Wings</strong><small>3 PM — 10 PM</small></div><b class="status-label">Consultando…</b></article></div></section>
<section class="brands section-wrap" id="marcas"><div class="section-heading"><p class="eyebrow">Elige tu mood</p><h2>Dos formas de disfrutar<br /><em>el mismo sabor.</em></h2></div><div class="brand-grid"><article class="brand-card brand-pollo"><div class="card-content"><span class="pill">Clásicos que abrazan</span><h3>Pollo<br /><em>Fresa</em></h3><p>Frito, asado o rostizado. El sabor familiar que siempre se antoja.</p><div class="card-meta"><span>9 AM — 6 PM</span><a href="#menu">Ver menú</a></div></div><div class="brand-card-art"><img src={polloAsado.src} alt="Pollo asado" /></div></article><article class="brand-card brand-wings"><div class="card-content"><span class="pill">Sube el nivel</span><h3>Fresa<br /><em>Wings</em></h3><p>Alitas, boneless y hamburguesas para tu lado más intenso.</p><div class="card-meta"><span>3 PM — 10 PM</span><a href="#menu">Ver menú</a></div></div><div class="brand-card-art"><img src={wings.src} alt="Alitas Fresa Wings" /></div></article></div></section>
{promotions.length > 0 && <section class="storefront-promotions section-wrap" id="promociones"><header class="storefront-promotions-heading"><div><p class="eyebrow">Directo desde la casa</p><h2>Promos que se<br /><em>antojan.</em></h2></div><p>{promotions.length} {promotions.length === 1 ? 'promoción activa' : 'promociones activas'}</p></header><div class="storefront-promotions-grid">{promotions.map((promotion) => { const external = /^https?:\/\//.test(promotion.destination); return <article class="storefront-promotion-card" data-promotion-brand={promotion.brand}><div class="storefront-promotion-image">{promotion.image && <img src={promotion.image} alt={`${promotion.title}, promoción de ${promotion.brand}`} loading="lazy" />}</div><div class="storefront-promotion-copy"><span>{promotion.brand} · {promotion.badge}</span><h3>{promotion.title}</h3><p>{promotion.subtitle}</p>{promotion.price && <strong>{promotion.price}</strong>}{promotion.secondaryText && <b>{promotion.secondaryText}</b>}<a href={promotion.destination} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>{promotion.ctaLabel}</a>{promotion.terms && <small>{promotion.terms}</small>}</div></article>})}</div></section>}
<section class="featured section-wrap" id="destacados"><div class="section-heading split"><div><p class="eyebrow">Para empezar bien</p><h2>Los favoritos<br /><em>de la casa.</em></h2></div><a class="text-link" href="#menu">Ver todo el menú</a></div>{categories.length > 0 ? <div class="catalog-categories">{categories.map((category) => { const categoryProducts = directusProducts.filter((product) => product.categoryId === category.id); return <section class="catalog-category" data-catalog-brand={category.brand}><header><p><small>{category.brand}</small>{category.name}</p><span>{categoryProducts.length} {categoryProducts.length === 1 ? 'producto' : 'productos'}</span></header>{categoryProducts.length > 0 ? <div class="product-grid">{categoryProducts.map((product) => <article class:list={['product-card', product.brand === 'Fresa Wings' ? 'product-wings' : 'product-pollo']} data-product-id={product.id}><ProductImage src={product.image} alt={product.name} class="product-image" /><span class="product-brand">{product.brand} · {category.name}</span><div class="product-info"><div><h3>{product.name}</h3><p>{product.description}</p></div><strong>{product.price}</strong></div><button class="add-button">Agregar <span>+</span></button></article>)}</div> : <p class="category-empty">Próximamente tendremos opciones de {category.name}.</p>}</section>})}</div> : <p class="catalog-empty">El catálogo se está actualizando. Vuelve a intentarlo en unos momentos.</p>}</section>
<section class="location section-wrap" id="ubicacion"><header class="location-heading"><p class="eyebrow">Encuéntranos</p><h2>Ven por tu <em>antojo.</em></h2></header><div class="location-map-panel"><div class="map-placeholder"><iframe id="location-map" title="Mapa de Pollo Fresa en Irapuato" src="https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="location-addresses"><a data-location="pollo" href="https://www.google.com/maps/search/?api=1&query=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>01</span><div><strong>Pollo Fresa</strong><small>Av. Mariano J. García 1254, Los Álamos</small></div></a><a data-location="wings" href="https://www.google.com/maps/search/?api=1&query=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>02</span><div><strong>Fresa Wings</strong><small>Av. Independencia 1811, Miguel Hidalgo</small></div></a></div></div><aside class="location-details"><div class="local-carousel" aria-label="Fotos de los locales"><figure class="local-photo is-active" data-location-photo="pollo"><img src={localPollo.src} alt="Local de Pollo Fresa" /><figcaption>Pollo Fresa</figcaption></figure><figure class="local-photo" data-location-photo="wings"><img src={localFresaWings.src} alt="Local de Fresa Wings" /><figcaption>Fresa Wings</figcaption></figure><div class="carousel-dots" aria-hidden="true"><span class="is-active"></span><span></span></div></div><div class="daily-hours"><p class="eyebrow">Horarios</p><h3>Todos los días</h3><div><p><strong>Pollo Fresa</strong><span>9 AM — 6 PM</span></p><p><strong>Fresa Wings</strong><span>3 PM — 10 PM</span></p></div></div></aside></section>
</main><footer id="contacto"><div class="footer-main"><img src={logo.src} alt="Pollo Fresa" /><p>Dos marcas, un solo lugar<br />para comer delicioso.</p><a class="button button-light" href="#menu">Pedir ahora</a></div><div class="footer-bottom"><span>© 2026 Pollo Fresa</span><nav class="footer-socials" aria-label="Redes sociales"><a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.7.3-1 1-1Z" /></svg></a><a href="#" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4a9 9 0 0 0-14 11L4 20l5-2a9 9 0 0 0 11-14Zm-8 15a7 7 0 0 1-4-1l-3 1 1-3a7 7 0 1 1 6 3Zm4-5c-.2.4-1 .8-1.4.8-.4.1-1 .1-1.6-.2a8 8 0 0 1-3.2-2.8c-.3-.5-.8-1.4-.8-2.1 0-.7.4-1.2.7-1.4.2-.2.5-.2.7-.2h.5c.2 0 .3.1.4.4l.6 1.4c.1.3.1.4-.1.6l-.4.5c-.1.1-.2.2-.1.4.2.4.6 1 1.1 1.4.6.5 1.1.7 1.5.8.2.1.3 0 .4-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.2.2.4Z" /></svg></a><a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="fill" /></svg></a></nav><span>Hecho para compartir.</span></div></footer>
</Layout>
<div class="cart-ui" data-cart-ui>
  <button class="cart-fab" type="button" data-cart-toggle aria-controls="cart-drawer" aria-expanded="false">
    <span class="cart-fab-icon" aria-hidden="true">🛒</span>
    <span>Mi pedido</span>
    <b data-cart-count>0</b>
  </button>
  <div class="cart-backdrop" data-cart-close></div>
  <aside class="cart-drawer" id="cart-drawer" aria-label="Tu pedido" aria-hidden="true">
    <header class="cart-header">
      <div><p>Tu pedido</p><h2>Se antoja <em>mucho.</em></h2></div>
      <button type="button" class="cart-close" data-cart-close aria-label="Cerrar carrito">×</button>
    </header>
    <div class="cart-hours" data-cart-hours></div>
    <div class="cart-items" data-cart-items></div>
    <form class="cart-checkout-form" data-cart-form novalidate hidden>
      <div class="cart-checkout-heading"><span>02</span><div><p>Último paso</p><h3>Entrega y tus datos</h3></div></div>
      <fieldset class="cart-fieldset"><legend>¿Cómo quieres recibirlo? <b>*</b></legend><div class="cart-options"><label><input type="radio" name="order-type" value="pickup" checked /><span><b>Recoger</b><small>En sucursal</small></span></label><label><input type="radio" name="order-type" value="delivery" /><span><b>A domicilio</b><small>A tu dirección</small></span></label></div></fieldset>
      <label class="cart-field cart-pickup-field"><span>Sucursal para recoger <b>*</b></span><select data-pickup-location><option value="Pollo Fresa · Av. Mariano J. García 1254, Los Álamos">Pollo Fresa · Los Álamos</option></select><small data-pickup-help></small></label>
      <label class="cart-field cart-delivery-field" data-delivery-field hidden><span>Dirección de entrega <b>*</b></span><textarea data-delivery-address rows="2" placeholder="Calle, número, colonia y referencias" autocomplete="street-address"></textarea><small>La cobertura y el envío se confirman por WhatsApp.</small></label>
      <label class="cart-field"><span>Nombre <b>*</b></span><input data-customer-name type="text" placeholder="¿A nombre de quién?" autocomplete="name" /></label>
      <label class="cart-field"><span>Teléfono <b>*</b></span><input data-customer-phone type="tel" placeholder="462 000 0000" autocomplete="tel" inputmode="tel" /></label>
      <label class="cart-field"><span>Notas <small>Opcional</small></span><textarea data-customer-notes rows="2" placeholder="Ej. Sin salsa, tocar el timbre, etc."></textarea></label>
      <div class="cart-payment"><span>Forma de pago</span><strong>💵 Efectivo</strong><small>El monto y la disponibilidad se confirman por WhatsApp.</small></div>
      <p class="cart-checkout-error" data-checkout-error role="alert" hidden></p>
    </form>
    <footer class="cart-footer">
      <div class="cart-total"><span>Total</span><strong data-cart-total>$0.00</strong></div>
      <button class="cart-checkout" type="button" data-cart-checkout>Confirmar pedido</button>
      <p class="cart-note" data-cart-note aria-live="polite">Agrega tus favoritos para empezar.</p>
    </footer>
  </aside>
</div>
<div class="theme-switcher" aria-label="Selector de tema para pruebas">
  <button class="theme-switcher-toggle" type="button" aria-expanded="false">Tema <span>⌄</span></button>
  <div class="theme-switcher-menu" role="group" aria-label="Temas disponibles">
    <button type="button" data-theme-choice="auto">Automático</button>
    <button type="button" data-theme-choice="theme-pollo">Pollo Fresa</button>
    <button type="button" data-theme-choice="theme-wings">Fresa Wings</button>
    <button type="button" data-theme-choice="theme-combined">Combinado</button>
  </div>
</div>
<script define:vars={{ polloCoolSrc: polloCool.src, fresaWingsCoolSrc: fresaWingsCool.src, todoPoderosoSrc: todoPoderoso }}>
  const toggle = document.querySelector('.menu-toggle'); const nav = document.querySelector('.main-nav'); toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('is-open') ?? false; toggle.setAttribute('aria-expanded', String(open)); }); document.querySelectorAll('.main-nav a').forEach((link) => link.addEventListener('click', () => nav?.classList.remove('is-open')));
  document.querySelectorAll('.tab').forEach((tab) => tab.addEventListener('click', () => { document.querySelectorAll('.tab').forEach((item) => item.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('[data-menu]').forEach((menu) => menu.classList.toggle('hidden', menu.getAttribute('data-menu') !== tab.getAttribute('data-brand'))); }));
  let selectedTheme = 'auto'; const themeClasses = ['theme-pollo', 'theme-wings', 'theme-combined', 'theme-closed']; const syncCatalogBrand = (theme) => { const brand = theme === 'theme-pollo' ? 'Pollo Fresa' : theme === 'theme-wings' ? 'Fresa Wings' : null; document.querySelectorAll('[data-catalog-brand], [data-promotion-brand]').forEach((section) => { const sectionBrand = section.getAttribute('data-catalog-brand') ?? section.getAttribute('data-promotion-brand'); section.hidden = Boolean(brand && sectionBrand !== brand); }); }; const applyTheme = (theme) => { document.body.classList.remove(...themeClasses); document.body.classList.add(theme); syncCatalogBrand(theme); };
  const updateStatus = () => { const hour = new Date().getHours(); const pollo = hour >= 9 && hour < 18; const wings = hour >= 15 && hour < 22; const automaticTheme = pollo && wings ? 'theme-combined' : pollo ? 'theme-pollo' : wings ? 'theme-wings' : 'theme-closed'; applyTheme(selectedTheme === 'auto' ? automaticTheme : selectedTheme); document.querySelector('.pollo-status')?.classList.toggle('open', pollo); document.querySelector('.wings-status')?.classList.toggle('open', wings); const labels = document.querySelectorAll('.status-label'); if (labels[0]) labels[0].textContent = pollo ? 'Abierto ahora' : hour < 9 ? 'Abre a las 9 AM' : 'Cerrado · abre mañana'; if (labels[1]) labels[1].textContent = wings ? 'Abierto ahora' : hour < 15 ? 'Abre a las 3 PM' : 'Cerrado · abre mañana'; }; updateStatus(); setInterval(updateStatus, 60000);
  const themeToggle = document.querySelector('.theme-switcher-toggle'); const themeMenu = document.querySelector('.theme-switcher-menu'); themeToggle?.addEventListener('click', () => { const open = themeMenu?.classList.toggle('is-open') ?? false; themeToggle.setAttribute('aria-expanded', String(open)); }); document.querySelectorAll('[data-theme-choice]').forEach((choice) => choice.addEventListener('click', () => { selectedTheme = choice.getAttribute('data-theme-choice') ?? 'auto'; updateStatus(); themeMenu?.classList.remove('is-open'); themeToggle?.setAttribute('aria-expanded', 'false'); }));
  const polloCard = document.querySelector('.brand-pollo');
  if (polloCard && !polloCard.querySelector('.pollo-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'pollo-cool-visual'; coolVisual.src = polloCoolSrc; coolVisual.alt = 'Pollo Fresa'; polloCard.append(coolVisual); }
  if (polloCard && !polloCard.querySelector('.promo-fresona')) { const promo = document.createElement('div'); promo.className = 'promo-fresona'; promo.innerHTML = '<p>Promociones</p><h3>Disfruta de nuestras<br><em>promos fresonas.</em></h3><a href="#promociones">Ver promociones</a>'; polloCard.append(promo); }
  const wingsCard = document.querySelector('.brand-wings');
  if (wingsCard && !wingsCard.querySelector('.wings-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'wings-cool-visual'; coolVisual.src = fresaWingsCoolSrc; coolVisual.alt = 'Fresa Wings'; wingsCard.append(coolVisual); }
  if (wingsCard && !wingsCard.querySelector('.promo-wings')) { const promo = document.createElement('div'); promo.className = 'promo-wings'; promo.innerHTML = '<p>Promociones</p><h3>Sube el nivel con<br><em>Fresa Wings.</em></h3><a href="#promociones">Ver promociones</a>'; wingsCard.append(promo); }
  const brandsSection = document.querySelector('.brands');
  if (brandsSection && !brandsSection.querySelector('.combined-video')) { const video = document.createElement('video'); video.className = 'combined-video'; video.src = todoPoderosoSrc; video.autoplay = true; video.muted = true; video.loop = true; video.playsInline = true; video.setAttribute('aria-hidden', 'true'); brandsSection.prepend(video); const powerTitle = document.createElement('div'); powerTitle.className = 'combined-power-title'; powerTitle.innerHTML = '<p>De 3 PM a 6 PM</p><h2>Tienes el poder de <em>pedirlo todo.</em></h2><span>Pollo Fresa y Fresa Wings, juntos en un solo pedido.</span>'; video.insertAdjacentElement('beforebegin', powerTitle); }
</script>
<script>
  const mapUrls = {
    pollo: 'https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed',
    wings: 'https://www.google.com/maps?q=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto.&output=embed',
    combined: 'https://www.google.com/maps?q=Pollo%20Fresa%20Irapuato%20Guanajuato&output=embed',
  };
  let carouselIndex = 0;
  const refreshLocations = () => {
    const mode = document.body.classList.contains('theme-combined') ? 'combined' : document.body.classList.contains('theme-wings') ? 'wings' : 'pollo';
    const map = document.querySelector('#location-map');
    if (map instanceof HTMLIFrameElement && map.getAttribute('src') !== mapUrls[mode]) map.src = mapUrls[mode];
    document.querySelectorAll('[data-location]').forEach((item) => item.classList.toggle('is-visible', mode === 'combined' || item.getAttribute('data-location') === mode));
    const photo = mode === 'combined' ? (carouselIndex % 2 === 0 ? 'pollo' : 'wings') : mode;
    document.querySelectorAll('[data-location-photo]').forEach((item) => item.classList.toggle('is-active', item.getAttribute('data-location-photo') === photo));
    document.querySelectorAll('.carousel-dots span').forEach((dot, index) => dot.classList.toggle('is-active', index === (photo === 'pollo' ? 0 : 1)));
  };
  refreshLocations();
  new MutationObserver(refreshLocations).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  setInterval(() => { if (document.body.classList.contains('theme-combined')) carouselIndex += 1; refreshLocations(); }, 4200);
</script>
<script define:vars={{ cartProducts: directusProducts }}>
  const CART_KEY = 'pollo-fresa-cart-v1';
  const WHATSAPP_NUMBER = '524463869132';
  const schedules = {
    pollo: { label: 'Pollo Fresa', start: 9, end: 18 },
    wings: { label: 'Fresa Wings', start: 15, end: 22 },
  };
  const cartUi = document.querySelector('[data-cart-ui]');
  const cartDrawer = document.querySelector('#cart-drawer');
  const cartItemsElement = document.querySelector('[data-cart-items]');
  const cartHoursElement = document.querySelector('[data-cart-hours]');
  const cartTotalElement = document.querySelector('[data-cart-total]');
  const cartNoteElement = document.querySelector('[data-cart-note]');
  const checkoutButton = document.querySelector('[data-cart-checkout]');
  const cartCountElements = document.querySelectorAll('[data-cart-count]');
  const checkoutForm = document.querySelector('[data-cart-form]');
  const deliveryField = document.querySelector('[data-delivery-field]');
  const deliveryAddress = document.querySelector('[data-delivery-address]');
  const customerName = document.querySelector('[data-customer-name]');
  const customerPhone = document.querySelector('[data-customer-phone]');
  const customerNotes = document.querySelector('[data-customer-notes]');
  const pickupLocation = document.querySelector('[data-pickup-location]');
  const pickupHelp = document.querySelector('[data-pickup-help]');
  const pickupField = document.querySelector('.cart-pickup-field');
  const checkoutError = document.querySelector('[data-checkout-error]');

  const getHour = () => new Date().getHours();
  const isOpen = (brand) => {
    const schedule = schedules[brand] ?? schedules.pollo;
    const hour = getHour();
    return hour >= schedule.start && hour < schedule.end;
  };
  const nextOpening = (brand) => {
    const schedule = schedules[brand] ?? schedules.pollo;
    const hour = getHour();
    return hour < schedule.start ? `Abre a las ${schedule.start > 12 ? schedule.start - 12 : schedule.start} ${schedule.start >= 12 ? 'PM' : 'AM'}` : 'Abre mañana';
  };
  const priceNumber = (price) => Number(String(price).replace(/[^0-9.]/g, '')) || 0;
  const formatPrice = (value) => `$${value.toFixed(2)}`;
  const getProduct = (id) => cartProducts.find((product) => String(product.id) === String(id));
  const getBrandKey = (product) => product?.brand === 'Fresa Wings' ? 'wings' : 'pollo';
  const loadCart = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
      return Array.isArray(saved) ? saved.filter((item) => getProduct(item.id) && item.quantity > 0) : [];
    } catch { return []; }
  };
  let cart = loadCart();
  const saveCart = () => localStorage.setItem(CART_KEY, JSON.stringify(cart));
  const setDrawer = (open) => {
    cartUi?.classList.toggle('is-open', open);
    document.body.classList.toggle('cart-open', open);
    cartDrawer?.setAttribute('aria-hidden', String(!open));
    document.querySelectorAll('[data-cart-toggle]').forEach((button) => button.setAttribute('aria-expanded', String(open)));
  };
  const getOrderType = () => document.querySelector('input[name="order-type"]:checked')?.value ?? 'pickup';
  const syncDeliveryFields = () => {
    const isDelivery = getOrderType() === 'delivery';
    if (deliveryField instanceof HTMLElement) deliveryField.hidden = !isDelivery;
    if (pickupField instanceof HTMLElement) pickupField.hidden = isDelivery;
    if (deliveryAddress instanceof HTMLTextAreaElement) deliveryAddress.required = isDelivery;
  };
  const syncPickupLocation = (items) => {
    if (!(pickupLocation instanceof HTMLSelectElement)) return;
    const brands = new Set(items.map(({ product }) => getBrandKey(product)));
    const hasPollo = brands.has('pollo');
    const hasWings = brands.has('wings');
    if (hasPollo && hasWings) {
      pickupLocation.innerHTML = '<option value="Pedidos separados por marca">Pollo Fresa y Fresa Wings · pedidos separados</option>';
      pickupLocation.disabled = true;
      if (pickupHelp) pickupHelp.textContent = 'Al confirmar, registraremos un pedido para cada marca en su sucursal correspondiente.';
      return;
    }
    if (hasWings) {
      pickupLocation.innerHTML = '<option value="Fresa Wings · Av. Independencia 1811, Miguel Hidalgo">Fresa Wings · Miguel Hidalgo</option>';
      pickupLocation.disabled = true;
      if (pickupHelp) pickupHelp.textContent = 'Tu pedido se registrará en Fresa Wings.';
      return;
    }
    pickupLocation.innerHTML = '<option value="Pollo Fresa · Av. Mariano J. García 1254, Los Álamos">Pollo Fresa · Los Álamos</option>';
    pickupLocation.disabled = true;
    if (pickupHelp) pickupHelp.textContent = hasPollo ? 'Tu pedido se registrará en Pollo Fresa.' : '';
  };
  const showCheckoutError = (message = '') => {
    if (!(checkoutError instanceof HTMLElement)) return;
    checkoutError.textContent = message;
    checkoutError.hidden = !message;
  };

  const renderCart = () => {
    const count = cart.reduce((total, item) => total + item.quantity, 0);
    const hydratedItems = cart.map((item) => ({ ...item, product: getProduct(item.id) })).filter((item) => item.product);
    const total = hydratedItems.reduce((sum, item) => sum + priceNumber(item.product.price) * item.quantity, 0);
    cartCountElements.forEach((element) => { element.textContent = String(count); element.classList.toggle('has-items', count > 0); });
    if (cartTotalElement) cartTotalElement.textContent = formatPrice(total);
    if (cartHoursElement) {
      cartHoursElement.innerHTML = Object.entries(schedules).map(([brand, schedule]) => `<p class="${isOpen(brand) ? 'is-open' : ''}"><span></span><strong>${schedule.label}</strong><small>${isOpen(brand) ? 'Disponible ahora' : nextOpening(brand)}</small></p>`).join('');
    }
    if (cartItemsElement) {
      cartItemsElement.innerHTML = hydratedItems.length ? hydratedItems.map(({ id, quantity, product }) => {
        const brand = getBrandKey(product);
        const available = isOpen(brand);
        return `<article class="cart-item ${available ? '' : 'is-closed'}"><div><small>${schedules[brand].label}</small><h3>${product.name}</h3><b>${product.price}</b>${available ? '' : `<em>${nextOpening(brand)}</em>`}</div><div class="cart-quantity"><button type="button" data-cart-change="${id}" data-change="-1" aria-label="Quitar una unidad">−</button><span>${quantity}</span><button type="button" data-cart-change="${id}" data-change="1" aria-label="Agregar una unidad" ${available ? '' : 'disabled'}>+</button></div></article>`;
      }).join('') : '<p class="cart-empty">Tu carrito está esperando algo delicioso.</p>';
    }
    const closedItem = hydratedItems.find(({ product }) => !isOpen(getBrandKey(product)));
    const canCheckout = hydratedItems.length > 0 && !closedItem;
    syncPickupLocation(hydratedItems);
    if (checkoutForm instanceof HTMLElement) checkoutForm.hidden = !hydratedItems.length;
    if (checkoutButton instanceof HTMLButtonElement) checkoutButton.disabled = !canCheckout;
    if (cartNoteElement) cartNoteElement.textContent = !hydratedItems.length ? 'Agrega tus favoritos para empezar.' : closedItem ? `${schedules[getBrandKey(closedItem.product)].label} está cerrado. ${nextOpening(getBrandKey(closedItem.product))}.` : 'Tu pedido se registrará directamente con cada marca.';
  };

  const addToCart = (productId) => {
    const product = getProduct(productId);
    if (!product) return false;
    const brand = getBrandKey(product);
    if (!isOpen(brand)) {
      setDrawer(true);
      if (cartNoteElement) cartNoteElement.textContent = `Aún no podemos tomar pedidos de ${schedules[brand].label}. ${nextOpening(brand)}.`;
      renderCart();
      return false;
    }
    const existing = cart.find((item) => String(item.id) === String(product.id));
    if (existing) existing.quantity += 1;
    else cart.push({ id: product.id, quantity: 1 });
    saveCart();
    renderCart();
    setDrawer(true);
    return true;
  };

  const addButtonTimers = new WeakMap();
  const celebrateAdd = (button, card) => {
    const quantity = cart.find((item) => String(item.id) === button.dataset.addProduct)?.quantity ?? 1;
    window.clearTimeout(addButtonTimers.get(button));
    button.classList.add('is-added');
    card.classList.remove('is-adding');
    void card.offsetWidth;
    card.classList.add('is-adding');
    button.innerHTML = `<span class="add-button-label">Agregado</span><span>✓</span>`;
    const cartButton = document.querySelector('.cart-fab');
    const start = button.getBoundingClientRect();
    const target = cartButton?.getBoundingClientRect();
    if (target) {
      const chip = document.createElement('span');
      chip.className = 'cart-fly-chip';
      chip.textContent = `+${quantity}`;
      chip.style.left = `${start.right - 25}px`;
      chip.style.top = `${start.top + start.height / 2}px`;
      document.body.append(chip);
      requestAnimationFrame(() => {
        chip.style.transform = `translate(${target.left - start.right + 34}px, ${target.top - start.top - start.height / 2 + 20}px) scale(.35)`;
        chip.style.opacity = '0';
      });
      window.setTimeout(() => chip.remove(), 520);
      cartButton.classList.remove('is-pulsing');
      void cartButton.offsetWidth;
      cartButton.classList.add('is-pulsing');
    }
    const timer = window.setTimeout(() => {
      button.classList.remove('is-added');
      button.innerHTML = `<span class="add-button-label">Agregar otro</span><span>+</span>`;
    }, 1050);
    addButtonTimers.set(button, timer);
  };

  document.querySelectorAll('.product-card').forEach((card) => {
    const product = getProduct(card.getAttribute('data-product-id'));
    const button = card.querySelector('.add-button');
    if (!(button instanceof HTMLButtonElement) || !product) return;
    button.type = 'button';
    button.innerHTML = '<span class="add-button-label">Agregar</span><span>+</span>';
    button.dataset.addProduct = String(product.id);
    button.setAttribute('aria-label', `Agregar ${product.name} al pedido`);
    button.addEventListener('click', () => { if (addToCart(product.id)) celebrateAdd(button, card); });
  });
  document.querySelectorAll('[data-cart-toggle]').forEach((button) => button.addEventListener('click', () => setDrawer(!cartUi?.classList.contains('is-open'))));
  document.querySelectorAll('[data-cart-close]').forEach((button) => button.addEventListener('click', () => setDrawer(false)));
  document.querySelectorAll('input[name="order-type"]').forEach((input) => input.addEventListener('change', () => { showCheckoutError(); syncDeliveryFields(); }));
  cartItemsElement?.addEventListener('click', (event) => {
    const button = (event.target instanceof Element ? event.target.closest('[data-cart-change]') : null);
    if (!(button instanceof HTMLButtonElement)) return;
    const item = cart.find((entry) => String(entry.id) === button.dataset.cartChange);
    const change = Number(button.dataset.change);
    if (!item || !change || (change > 0 && !isOpen(getBrandKey(getProduct(item.id))))) return;
    item.quantity += change;
    cart = cart.filter((entry) => entry.quantity > 0);
    saveCart(); renderCart();
  });
  checkoutButton?.addEventListener('click', async () => {
    const hydratedItems = cart.map((item) => ({ ...item, product: getProduct(item.id) })).filter((item) => item.product);
    if (!hydratedItems.length || hydratedItems.some(({ product }) => !isOpen(getBrandKey(product)))) { renderCart(); return; }
    const name = customerName instanceof HTMLInputElement ? customerName.value.trim() : '';
    const phone = customerPhone instanceof HTMLInputElement ? customerPhone.value.trim() : '';
    const notes = customerNotes instanceof HTMLTextAreaElement ? customerNotes.value.trim() : '';
    const orderType = getOrderType();
    const address = deliveryAddress instanceof HTMLTextAreaElement ? deliveryAddress.value.trim() : '';
    const location = pickupLocation instanceof HTMLSelectElement ? pickupLocation.value : 'Pollo Fresa';
    if (!name) { showCheckoutError('Escribe el nombre de quien recibirá el pedido.'); customerName?.focus(); return; }
    if (!phone) { showCheckoutError('Escribe un teléfono de contacto.'); customerPhone?.focus(); return; }
    if (orderType === 'delivery' && !address) { showCheckoutError('Escribe la dirección para el pedido a domicilio.'); deliveryAddress?.focus(); return; }
    showCheckoutError();
    if (!(checkoutButton instanceof HTMLButtonElement)) return;
    const originalLabel = checkoutButton.innerHTML;
    checkoutButton.disabled = true;
    checkoutButton.textContent = 'Registrando pedido…';
    try {
      const result = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.map((item) => ({ id: item.id, quantity: item.quantity })),
          customer: { name, phone, notes },
          fulfillment: { type: orderType, address, pickupLocation: location },
        }),
      });
      const payload = await result.json();
      if (!result.ok || !payload.success || !Array.isArray(payload.orders) || !payload.orders.length) throw new Error(payload.error || 'No se pudo registrar el pedido.');
      cart = [];
      saveCart();
      if (checkoutForm instanceof HTMLFormElement) checkoutForm.reset();
      syncDeliveryFields();
      renderCart();
      const orderSummary = payload.orders.map((order) => `${order.brand} #${order.id}`).join(' y ');
      if (cartNoteElement) cartNoteElement.textContent = `¡Listo! Registramos ${orderSummary}. Te confirmaremos disponibilidad en breve.`;
      checkoutButton.innerHTML = payload.orders.length > 1 ? 'Pedidos registrados <span>✓</span>' : 'Pedido registrado <span>✓</span>';
    } catch (error) {
      showCheckoutError(error instanceof Error ? error.message : 'No pudimos registrar tu pedido. Intenta de nuevo.');
      checkoutButton.innerHTML = originalLabel;
      renderCart();
    }
    return;
    const lines = hydratedItems.map(({ product, quantity }) => `• ${quantity} x ${product.name} — ${formatPrice(priceNumber(product.price) * quantity)}`);
    const total = hydratedItems.reduce((sum, { product, quantity }) => sum + priceNumber(product.price) * quantity, 0);
    const fulfillment = orderType === 'delivery' ? ['📍 *Modalidad:* A domicilio', `*Dirección:* ${address}`] : ['🏪 *Modalidad:* Recoger en sucursal', `*Sucursal:* ${location}`];
    const orderMessage = ['Hola, quiero hacer este pedido:', '', ...lines, '', `*Total:* ${formatPrice(total)}`, '', ...fulfillment, '💵 *Pago:* Efectivo', `👤 *Cliente:* ${name}`, `📞 *Teléfono:* ${phone}`, ...(notes ? [`📝 *Notas:* ${notes}`] : []), '', '¿Me ayudan a confirmar disponibilidad y tiempo de entrega?'].join('\n');
    const message = ['Hola, quiero hacer este pedido:', '', ...lines, '', `Total: ${formatPrice(total)}`, '', '¿Me ayudan a confirmar disponibilidad y tiempo de entrega?'].join('\n');
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(orderMessage)}`, '_blank', 'noopener');
  });
  syncDeliveryFields();
  renderCart();
  setInterval(renderCart, 60000);
</script>
