---
import Layout from '../layouts/Layout_index.astro';
import Hero from '../components/hero_index.astro';
import logo from '../assets/pollo_fresa.webp';
import polloAsado from '../assets/asado/asado_1.webp';
import polloCool from '../assets/pollo_cool.webp';
import fresaWingsCool from '../assets/fresa_wings_cool.webp';
import todoPoderoso from '../assets/todo_poderoso.webm';
import wings from '../assets/fresa-wings-alitas.png';
import localPollo from '../assets/local_pollo.webp';
import localFresaWings from '../assets/local_fresa_wings.webp';
import ProductImage from '../components/ProductImage.astro';
import { getCatalog } from '../lib/directus';
const { products: directusProducts, promotions } = await getCatalog();
---
<Layout>
<header class="site-header"><a class="brand" href="#inicio"><img src={logo.src} alt="Pollo Fresa" /></a><button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false">☰</button><nav class="main-nav"><a href="#inicio">Inicio</a><a href="#marcas">Pollo Fresa</a><a href="#marcas">Fresa Wings</a><a href="#promociones">Promociones</a><a href="#ubicacion">Ubicación</a><a href="#contacto">Contacto</a><a class="button button-small" href="#menu">Pedir ahora <span>↗</span></a></nav></header>
<Hero />
<main id="inicio">
<section class="status-strip section-wrap" id="estado"><div><p class="eyebrow">Ahora mismo</p><h2>¿Qué se te antoja?</h2></div><div class="status-grid"><article class="status-card pollo-status"><span class="status-dot"></span><div><strong>Pollo Fresa</strong><small>9 AM — 6 PM</small></div><b class="status-label">Consultando…</b></article><article class="status-card wings-status"><span class="status-dot"></span><div><strong>Fresa Wings</strong><small>3 PM — 10 PM</small></div><b class="status-label">Consultando…</b></article></div></section>
<section class="brands section-wrap" id="marcas"><div class="section-heading"><p class="eyebrow">Elige tu mood</p><h2>Dos formas de disfrutar<br /><em>el mismo sabor.</em></h2></div><div class="brand-grid"><article class="brand-card brand-pollo"><div class="card-content"><span class="pill">Clásicos que abrazan</span><h3>Pollo<br /><em>Fresa</em></h3><p>Frito, asado o rostizado. El sabor familiar que siempre se antoja.</p><div class="card-meta"><span>9 AM — 6 PM</span><a href="#menu">Ver menú <b>↗</b></a></div></div><div class="brand-card-art"><img src={polloAsado.src} alt="Pollo asado" /></div></article><article class="brand-card brand-wings"><div class="card-content"><span class="pill">Sube el nivel</span><h3>Fresa<br /><em>Wings</em></h3><p>Alitas, boneless y hamburguesas para tu lado más intenso.</p><div class="card-meta"><span>3 PM — 10 PM</span><a href="#menu">Ver menú <b>↗</b></a></div></div><div class="brand-card-art"><img src={wings.src} alt="Alitas Fresa Wings" /></div></article></div></section>
<section class="overlap section-wrap" id="ambos"><div><p class="eyebrow">El favorito de la casa</p><h2>Pollo Fresa,<br /><em>hecho para compartir.</em></h2><p>Pollo frito, asado o rostizado con el sabor que reúne a todos alrededor de la mesa.</p><a class="button button-light" href="#menu">Ver menú de Pollo Fresa <span>↗</span></a></div></section>
{promotions.length > 0 && <section class="promotions section-wrap" id="promociones"><div class="section-heading"><p class="eyebrow">Algo bueno está pasando</p><h2>Promos para <em>compartir.</em></h2></div><div class="promo-grid">{promotions.map((promotion) => <article><span>{promotion.category}</span><h3>{promotion.name}</h3><p>{promotion.description}</p><a href="#destacados">Ver promoción ↗</a></article>)}</div></section>}
<section class="featured section-wrap" id="destacados"><div class="section-heading split"><div><p class="eyebrow">Para empezar bien</p><h2>Los favoritos<br /><em>de la casa.</em></h2></div><a class="text-link" href="#menu">Ver todo el menú <span>→</span></a></div><div class="product-grid">{directusProducts.length > 0 ? directusProducts.map((product) => <article class="product-card product-pollo"><ProductImage src={product.image} alt={product.name} class="product-image" /><span class="product-brand">{product.category}</span><div class="product-info"><div><h3>{product.name}</h3><p>{product.description}</p></div><strong>{product.price}</strong></div><button class="add-button">Agregar <span>+</span></button></article>) : <p class="catalog-empty">El catálogo se está actualizando. Vuelve a intentarlo en unos momentos.</p>}</div></section>
<section class="location section-wrap" id="ubicacion"><header class="location-heading"><p class="eyebrow">Encuéntranos</p><h2>Ven por tu <em>antojo.</em></h2></header><div class="location-map-panel"><div class="map-placeholder"><iframe id="location-map" title="Mapa de Pollo Fresa en Irapuato" src="https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div><div class="location-addresses"><a data-location="pollo" href="https://www.google.com/maps/search/?api=1&query=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>01</span><div><strong>Pollo Fresa</strong><small>Av. Mariano J. García 1254, Los Álamos</small></div><b>↗</b></a><a data-location="wings" href="https://www.google.com/maps/search/?api=1&query=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto." target="_blank" rel="noopener"><span>02</span><div><strong>Fresa Wings</strong><small>Av. Independencia 1811, Miguel Hidalgo</small></div><b>↗</b></a></div></div><aside class="location-details"><div class="local-carousel" aria-label="Fotos de los locales"><figure class="local-photo is-active" data-location-photo="pollo"><img src={localPollo.src} alt="Local de Pollo Fresa" /><figcaption>Pollo Fresa</figcaption></figure><figure class="local-photo" data-location-photo="wings"><img src={localFresaWings.src} alt="Local de Fresa Wings" /><figcaption>Fresa Wings</figcaption></figure><div class="carousel-dots" aria-hidden="true"><span class="is-active"></span><span></span></div></div><div class="daily-hours"><p class="eyebrow">Horarios</p><h3>Todos los días</h3><div><p><strong>Pollo Fresa</strong><span>9 AM — 6 PM</span></p><p><strong>Fresa Wings</strong><span>3 PM — 10 PM</span></p></div></div></aside></section>
</main><footer id="contacto"><div class="footer-main"><img src={logo.src} alt="Pollo Fresa" /><p>Dos marcas, un solo lugar<br />para comer delicioso.</p><a class="button button-light" href="#menu">Pedir ahora <span>↗</span></a></div><div class="footer-bottom"><span>© 2026 Pollo Fresa</span><nav class="footer-socials" aria-label="Redes sociales"><a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.7.3-1 1-1Z" /></svg></a><a href="#" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4a9 9 0 0 0-14 11L4 20l5-2a9 9 0 0 0 11-14Zm-8 15a7 7 0 0 1-4-1l-3 1 1-3a7 7 0 1 1 6 3Zm4-5c-.2.4-1 .8-1.4.8-.4.1-1 .1-1.6-.2a8 8 0 0 1-3.2-2.8c-.3-.5-.8-1.4-.8-2.1 0-.7.4-1.2.7-1.4.2-.2.5-.2.7-.2h.5c.2 0 .3.1.4.4l.6 1.4c.1.3.1.4-.1.6l-.4.5c-.1.1-.2.2-.1.4.2.4.6 1 1.1 1.4.6.5 1.1.7 1.5.8.2.1.3 0 .4-.1l.5-.6c.2-.2.3-.2.6-.1l1.4.7c.3.1.4.2.2.4Z" /></svg></a><a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" class="fill" /></svg></a></nav><span>Hecho para compartir.</span></div></footer>
</Layout>
<div class="theme-switcher" aria-label="Selector de tema para pruebas">
  <button class="theme-switcher-toggle" type="button" aria-expanded="false">Tema <span>⌄</span></button>
  <div class="theme-switcher-menu" role="group" aria-label="Temas disponibles">
    <button type="button" data-theme-choice="auto">Automático</button>
    <button type="button" data-theme-choice="theme-pollo">Pollo Fresa</button>
    <button type="button" data-theme-choice="theme-wings">Fresa Wings</button>
    <button type="button" data-theme-choice="theme-combined">Combinado</button>
  </div>
</div>
<script define:vars={{ polloCoolSrc: polloCool.src, fresaWingsCoolSrc: fresaWingsCool.src, todoPoderosoSrc: todoPoderoso }}>
  const toggle = document.querySelector('.menu-toggle'); const nav = document.querySelector('.main-nav'); toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('is-open') ?? false; toggle.setAttribute('aria-expanded', String(open)); }); document.querySelectorAll('.main-nav a').forEach((link) => link.addEventListener('click', () => nav?.classList.remove('is-open')));
  document.querySelectorAll('.tab').forEach((tab) => tab.addEventListener('click', () => { document.querySelectorAll('.tab').forEach((item) => item.classList.remove('active')); tab.classList.add('active'); document.querySelectorAll('[data-menu]').forEach((menu) => menu.classList.toggle('hidden', menu.getAttribute('data-menu') !== tab.getAttribute('data-brand'))); }));
  let selectedTheme = 'auto'; const themeClasses = ['theme-pollo', 'theme-wings', 'theme-combined', 'theme-closed']; const applyTheme = (theme) => { document.body.classList.remove(...themeClasses); document.body.classList.add(theme); };
  const updateStatus = () => { const hour = new Date().getHours(); const pollo = hour >= 9 && hour < 18; const wings = hour >= 15 && hour < 22; const automaticTheme = pollo && wings ? 'theme-combined' : pollo ? 'theme-pollo' : wings ? 'theme-wings' : 'theme-closed'; applyTheme(selectedTheme === 'auto' ? automaticTheme : selectedTheme); document.querySelector('.pollo-status')?.classList.toggle('open', pollo); document.querySelector('.wings-status')?.classList.toggle('open', wings); const labels = document.querySelectorAll('.status-label'); if (labels[0]) labels[0].textContent = pollo ? 'Abierto ahora' : hour < 9 ? 'Abre a las 9 AM' : 'Cerrado · abre mañana'; if (labels[1]) labels[1].textContent = wings ? 'Abierto ahora' : hour < 15 ? 'Abre a las 3 PM' : 'Cerrado · abre mañana'; }; updateStatus(); setInterval(updateStatus, 60000);
  const themeToggle = document.querySelector('.theme-switcher-toggle'); const themeMenu = document.querySelector('.theme-switcher-menu'); themeToggle?.addEventListener('click', () => { const open = themeMenu?.classList.toggle('is-open') ?? false; themeToggle.setAttribute('aria-expanded', String(open)); }); document.querySelectorAll('[data-theme-choice]').forEach((choice) => choice.addEventListener('click', () => { selectedTheme = choice.getAttribute('data-theme-choice') ?? 'auto'; updateStatus(); themeMenu?.classList.remove('is-open'); themeToggle?.setAttribute('aria-expanded', 'false'); }));
  const polloCard = document.querySelector('.brand-pollo');
  if (polloCard && !polloCard.querySelector('.pollo-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'pollo-cool-visual'; coolVisual.src = polloCoolSrc; coolVisual.alt = 'Pollo Fresa'; polloCard.append(coolVisual); }
  if (polloCard && !polloCard.querySelector('.promo-fresona')) { const promo = document.createElement('div'); promo.className = 'promo-fresona'; promo.innerHTML = '<p>Promociones</p><h3>Disfruta de nuestras<br><em>promos fresonas.</em></h3><a href="#promociones">Ver promociones <span>↗</span></a>'; polloCard.append(promo); }
  const wingsCard = document.querySelector('.brand-wings');
  if (wingsCard && !wingsCard.querySelector('.wings-cool-visual')) { const coolVisual = document.createElement('img'); coolVisual.className = 'wings-cool-visual'; coolVisual.src = fresaWingsCoolSrc; coolVisual.alt = 'Fresa Wings'; wingsCard.append(coolVisual); }
  if (wingsCard && !wingsCard.querySelector('.promo-wings')) { const promo = document.createElement('div'); promo.className = 'promo-wings'; promo.innerHTML = '<p>Promociones</p><h3>Sube el nivel con<br><em>Fresa Wings.</em></h3><a href="#promociones">Ver promociones <span>↗</span></a>'; wingsCard.append(promo); }
  const brandsSection = document.querySelector('.brands');
  if (brandsSection && !brandsSection.querySelector('.combined-video')) { const video = document.createElement('video'); video.className = 'combined-video'; video.src = todoPoderosoSrc; video.autoplay = true; video.muted = true; video.loop = true; video.playsInline = true; video.setAttribute('aria-hidden', 'true'); brandsSection.prepend(video); const powerTitle = document.createElement('div'); powerTitle.className = 'combined-power-title'; powerTitle.innerHTML = '<p>De 3 PM a 6 PM</p><h2>Tienes el poder de <em>pedirlo todo.</em></h2><span>Pollo Fresa y Fresa Wings, juntos en un solo pedido.</span>'; video.insertAdjacentElement('beforebegin', powerTitle); }
</script>
<script>
  const mapUrls = {
    pollo: 'https://www.google.com/maps?q=Av%20Mariano%20J.%20Garc%C3%ADa%201254%2C%20Los%20Alamos%2C%2036568%20Irapuato%2C%20Gto.&output=embed',
    wings: 'https://www.google.com/maps?q=Av%20Independencia%201811%2C%20Miguel%20Hidalgo%2C%2036550%20Irapuato%2C%20Gto.&output=embed',
    combined: 'https://www.google.com/maps?q=Pollo%20Fresa%20Irapuato%20Guanajuato&output=embed',
  };
  let carouselIndex = 0;
  const refreshLocations = () => {
    const mode = document.body.classList.contains('theme-combined') ? 'combined' : document.body.classList.contains('theme-wings') ? 'wings' : 'pollo';
    const map = document.querySelector('#location-map');
    if (map instanceof HTMLIFrameElement && map.getAttribute('src') !== mapUrls[mode]) map.src = mapUrls[mode];
    document.querySelectorAll('[data-location]').forEach((item) => item.classList.toggle('is-visible', mode === 'combined' || item.getAttribute('data-location') === mode));
    const photo = mode === 'combined' ? (carouselIndex % 2 === 0 ? 'pollo' : 'wings') : mode;
    document.querySelectorAll('[data-location-photo]').forEach((item) => item.classList.toggle('is-active', item.getAttribute('data-location-photo') === photo));
    document.querySelectorAll('.carousel-dots span').forEach((dot, index) => dot.classList.toggle('is-active', index === (photo === 'pollo' ? 0 : 1)));
  };
  refreshLocations();
  new MutationObserver(refreshLocations).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  setInterval(() => { if (document.body.classList.contains('theme-combined')) carouselIndex += 1; refreshLocations(); }, 4200);
</script>
<style is:global>
  .pollo-cool-visual { display:none; }
  .promo-fresona { display:none; }
  .wings-cool-visual, .promo-wings { display:none; }
  .combined-video { display:none; }
  .combined-power-title { display:none; }
  body.theme-pollo .brands .section-heading { display:none; }
  body.theme-pollo .status-strip { margin-bottom:0; }
  body.theme-pollo .brands { margin-top:0; margin-bottom:0; }
  body.theme-pollo .brand-pollo { overflow: visible; }
  body.theme-pollo .brand-pollo .brand-card-art { display: none; }
  body.theme-pollo .brand-pollo { min-height:470px; background:transparent; box-shadow:none; border:0; border-radius:0; }
  body.theme-pollo .brand-pollo .card-content { display:none; }
  body.theme-pollo .brand-pollo .promo-fresona { position:absolute; z-index:4; top:50%; right:9%; display:block; width:40%; transform:translateY(-48%); }
  body.theme-pollo .promo-fresona p { margin:0 0 13px; color:#e7472c; font-size:.67rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  body.theme-pollo .promo-fresona h3 { margin:0; color:#3b201a; font-family:var(--display); font-size:clamp(2.6rem,4vw,4.5rem); line-height:.9; }
  body.theme-pollo .promo-fresona h3 em { color:#e7472c; font-style:normal; }
  body.theme-pollo .promo-fresona a { display:inline-flex; align-items:center; gap:11px; margin-top:24px; padding:12px 17px; border-radius:99px; color:#fff; background:#e7472c; font-size:.72rem; font-weight:800; text-decoration:none; box-shadow:0 8px 18px #e7472c33; }
  body.theme-pollo .overlap { display:block; padding:38px 30px; text-align:center; }
  body.theme-pollo .overlap > div:first-child { max-width:760px; margin-inline:auto; }
  body.theme-pollo .overlap p:not(.eyebrow) { margin-inline:auto; }
  body.theme-wings .brands .section-heading { display:none; }
  body.theme-wings .status-strip { margin-bottom:0; }
  body.theme-wings .brands { margin-top:0; margin-bottom:0; }
  body.theme-wings .brand-wings { min-height:470px; overflow:visible; background:transparent; box-shadow:none; border:0; border-radius:0; }
  body.theme-wings .brand-wings .brand-card-art, body.theme-wings .brand-wings .card-content { display:none; }
  body.theme-wings .brand-wings::before { content:''; position:absolute; z-index:1; right:8%; bottom:7%; width:370px; height:370px; border-radius:50%; background:radial-gradient(circle at 30% 26%,#f35a40 0 4%,transparent 5%),linear-gradient(145deg,#e9422b,#941a1b); }
  body.theme-wings .brand-wings::after { display:none; }
  body.theme-wings .brand-wings .wings-cool-visual { position:absolute; z-index:3; right:5%; bottom:0; display:block; width:45%; height:104%; object-fit:contain; object-position:right bottom; transform:scale(1.2); transform-origin:center bottom; filter:drop-shadow(8px 14px 12px #05030388); pointer-events:none; }
  body.theme-wings .brand-wings .promo-wings { position:absolute; z-index:4; top:50%; left:9%; display:block; width:40%; transform:translateY(-48%); }
  body.theme-wings .promo-wings p { margin:0 0 13px; color:#f55539; font-size:.67rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
  body.theme-wings .promo-wings h3 { margin:0; color:#fff8ed; font-family:var(--display); font-size:clamp(2.6rem,4vw,4.5rem); line-height:.9; }
  body.theme-wings .promo-wings h3 em { color:#f15137; font-style:normal; }
  body.theme-wings .promo-wings a { display:inline-flex; align-items:center; gap:11px; margin-top:24px; padding:12px 17px; border-radius:99px; color:#201313; background:#fff8ed; font-size:.72rem; font-weight:800; text-decoration:none; box-shadow:0 8px 18px #0005; }
  body.theme-combined .status-strip { margin-bottom:0; }
  body.theme-combined .brands { position:relative; width:100vw; max-width:none; margin:0 0 72px calc(50% - 50vw); padding:0; overflow:visible; }
  body.theme-combined .combined-video { position:relative; z-index:1; display:block; width:100%; height:380px; margin:0 0 58px; border-radius:0; object-fit:cover; filter:brightness(.82) saturate(1.1); box-shadow:none; }
  body.theme-combined .combined-power-title { position:relative; z-index:2; display:block; width:100%; margin:0; padding:30px max(24px,calc((100vw - 1040px)/2)); overflow:hidden; text-align:center; color:#fff8ed; background:linear-gradient(100deg,#21110f 0%,#552018 48%,#28110e 100%); border-bottom:4px solid #e7472c; }
  body.theme-combined .combined-power-title::before, body.theme-combined .combined-power-title::after { content:'✦'; position:absolute; top:50%; color:#ffc84b; font-size:2rem; opacity:.65; transform:translateY(-50%); }
  body.theme-combined .combined-power-title::before { left:8%; }
  body.theme-combined .combined-power-title::after { right:8%; }
  body.theme-combined .combined-power-title p { margin:0 0 8px; color:#ffc84b; font-size:.68rem; font-weight:800; letter-spacing:.2em; text-transform:uppercase; }
  body.theme-combined .combined-power-title h2 { margin:0; color:#fff8ed; font-family:var(--display); font-size:clamp(2.5rem,4.6vw,4.8rem); line-height:.9; }
  body.theme-combined .combined-power-title h2 em { color:#ff6748; font-style:normal; }
  body.theme-combined .combined-power-title span { display:block; margin-top:12px; color:#ffe8d5c9; font-size:.82rem; }
  body.theme-combined .brands::before { display:none; }
  body.theme-combined .brands > :not(.combined-video) { position:relative; z-index:2; }
  body.theme-combined .brands .section-heading { width:min(1200px,calc(100% - 48px)); margin-inline:auto; }
  body.theme-combined .brand-grid { width:min(1200px,calc(100% - 48px)); margin-inline:auto; }
  body.theme-pollo .brand-pollo::before { content:''; position:absolute; z-index:1; display:block; left:7%; bottom:4%; width:410px; height:410px; border-radius:50%; background:#ffd151; }
  body.theme-pollo .brand-pollo::after { display:none; }
  body.theme-pollo .brand-pollo .pollo-cool-visual { position:absolute; z-index:3; left:7%; bottom:0; display:block; width:47%; height:112%; object-fit:contain; object-position:left bottom; clip-path:none; transform:scale(1.49); transform-origin:center bottom; filter:drop-shadow(8px 14px 12px #5a241d2d); pointer-events:none; }
  @media (max-width: 800px) {
    body.theme-pollo .status-strip { margin-bottom:0; }
    body.theme-pollo .brands { margin-bottom:0; }
    body.theme-pollo .brand-pollo { min-height:365px; }
    body.theme-pollo .brand-pollo::before { left:3%; bottom:4%; width:300px; height:300px; }
    body.theme-pollo .brand-pollo .pollo-cool-visual { left:1%; width:78%; height:112%; transform:scale(1.25); }
    body.theme-pollo .brand-pollo .promo-fresona { top:auto; right:7%; bottom:12%; width:43%; transform:none; }
    body.theme-pollo .promo-fresona h3 { font-size:clamp(1.9rem,8vw,2.8rem); }
    body.theme-pollo .overlap { padding:32px 22px; }
    body.theme-wings .brands { margin-bottom:0; }
    body.theme-wings .brand-wings { min-height:365px; }
    body.theme-wings .brand-wings::before { right:3%; bottom:4%; width:270px; height:270px; }
    body.theme-wings .brand-wings .wings-cool-visual { right:1%; width:78%; height:104%; transform:scale(1.08); }
    body.theme-wings .brand-wings .promo-wings { top:auto; left:7%; bottom:12%; width:43%; transform:none; }
    body.theme-wings .promo-wings h3 { font-size:clamp(1.9rem,8vw,2.8rem); }
    body.theme-combined .brands { width:100vw; margin:0 0 48px calc(50% - 50vw); }
    body.theme-combined .combined-video { height:230px; margin-bottom:38px; border-radius:0; }
    body.theme-combined .combined-power-title { width:100%; margin:0; padding:24px 34px; }
    body.theme-combined .combined-power-title::before, body.theme-combined .combined-power-title::after { display:none; }
    body.theme-combined .combined-power-title span { font-size:.78rem; }
    body.theme-combined .brands .section-heading, body.theme-combined .brand-grid { width:calc(100% - 32px); }
  }
</style>
