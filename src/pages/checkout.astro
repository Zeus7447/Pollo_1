---
import CheckoutLayout from '../layouts/CheckoutLayout.astro';
import { getCatalog } from '../lib/directus';

const { products, catalogError } = await getCatalog();
---

<CheckoutLayout title="Finalizar pedido | Pollo Fresa y Fresa Wings">
  <main class="checkout-page" data-checkout-page data-current-step="2">
    <header class="checkout-header">
      <a class="checkout-back" href="/?cart=open#inicio" aria-label="Regresar al carrito">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
        <span>Volver al carrito</span>
      </a>
      <a class="checkout-logo" href="/" aria-label="Pollo Fresa, volver al menú"><span>POLLO FRESA <i>×</i> FRESA WINGS</span></a>
      <span class="checkout-channel">Pedido por WhatsApp</span>
    </header>

    <div class="checkout-shell">
      <div class="checkout-intro">
        <p class="checkout-eyebrow" data-checkout-eyebrow>PASO 2 DE 3 · ENTREGA Y DATOS</p>
        <h1 data-checkout-title>¿Cómo recibes tu pedido?</h1>
        <p data-checkout-copy>Elige cómo recibirlo y déjanos tus datos de contacto.</p>
      </div>

      <ol class="checkout-steps" aria-label="Etapas del pedido">
        <li class="is-complete" data-step-indicator="1"><span>01</span><b>Carrito</b></li>
        <li class="is-current" aria-current="step" data-step-indicator="2"><span>02</span><b>Entrega y datos</b></li>
        <li data-step-indicator="3"><span>03</span><b>Revisión</b></li>
      </ol>

      <section class="checkout-empty" data-checkout-empty role="status">
        <p class="checkout-eyebrow">Tu pedido</p>
        <h2 data-empty-title>Estamos preparando tu resumen…</h2>
        <p data-empty-copy>El carrito se conserva en este dispositivo.</p>
        <a href="/#pollo-menu">Volver al menú <span aria-hidden="true">→</span></a>
      </section>

      <div class="checkout-layout" data-checkout-content hidden>
        <form class="checkout-form" data-checkout-form>
          <section class="checkout-panel" data-step-panel="2" aria-labelledby="fulfillment-title">
            <fieldset class="fulfillment-choice">
              <legend id="fulfillment-title">Forma de entrega <b>*</b></legend>
              <div class="fulfillment-options">
                <label><input type="radio" name="checkout-fulfillment" value="pickup" checked /><span class="fulfillment-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10h18l-1.5 10h-15L3 10Zm2-6h14l2 6H3l2-6Zm4 10v3m6-3v3" /></svg><span><b>Recoger en sucursal</b><small>Recoge tu pedido en el local.</small></span><i aria-hidden="true">✓</i></span></label>
                <label><input type="radio" name="checkout-fulfillment" value="delivery" /><span class="fulfillment-card"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v12H3zM14 10h4l3 3v5h-7z" /><circle cx="7.5" cy="18" r="1.5" /><circle cx="17.5" cy="18" r="1.5" /></svg><span><b>Entrega a domicilio</b><small>Cobertura y costo por confirmar.</small></span><i aria-hidden="true">✓</i></span></label>
              </div>
            </fieldset>

            <div class="checkout-pickup" data-checkout-pickup>
              <p class="checkout-label">Sucursal de recogida</p>
              <div data-pickup-locations></div>
            </div>

            <label class="checkout-field" data-address-field hidden>
              <span>Dirección de entrega <b>*</b></span>
              <textarea name="address" data-address rows="3" maxlength="500" placeholder="Calle, número, colonia y referencias" autocomplete="street-address"></textarea>
              <small>La cobertura y el costo de envío se confirman con la sucursal.</small>
            </label>

            <div class="contact-heading"><span>2</span><div><h2>Datos de contacto</h2><p>Para que la sucursal pueda coordinar contigo.</p></div></div>
            <div class="checkout-field-row">
              <label class="checkout-field">
                <span>Nombre <b>*</b></span>
                <input name="customer-name" data-customer-name type="text" maxlength="120" autocomplete="name" placeholder="Nombre de quien recibe" required />
              </label>
              <label class="checkout-field">
                <span>Teléfono de contacto <b>*</b></span>
                <input name="customer-phone" data-customer-phone type="tel" maxlength="30" pattern="[0-9+() -]{7,30}" autocomplete="tel" inputmode="tel" placeholder="462 000 0000" title="Usa entre 7 y 30 números, espacios, paréntesis, + o guiones." required />
              </label>
            </div>

            <label class="checkout-field">
              <span>Indicaciones adicionales <small>Opcional</small></span>
              <textarea name="notes" data-customer-notes rows="3" maxlength="1000" placeholder="Referencias para llegar o detalles de entrega"></textarea>
            </label>

            <p class="checkout-privacy">Tus datos se usan para preparar este pedido y no se guardan al actualizar la página.</p>
            <p class="checkout-error" data-checkout-error role="alert" hidden></p>
            <div class="checkout-actions">
              <a class="checkout-secondary" href="/?cart=open#inicio">Volver al carrito</a>
              <button class="checkout-primary" type="submit">Continuar a revisión <span aria-hidden="true">→</span></button>
            </div>
          </section>

          <section class="checkout-panel" data-step-panel="3" aria-labelledby="checkout-review-title" hidden>
            <div class="review-section"><div class="review-section-heading"><h2 id="checkout-review-title" tabindex="-1">Productos</h2><button type="button" data-edit-cart>Editar carrito</button></div><div class="review-products" data-review-products></div></div>
            <div class="review-section"><h3>Entrega</h3><dl class="review-details" data-review-fulfillment></dl></div>
            <div class="review-section"><h3>Contacto</h3><dl class="review-details"><div><dt>Nombre</dt><dd data-review-name></dd></div><div><dt>Teléfono</dt><dd data-review-phone></dd></div><div data-review-notes-row hidden><dt>Indicaciones</dt><dd data-review-notes></dd></div></dl></div>
            <div class="review-payment"><span>Pago</span><b>Efectivo al recibir</b><small>El importe y la disponibilidad se confirman por WhatsApp.</small></div>
            <div class="checkout-error" data-review-error role="alert" hidden></div>
            <div class="checkout-actions checkout-review-actions">
              <button class="checkout-secondary" type="button" data-edit-details>Editar datos</button>
              <a class="checkout-primary checkout-whatsapp" data-whatsapp-link href="#" target="_blank" rel="noopener noreferrer">Enviar pedido por WhatsApp <span aria-hidden="true">↗</span></a>
            </div>
          </section>
        </form>

        <aside class="checkout-summary" aria-labelledby="checkout-summary-title">
          <div class="summary-heading"><p>Tu pedido</p><h2 id="checkout-summary-title">Resumen</h2></div>
          <div class="summary-products" data-summary-products></div>
          <div class="summary-hours" data-summary-hours></div>
          <dl class="summary-totals">
            <div><dt>Subtotal de productos</dt><dd data-summary-subtotal>$0.00</dd></div>
            <div data-summary-delivery-row hidden><dt>Envío</dt><dd>Por confirmar</dd></div>
            <div class="summary-grand-total"><dt data-summary-total-label>Total</dt><dd data-summary-total>$0.00</dd></div>
          </dl>
          <p class="summary-note" data-summary-note>Los precios y la disponibilidad se vuelven a confirmar por WhatsApp.</p>
        </aside>
      </div>
    </div>
  </main>
</CheckoutLayout>

<script define:vars={{ checkoutProducts: products, catalogUnavailable: catalogError }}>
  const CART_KEY = 'pollo-fresa-cart-v1';
  const WHATSAPP_NUMBER = '524463869132';
  const schedules = { pollo: { label: 'Pollo Fresa', start: 9, end: 18 }, wings: { label: 'Fresa Wings', start: 15, end: 22 } };
  const branchNames = {
    pollo: 'Pollo Fresa · Av. Mariano J. García 1254, Los Álamos',
    wings: 'Fresa Wings · Av. Independencia 1811, Miguel Hidalgo',
  };
  const page = document.querySelector('[data-checkout-page]');
  const content = page?.querySelector('[data-checkout-content]');
  const emptyState = page?.querySelector('[data-checkout-empty]');
  const form = page?.querySelector('[data-checkout-form]');
  const address = page?.querySelector('[data-address]');
  const addressField = page?.querySelector('[data-address-field]');
  const pickup = page?.querySelector('[data-checkout-pickup]');
  const draftKey = 'pollo-fresa-checkout-draft-v1';
  try {
    const draft = JSON.parse(sessionStorage.getItem(draftKey) || 'null');
    if (draft && typeof draft === 'object') {
      const nameField = page?.querySelector('[data-customer-name]');
      const phoneField = page?.querySelector('[data-customer-phone]');
      const notesField = page?.querySelector('[data-customer-notes]');
      if (nameField instanceof HTMLInputElement) nameField.value = String(draft.name || '');
      if (phoneField instanceof HTMLInputElement) phoneField.value = String(draft.phone || '');
      if (notesField instanceof HTMLTextAreaElement) notesField.value = String(draft.notes || '');
      if (address instanceof HTMLTextAreaElement) address.value = String(draft.address || '');
      if (draft.fulfillment === 'delivery') {
        const deliveryRadio = form?.querySelector('input[name="checkout-fulfillment"][value="delivery"]');
        if (deliveryRadio instanceof HTMLInputElement) deliveryRadio.checked = true;
      }
    }
    sessionStorage.removeItem(draftKey);
  } catch {}
  const hydratedProducts = Array.isArray(checkoutProducts) ? checkoutProducts : [];
  const getProduct = (id) => hydratedProducts.find((product) => String(product.id) === String(id));
  const getBrandKey = (product) => product?.brand === 'Fresa Wings' ? 'wings' : 'pollo';
  const getOptionGroups = (product) => Array.isArray(product?.optionGroups) ? product.optionGroups : [];
  const priceNumber = (price) => Number(String(price).replace(/[^0-9.]/g, '')) || 0;
  const money = (price) => `$${Number(price).toFixed(2)}`;
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
  const getHour = () => Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/Mexico_City', hour: '2-digit', hourCycle: 'h23' }).format(new Date()));
  const isOpen = (brand) => { const schedule = schedules[brand] ?? schedules.pollo; const hour = getHour(); return hour >= schedule.start && hour < schedule.end; };
  const nextOpening = (brand) => { const schedule = schedules[brand] ?? schedules.pollo; const hour = getHour(); return hour < schedule.start ? `Abre a las ${schedule.start > 12 ? schedule.start - 12 : schedule.start} ${schedule.start >= 12 ? 'PM' : 'AM'}` : 'Abre mañana'; };
  const selectionKey = (selections = []) => selections.map((selection) => `${selection.groupId}:${selection.optionId}`).sort().join('|');
  const getLineOptions = (product, item) => (item.selectedOptions ?? []).map((selection) => {
    const group = getOptionGroups(product).find((candidate) => Number(candidate.id) === Number(selection.groupId));
    const option = group?.options?.find((candidate) => Number(candidate.id) === Number(selection.optionId));
    return group && option ? { group, option } : null;
  }).filter(Boolean);
  const lineUnitPrice = (product, item) => priceNumber(product.price) + getLineOptions(product, item).reduce((total, selection) => total + Number(selection.option.priceDelta || 0), 0);
  const getOptionError = (product, selections = []) => {
    for (const selection of selections) {
      const group = getOptionGroups(product).find((candidate) => Number(candidate.id) === Number(selection.groupId));
      if (!group || !group.options.some((option) => Number(option.id) === Number(selection.optionId))) return `${product.name} tiene opciones que ya no están disponibles. Regresa al carrito para corregirlas.`;
    }
    for (const group of getOptionGroups(product)) {
      const selectedCount = selections.filter((selection) => Number(selection.groupId) === Number(group.id)).length;
      const minimum = Math.max(group.required ? 1 : 0, Number(group.minSelect) || 0);
      const maximum = Number(group.maxSelect) > 0 ? Number(group.maxSelect) : Infinity;
      if (selectedCount < minimum || selectedCount > maximum) return `Revisa las opciones de ${product.name}: ${group.name}.`;
    }
    return '';
  };
  const readCart = () => {
    try {
      const saved = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
      return Array.isArray(saved) ? saved.filter((item) => item && Number.isInteger(item.quantity) && item.quantity > 0).map((item) => ({ id: item.id, quantity: item.quantity, selectedOptions: Array.isArray(item.selectedOptions) ? item.selectedOptions.filter((selection) => Number.isInteger(selection?.groupId) && Number.isInteger(selection?.optionId)) : [] })) : [];
    } catch { return []; }
  };
  let cart = readCart();
  let hydratedItems = [];
  let subtotal = 0;
  let cartIsValid = false;
  let currentStep = 2;
  const showError = (message = '') => {
    const error = page?.querySelector('[data-checkout-error]');
    if (error) { error.textContent = message; error.hidden = !message; }
  };
  const updateFulfillment = () => {
    const type = form?.querySelector('input[name="checkout-fulfillment"]:checked')?.value ?? 'pickup';
    const isDelivery = type === 'delivery';
    if (addressField) addressField.hidden = !isDelivery;
    if (pickup) pickup.hidden = isDelivery;
    if (address instanceof HTMLTextAreaElement) address.required = isDelivery;
    const deliveryRow = page?.querySelector('[data-summary-delivery-row]');
    if (deliveryRow) deliveryRow.hidden = !isDelivery;
    const totalLabel = page?.querySelector('[data-summary-total-label]');
    const totalValue = page?.querySelector('[data-summary-total]');
    const note = page?.querySelector('[data-summary-note]');
    if (totalLabel) totalLabel.textContent = isDelivery ? 'Total antes del envío' : 'Total';
    if (totalValue) totalValue.textContent = isDelivery ? `${money(subtotal)} + envío por confirmar` : money(subtotal);
    if (note) note.textContent = isDelivery ? 'La sucursal confirma cobertura y total final antes de que realices el pago.' : 'Los precios y la disponibilidad se confirman por WhatsApp.';
  };
  const renderProductList = (items) => items.map((item) => {
    const { product, quantity } = item;
    const options = getLineOptions(product, item).map(({ group, option }) => `${group.name}: ${option.name}`);
    const brand = schedules[getBrandKey(product)].label;
    const image = product.image ? `<img src="${escapeHtml(product.image)}" alt="" loading="lazy" />` : '<span class="summary-product-placeholder" aria-hidden="true"></span>';
    return `<article class="summary-product">${image}<div><small>${escapeHtml(brand)}</small><h3>${escapeHtml(product.name)}</h3>${options.length ? `<p>${options.map(escapeHtml).join(' · ')}</p>` : ''}<span>${quantity} × ${money(lineUnitPrice(product, item))}</span></div><b>${money(lineUnitPrice(product, item) * quantity)}</b></article>`;
  }).join('');
  const render = () => {
    cart = readCart();
    hydratedItems = cart.map((item) => ({ ...item, product: getProduct(item.id) })).filter((item) => item.product);
    const unknownItems = hydratedItems.length !== cart.length;
    const optionError = hydratedItems.map((item) => getOptionError(item.product, item.selectedOptions)).find(Boolean);
    cartIsValid = !catalogUnavailable && cart.length > 0 && !unknownItems && !optionError;
    subtotal = hydratedItems.reduce((total, item) => total + lineUnitPrice(item.product, item) * item.quantity, 0);

    if (catalogUnavailable || cart.length === 0 || unknownItems) {
      if (content) content.hidden = true;
      if (emptyState) emptyState.hidden = false;
      const title = emptyState?.querySelector('[data-empty-title]');
      const copy = emptyState?.querySelector('[data-empty-copy]');
      if (title) title.textContent = catalogUnavailable ? 'No pudimos cargar el menú.' : cart.length === 0 ? 'Tu carrito está vacío.' : 'Hay un producto que ya no está disponible.';
      if (copy) copy.textContent = catalogUnavailable ? 'Vuelve al menú e inténtalo de nuevo en unos minutos.' : cart.length === 0 ? 'Agrega tus favoritos y vuelve para continuar.' : 'Regresa al carrito para revisar los productos disponibles.';
      return;
    }

    if (emptyState) emptyState.hidden = true;
    if (content) content.hidden = false;
    const summaryProducts = page?.querySelector('[data-summary-products]');
    const reviewProducts = page?.querySelector('[data-review-products]');
    if (summaryProducts) summaryProducts.innerHTML = renderProductList(hydratedItems);
    if (reviewProducts) reviewProducts.innerHTML = renderProductList(hydratedItems);
    const brands = [...new Set(hydratedItems.map((item) => getBrandKey(item.product)))];
    const locations = page?.querySelector('[data-pickup-locations]');
    if (locations) locations.innerHTML = brands.map((brand) => `<p>${escapeHtml(branchNames[brand])}</p>`).join('');
    const hours = page?.querySelector('[data-summary-hours]');
    if (hours) hours.innerHTML = brands.map((brand) => `<p class="${isOpen(brand) ? 'is-open' : ''}"><span></span><b>${schedules[brand].label}</b><small>${isOpen(brand) ? 'Disponible ahora' : nextOpening(brand)}</small></p>`).join('');
    const subtotalElement = page?.querySelector('[data-summary-subtotal]');
    if (subtotalElement) subtotalElement.textContent = money(subtotal);
    if (optionError) showError(optionError);
    else showError('');
    updateFulfillment();
    if (currentStep === 3) renderReview();
  };
  const setStep = (step) => {
    if (step === 3 && (!cartIsValid || !form?.reportValidity())) return;
    currentStep = step;
    page?.setAttribute('data-current-step', String(step));
    const eyebrow = page?.querySelector('[data-checkout-eyebrow]');
    const title = page?.querySelector('[data-checkout-title]');
    const copy = page?.querySelector('[data-checkout-copy]');
    if (eyebrow) eyebrow.textContent = step === 2 ? 'PASO 2 DE 3 · ENTREGA Y DATOS' : 'PASO 3 DE 3 · REVISIÓN FINAL';
    if (title) title.textContent = step === 2 ? '¿Cómo recibes tu pedido?' : 'Revisa y confirma.';
    if (copy) copy.textContent = step === 2 ? 'Elige cómo recibirlo y déjanos tus datos de contacto.' : 'Comprueba los productos y los datos antes de continuar por WhatsApp.';
    page?.querySelectorAll('[data-step-panel]').forEach((panel) => { panel.hidden = panel.getAttribute('data-step-panel') !== String(step); });
    page?.querySelectorAll('[data-step-indicator]').forEach((indicator) => {
      const number = Number(indicator.getAttribute('data-step-indicator'));
      indicator.classList.toggle('is-complete', number < step);
      indicator.classList.toggle('is-current', number === step);
      if (number === step) indicator.setAttribute('aria-current', 'step');
      else indicator.removeAttribute('aria-current');
    });
    if (step === 3) renderReview();
    requestAnimationFrame(() => {
      const heading = step === 2 ? page?.querySelector('[data-checkout-title]') : page?.querySelector('[data-step-panel="3"] h2');
      heading?.focus();
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  };
  const renderReview = () => {
    const fulfillmentType = form?.querySelector('input[name="checkout-fulfillment"]:checked')?.value ?? 'pickup';
    const name = page?.querySelector('[data-customer-name]')?.value.trim() ?? '';
    const phone = page?.querySelector('[data-customer-phone]')?.value.trim() ?? '';
    const notes = page?.querySelector('[data-customer-notes]')?.value.trim() ?? '';
    const deliveryAddress = address instanceof HTMLTextAreaElement ? address.value.trim() : '';
    const isDelivery = fulfillmentType === 'delivery';
    const brands = [...new Set(hydratedItems.map((item) => getBrandKey(item.product)))];
    const fulfillment = page?.querySelector('[data-review-fulfillment]');
    if (fulfillment) {
      const details = isDelivery
        ? [['Modalidad', 'A domicilio'], ['Dirección', deliveryAddress], ['Envío', 'Costo y cobertura por confirmar']]
        : [['Modalidad', 'Recoger en sucursal'], ...brands.map((brand) => ['Sucursal', branchNames[brand]])];
      fulfillment.innerHTML = details.map(([label, value]) => `<div><dt>${escapeHtml(label)}</dt><dd>${escapeHtml(value)}</dd></div>`).join('');
    }
    const reviewName = page?.querySelector('[data-review-name]');
    const reviewPhone = page?.querySelector('[data-review-phone]');
    const reviewNotes = page?.querySelector('[data-review-notes]');
    const notesRow = page?.querySelector('[data-review-notes-row]');
    if (reviewName) reviewName.textContent = name;
    if (reviewPhone) reviewPhone.textContent = phone;
    if (reviewNotes) reviewNotes.textContent = notes;
    if (notesRow) notesRow.hidden = !notes;
    const lines = hydratedItems.map((item) => {
      const product = item.product;
      const selections = getLineOptions(product, item).map(({ group, option }) => `${group.name}: ${option.name}`);
      return `- ${item.quantity} x ${product.name} (${schedules[getBrandKey(product)].label}) - ${money(lineUnitPrice(product, item) * item.quantity)}${selections.length ? `\n   ${selections.join(', ')}` : ''}`;
    });
    const deliveryLines = isDelivery
      ? ['*Modalidad:* A domicilio', `*Dirección:* ${deliveryAddress}`, '*Envío:* Costo por confirmar por la sucursal', `*Subtotal de productos:* ${money(subtotal)}`, '*Total final:* Por confirmar con el costo de envío']
      : ['*Modalidad:* Recoger en sucursal', ...brands.map((brand) => `*Sucursal:* ${branchNames[brand]}`), `*Total:* ${money(subtotal)}`];
    const message = ['Hola, quiero hacer este pedido:', '', ...lines, '', ...deliveryLines, '*Pago:* Efectivo', `*Cliente:* ${name}`, `*Teléfono:* ${phone}`, ...(notes ? [`*Notas:* ${notes}`] : []), '', '¿Me ayudan a confirmar disponibilidad, cobertura y total final antes del pago?'].join('\n');
    const link = page?.querySelector('[data-whatsapp-link]');
    if (link instanceof HTMLAnchorElement) {
      if (cartIsValid) link.href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      else link.removeAttribute('href');
    }
    const error = page?.querySelector('[data-review-error]');
    if (error) { error.textContent = cartIsValid ? '' : 'El carrito cambió o requiere ajustes. Regresa al carrito antes de enviar.'; error.hidden = cartIsValid; }
    if (link instanceof HTMLAnchorElement) link.setAttribute('aria-disabled', String(!cartIsValid));
  };

  form?.addEventListener('change', (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === 'checkout-fulfillment') updateFulfillment();
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!cartIsValid) { showError('Regresa al carrito para corregir los productos antes de continuar.'); return; }
    if (!form.reportValidity()) return;
    showError();
    setStep(3);
  });
  page?.querySelector('[data-edit-details]')?.addEventListener('click', () => setStep(2));
  page?.querySelector('[data-edit-cart]')?.addEventListener('click', () => {
    try {
      sessionStorage.setItem(draftKey, JSON.stringify({
        fulfillment: form?.querySelector('input[name="checkout-fulfillment"]:checked')?.value ?? 'pickup',
        name: page?.querySelector('[data-customer-name]')?.value ?? '',
        phone: page?.querySelector('[data-customer-phone]')?.value ?? '',
        notes: page?.querySelector('[data-customer-notes]')?.value ?? '',
        address: address instanceof HTMLTextAreaElement ? address.value : '',
      }));
    } catch { /* Continue to cart if this browser blocks session storage. */ }
    window.location.assign('/?cart=open#inicio');
  });
  page?.querySelector('[data-whatsapp-link]')?.addEventListener('click', (event) => {
    if (!cartIsValid) { event.preventDefault(); const error = page.querySelector('[data-review-error]'); if (error) { error.textContent = 'El carrito cambió. Regresa al menú y revisa los productos antes de enviar.'; error.hidden = false; } }
  });
  window.addEventListener('storage', (event) => { if (event.key === CART_KEY) render(); });
  render();
</script>

<style is:global>
  html,body.checkout-body{min-height:100%;background:#fff;color:#151515}
  .checkout-page{--checkout-ink:#151515;--checkout-muted:#777;--checkout-line:#eaeaea;--checkout-red:#e73a2b;min-height:100dvh;background:#fff;color:var(--checkout-ink);font-family:var(--body,Arial,sans-serif)}
  .checkout-header{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:78px;padding:0 clamp(20px,5vw,76px);border-bottom:1px solid var(--checkout-line)}
