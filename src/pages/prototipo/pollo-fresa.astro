---
import PrototypeLayout from '../../layouts/PrototypeLayout.astro';
import PolloFresaMenu from '../../components/PolloFresaMenu.astro';
import polloLogo from '../../assets/pollo_fresa.webp';
import { getBrandCatalog } from '../../lib/directus';

const enabled = import.meta.env.DEV;
if (!enabled) Astro.response.status = 404;
const catalog = enabled ? await getBrandCatalog('Pollo Fresa') : null;
---
<PrototypeLayout title="Pollo Fresa — Menú de concepto" description="Propuesta visual editorial para el menú de Pollo Fresa." logo={polloLogo} brand="Pollo Fresa" theme="pollo">
  {enabled && catalog
    ? catalog.catalogError
      ? <main class="load-error"><h1>Catálogo temporalmente no disponible</h1><p>No se pudieron consultar los productos de Pollo Fresa. Intenta recargar esta página.</p></main>
      : <main><PolloFresaMenu products={catalog.products} categories={catalog.categories} /></main>
    : <main class="load-error"><h1>Ruta no disponible</h1></main>}
</PrototypeLayout>

<style>
  .load-error{min-height:100vh;display:grid;align-content:center;justify-items:center;padding:30px;text-align:center;color:#251e19;background:#f1e9da;font-family:Arial,sans-serif}.load-error h1{font-size:clamp(30px,6vw,56px)}.load-error p{max-width:460px;line-height:1.6;color:#756d62}
</style>
