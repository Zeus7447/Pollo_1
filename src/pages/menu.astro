---
import Layout from '../layouts/Layout_menu.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import polloEntero from '../assets/menu-pollo-entero.png';
import medioPollo from '../assets/menu-medio-pollo.png';
import combo from '../assets/menu-combo.png';
import acompanamientos from '../assets/menu-acompanamientos.png';
import WhatsappFlotante from '../components/whatsapp_flotante.astro';
import MenuAlitas from '../components/menu_alitas.astro';
import HeroMenu from '../components/hero_menu.astro';

const products = [
  { category: 'pollos', badge: 'El favorito', name: 'Pollo entero', description: 'Dorado, jugoso e incluye tortillas y salsa de la casa.', price: '$249', image: polloEntero },
  { category: 'pollos', badge: 'Para uno o dos', name: 'Medio pollo', description: 'Todo el sabor de la casa en la porción perfecta.', price: '$139', image: medioPollo },
  { category: 'combos', badge: 'Todo incluido', name: 'Combo Fresa', description: 'Medio pollo, papas, tortillas, salsa y bebida.', price: '$179', image: combo },
  { category: 'combos', badge: 'Para compartir', name: 'Combo familiar', description: 'Pollo entero, dos acompañamientos, tortillas y salsas.', price: '$329', image: polloEntero },
  { category: 'acompanamientos', badge: 'Extra crujiente', name: 'Papas doradas', description: 'Papas sazonadas y rostizadas hasta quedar irresistibles.', price: '$59', image: acompanamientos },
  { category: 'acompanamientos', badge: 'Sabor de casa', name: 'Mesa completa', description: 'Papas, cebollitas, tortillas y salsas roja y verde.', price: '$99', image: acompanamientos },
];
---

<Layout>
  <Header />
  <main>
    <HeroMenu />

    <nav class="category-nav" aria-label="Negocios y categorías del menú"><span>DOS NEGOCIOS, UN ANTOJO</span><div><a class="chicken-tab" href="#pollo-fresa">Pollo rostizado</a><a class="wings-tab" href="#fresa-wings">Alitas & boneless</a></div><a class="order-nav" href="/pedir">Pedir ahora</a></nav>

    <section class="menu-section" id="pollo-fresa" aria-labelledby="menu-title">
      <header class="menu-heading"><div><p><span></span> 01 · Recién salido del rosticero</p><h2 id="menu-title">Pollo <i>Fresa</i></h2></div><p>Elige tu favorito. Todos nuestros pollos se preparan durante el día para servirlos calientes y en su punto.</p></header>

      <div class="chicken-subnav" aria-label="Categorías de Pollo Fresa"><span>Explora:</span><a href="#pollos">Pollos</a><a href="#combos">Combos</a><a href="#acompanamientos">Acompañamientos</a></div>

      <div class="product-grid">
        {products.map((product, index) => (
          <article class:list={['product-card', { wide: index === 0 || index === 3 }]} id={index === 0 ? 'pollos' : index === 2 ? 'combos' : index === 4 ? 'acompanamientos' : undefined}>
            <a href="/pedir">
              <div class="product-visual"><img src={product.image.src} alt={product.name} loading="lazy" /><span class="badge">{product.badge}</span><span class="number">0{index + 1}</span></div>
              <div class="product-info"><div><small>{product.category}</small><h3>{product.name}</h3><p>{product.description}</p></div><div class="price"><strong>{product.price}</strong><span>Agregar al pedido</span></div></div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <MenuAlitas />

    <section class="order-banner"><div><p>¿Con cuál te quedas?</p><h2>Rostizado o bañado,<br /><i>el antojo manda.</i></h2></div><p>Elige Pollo Fresa para compartir en familia o Fresa Wings para una tarde cargada de sabor.</p><a href="https://wa.me/524463869132?text=Hola%2C%20quiero%20hacer%20un%20pedido." target="_blank" rel="noreferrer">Empezar mi pedido</a></section>
  </main>
  <Footer />
  <WhatsappFlotante />
</Layout>

<style>
  .menu-hero { position: relative; min-height: 790px; overflow: hidden; color: #fff4df; background: #422018; }.menu-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(1.08) contrast(1.06); }.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #210b06e8 0%, #210b0699 38%, #210b0614 72%), linear-gradient(0deg, #210b0699, transparent 40%); }.hero-content { position: relative; z-index: 2; width: min(1160px, calc(100% - 64px)); margin: auto; padding-top: 210px; }.hero-content > p { margin: 0 0 25px; color: #ffd36a; font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }.hero-content > p span { display: inline-block; width: 30px; height: 2px; margin: 0 11px 3px 0; background: #ffd36a; }.hero-content h1 { max-width: 940px; margin: 0; font-family: var(--font-display); font-size: clamp(65px, 8.5vw, 122px); font-weight: 400; letter-spacing: -.035em; line-height: .78; }.hero-content h1 i { color: #ffd36a; font-style: normal; }.hero-bottom { display: flex; gap: 45px; align-items: end; margin-top: 48px; }.hero-bottom > p { max-width: 370px; margin: 0; color: #fff4dfcf; font-size: 14px; line-height: 1.7; }.hero-bottom a { padding: 17px 21px; color: #fff; background: #c51f2b; font-size: 11px; font-weight: 800; text-decoration: none; box-shadow: 0 12px 30px #210b0655; }.hero-bottom a span { margin-left: 28px; color: #ffd36a; font-size: 17px; }.hero-price { position: absolute; z-index: 2; right: max(32px, calc((100vw - 1160px) / 2)); bottom: 47px; display: flex; width: 130px; height: 130px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #ffd36a; border-radius: 50%; color: #ffd36a; background: #c51f2be8; text-align: center; transform: rotate(6deg); }.hero-price small, .hero-price span { font-size: 7px; font-weight: 800; letter-spacing: .14em; }.hero-price strong { margin: 3px 0; font-family: var(--font-display); font-size: 37px; font-weight: 400; }.hero-note { position: absolute; z-index: 2; bottom: 49px; left: max(32px, calc((100vw - 1160px) / 2)); color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .17em; }.category-nav { position: sticky; z-index: 8; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 17px max(32px, calc((100vw - 1160px) / 2)); color: #422018; background: #ffd36af2; border-bottom: 1px solid #c51f2b33; backdrop-filter: blur(10px); }.category-nav > span { font-size: 8px; font-weight: 800; letter-spacing: .17em; }.category-nav div { display: flex; gap: 30px; }.category-nav a { color: #422018; font-size: 10px; font-weight: 800; text-decoration: none; }.category-nav div a:hover { color: #c51f2b; }.order-nav { justify-self: end; }.menu-section { padding: 110px 32px 125px; background: #fff4df; }.menu-heading { display: grid; width: min(1160px, 100%); grid-template-columns: 1fr 350px; gap: 50px; align-items: end; margin: 0 auto 48px; }.menu-heading > div > p { margin: 0 0 14px; color: #c51f2b; font-size: 9px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }.menu-heading > div > p span { display: inline-block; width: 29px; height: 2px; margin: 0 10px 3px 0; background: #c51f2b; }.menu-heading h2 { margin: 0; color: #422018; font-family: var(--font-display); font-size: clamp(52px, 6vw, 80px); font-weight: 400; line-height: .85; }.menu-heading h2 i { color: #c51f2b; font-style: normal; }.menu-heading > p { margin: 0; color: #79584a; font-size: 13px; line-height: 1.7; }.product-grid { display: grid; width: min(1160px, 100%); grid-template-columns: repeat(2, 1fr); gap: 18px; margin: auto; }.product-card { min-width: 0; background: #f3ddbc; scroll-margin-top: 70px; }.product-card > a { display: grid; height: 100%; grid-template-columns: 49% 51%; color: #422018; text-decoration: none; }.product-card.wide { grid-column: span 2; min-height: 440px; }.product-card.wide > a { grid-template-columns: 58% 42%; }.product-visual { position: relative; min-height: 310px; overflow: hidden; background: #422018; }.product-visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease, filter .6s ease; }.product-card:hover img { filter: saturate(1.14); transform: scale(1.045); }.badge { position: absolute; top: 18px; left: 18px; padding: 8px 10px; color: #422018; background: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }.number { position: absolute; right: 17px; bottom: 15px; color: #ffd36a; font-family: var(--font-display); font-size: 15px; }.product-info { display: flex; flex-direction: column; justify-content: space-between; padding: 27px; }.product-info small { color: #c51f2b; font-size: 8px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }.product-info h3 { margin: 10px 0; font-family: var(--font-display); font-size: clamp(27px, 3vw, 42px); font-weight: 400; line-height: .9; }.product-info p { margin: 0; color: #79584a; font-size: 11px; line-height: 1.6; }.price { display: flex; justify-content: space-between; align-items: end; margin-top: 25px; padding-top: 16px; border-top: 1px solid #42201825; }.price strong { color: #c51f2b; font-size: 15px; }.price span { font-size: 9px; font-weight: 800; text-transform: uppercase; }.order-banner { display: grid; grid-template-columns: 1.2fr .7fr auto; gap: 55px; align-items: center; padding: 80px max(32px, calc((100vw - 1160px) / 2)); color: #fff4df; background: #c51f2b; }.order-banner > div > p { margin: 0 0 12px; color: #ffd36a; font-size: 9px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }.order-banner h2 { margin: 0; font-family: var(--font-display); font-size: clamp(45px, 5vw, 69px); font-weight: 400; line-height: .85; }.order-banner h2 i { color: #ffd36a; font-style: normal; }.order-banner > p { margin: 0; color: #fff4dfbf; font-size: 12px; line-height: 1.65; }.order-banner > a { padding: 18px 20px; color: #422018; background: #ffd36a; font-size: 11px; font-weight: 800; text-decoration: none; white-space: nowrap; }.order-banner > a span { margin-left: 24px; color: #c51f2b; font-size: 18px; }
  @media (max-width: 850px) { .menu-hero { min-height: 720px; }.hero-content { padding-top: 180px; }.menu-heading { grid-template-columns: 1fr; gap: 20px; }.product-card > a, .product-card.wide > a { grid-template-columns: 1fr; }.product-card.wide { min-height: 0; }.product-visual { min-height: 360px; }.order-banner { grid-template-columns: 1fr 1fr; }.order-banner > a { grid-column: 1 / -1; text-align: center; } }
  @media (max-width: 620px) { .menu-hero { min-height: 680px; }.hero-content { width: calc(100% - 36px); padding-top: 155px; }.hero-content h1 { font-size: 63px; }.hero-bottom { display: block; }.hero-bottom a { display: inline-block; margin-top: 25px; }.hero-price { right: 18px; bottom: 22px; width: 105px; height: 105px; }.hero-note { display: none; }.category-nav { grid-template-columns: 1fr auto; padding-inline: 18px; }.category-nav > span { display: none; }.category-nav div { gap: 15px; }.order-nav { font-size: 11px !important; }.order-nav::after { content: none; }.menu-section { padding: 80px 18px 90px; }.product-grid { grid-template-columns: 1fr; }.product-card.wide { grid-column: auto; }.product-visual { min-height: 300px; }.order-banner { grid-template-columns: 1fr; gap: 25px; padding: 65px 18px; }.order-banner > a { grid-column: auto; } }
  .menu-hero-v2 { position: relative; min-height: 820px; overflow: hidden; color: #fff4df; background: radial-gradient(circle at 72% 42%, #7b261b 0%, #422018 36%, #29100b 76%); isolation: isolate; }
  .menu-hero-v2::before { position: absolute; z-index: -1; top: 0; left: 45%; width: 1px; height: 100%; background: #ffd36a20; content: ''; }
  .hero-word { position: absolute; z-index: -1; top: 100px; left: -18px; color: #ffd36a09; font-family: var(--font-display); font-size: clamp(180px, 27vw, 400px); letter-spacing: -.07em; line-height: .8; white-space: nowrap; }
  .hero-grid-v2 { display: grid; width: min(1240px, calc(100% - 64px)); min-height: 760px; grid-template-columns: 45% 55%; gap: 55px; align-items: center; margin: auto; padding-top: 105px; }
  .hero-copy-v2 { position: relative; z-index: 3; padding-bottom: 35px; }
  .hero-kicker { margin: 0 0 23px; color: #ffd36a; font-size: 10px; font-weight: 800; letter-spacing: .19em; text-transform: uppercase; }
  .hero-kicker span { display: inline-block; width: 32px; height: 2px; margin: 0 12px 3px 0; background: #ffd36a; }
  .hero-copy-v2 h1 { margin: 0; font-family: var(--font-display); font-size: clamp(67px, 7.4vw, 108px); font-weight: 400; letter-spacing: -.035em; line-height: .76; }
  .hero-copy-v2 h1 i { color: #ffd36a; font-style: normal; }
  .hero-description { max-width: 425px; margin: 31px 0 0; color: #fff4dfbd; font-size: 14px; line-height: 1.75; }
  .hero-actions-v2 { display: flex; gap: 24px; align-items: center; margin-top: 33px; }
  .hero-actions-v2 a { font-size: 11px; font-weight: 800; text-decoration: none; }
  .hero-order { padding: 17px 20px; color: #422018; background: #ffd36a; box-shadow: 0 12px 30px #17070466; transition: transform .2s ease, box-shadow .2s ease; }
  .hero-order:hover { box-shadow: 0 16px 34px #17070488; transform: translateY(-3px); }
  .hero-order span { margin-left: 30px; color: #c51f2b; font-size: 18px; }
  .hero-menu-link { padding: 13px 2px 8px; border-bottom: 1px solid #ffd36a88; color: #fff4df; }
  .hero-menu-link span { margin-left: 13px; color: #ffd36a; font-size: 16px; }
  .hero-features { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 45px; }
  .hero-features span { padding: 8px 10px; border: 1px solid #ffd36a40; color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .hero-visual-v2 { position: relative; height: 585px; }
  .hero-visual-v2::before, .hero-visual-v2::after { position: absolute; border: 1px solid #ffd36a2c; border-radius: 50%; content: ''; }
  .hero-visual-v2::before { top: -25px; right: -30px; width: 510px; height: 510px; }
  .hero-visual-v2::after { top: 29px; right: 24px; width: 400px; height: 400px; }
  .main-photo { position: absolute; z-index: 1; top: 15px; right: 0; width: 84%; height: 510px; overflow: hidden; border: 7px solid #fff4df; border-radius: 47% 47% 6px 6px; box-shadow: 25px 25px 0 #c51f2b; }
  .main-photo::after { position: absolute; inset: 0; background: linear-gradient(0deg, #27100b88, transparent 42%); content: ''; }
  .main-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 56% center; filter: saturate(1.09) contrast(1.04); transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .main-photo:hover img { transform: scale(1.04); }
  .photo-label { position: absolute; z-index: 2; right: 20px; bottom: 18px; color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .17em; }
  .combo-card { position: absolute; z-index: 3; left: -25px; bottom: 1px; display: grid; width: 250px; grid-template-columns: 88px 1fr; gap: 13px; align-items: center; padding: 10px; color: #422018; background: #ffd36a; box-shadow: 0 18px 35px #17070466; transform: rotate(-2deg); }
  .combo-card img { width: 88px; height: 76px; object-fit: cover; }
  .combo-card small { display: block; margin-bottom: 5px; color: #c51f2b; font-size: 7px; font-weight: 800; letter-spacing: .13em; }
  .combo-card strong { font-family: var(--font-display); font-size: 15px; font-weight: 400; line-height: 1.05; }
  .price-stamp { position: absolute; z-index: 4; top: 7px; left: -5px; display: flex; width: 117px; height: 117px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid #ffd36a; border-radius: 50%; color: #ffd36a; background: #c51f2bf2; box-shadow: 0 12px 28px #17070455; text-align: center; transform: rotate(-8deg); }
  .price-stamp small, .price-stamp span { font-size: 7px; font-weight: 800; letter-spacing: .12em; }
  .price-stamp strong { margin: 1px 0; font-family: var(--font-display); font-size: 33px; font-weight: 400; line-height: 1; }
  .fire-note { position: absolute; z-index: 4; right: 23px; bottom: 12px; color: #ffd36a; font-size: 8px; font-weight: 800; letter-spacing: .15em; }
  .fire-note b { margin-right: 8px; color: #f28c16; }
  .hero-strip { position: absolute; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-around; gap: 24px; align-items: center; padding: 17px 24px; color: #422018; background: #f28c16; }
  .hero-strip span { font-size: 8px; font-weight: 800; letter-spacing: .16em; white-space: nowrap; }
  .hero-strip b { color: #c51f2b; font-size: 11px; }
  @media (max-width: 980px) { .menu-hero-v2 { min-height: 1120px; }.hero-grid-v2 { width: min(760px, calc(100% - 64px)); min-height: 1050px; grid-template-columns: 1fr; gap: 10px; padding: 155px 0 100px; }.hero-copy-v2 { padding: 0; }.hero-description { max-width: 540px; }.hero-visual-v2 { height: 520px; }.main-photo { width: 82%; height: 460px; }.combo-card { left: 3%; }.menu-hero-v2::before { display: none; } }
  @media (max-width: 620px) { .menu-hero-v2 { min-height: 1020px; }.hero-grid-v2 { width: calc(100% - 36px); min-height: 960px; padding: 130px 0 85px; }.hero-copy-v2 h1 { font-size: 64px; }.hero-description { margin-top: 25px; font-size: 13px; }.hero-actions-v2 { align-items: stretch; flex-direction: column; }.hero-actions-v2 a { text-align: center; }.hero-features { margin-top: 29px; }.hero-visual-v2 { height: 410px; margin-top: 25px; }.main-photo { top: 0; width: 92%; height: 365px; border-width: 5px; box-shadow: 13px 13px 0 #c51f2b; }.price-stamp { width: 94px; height: 94px; }.price-stamp strong { font-size: 27px; }.combo-card { bottom: -4px; left: 0; width: 205px; grid-template-columns: 68px 1fr; }.combo-card img { width: 68px; height: 62px; }.fire-note { display: none; }.hero-strip { justify-content: center; }.hero-strip span:nth-of-type(even), .hero-strip span:nth-of-type(n+3), .hero-strip b:nth-of-type(n+2) { display: none; } }
  .category-nav { z-index: 40; top: 84px; padding-block: 13px; }
  .category-nav div { gap: 8px; }
  .category-nav div a { padding: 10px 16px; border: 1px solid #42201828; transition: color .2s, background .2s, border-color .2s; }
  .category-nav div a:hover { border-color: #c51f2b; color: #fff4df; background: #c51f2b; }
  .category-nav div .wings-tab { border-color: #422018; color: #ffd36a; background: #1b1513; }
  .category-nav div .wings-tab:hover { border-color: #f28c16; color: #fff4df; background: #c51f2b; }
  .menu-section { scroll-margin-top: 65px; }
  .menu-heading { margin-bottom: 28px; }
  .chicken-subnav { display: flex; width: min(1160px, 100%); flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 auto 48px; padding-top: 20px; border-top: 1px solid #42201820; }
  .chicken-subnav span { margin-right: 5px; color: #79584a; font-size: 8px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .chicken-subnav a { padding: 8px 11px; border: 1px solid #c51f2b35; color: #c51f2b; font-size: 8px; font-weight: 900; text-decoration: none; text-transform: uppercase; transition: color .2s, background .2s; }
  .chicken-subnav a:hover { color: #fff4df; background: #c51f2b; }
  @media (max-width: 620px) {
    .category-nav { top: 84px; grid-template-columns: 1fr auto; }
    .category-nav div { width: 100%; }
    .category-nav div a { flex: 1; padding: 9px 8px; text-align: center; }
    .chicken-subnav span { width: 100%; }
  }
</style>
