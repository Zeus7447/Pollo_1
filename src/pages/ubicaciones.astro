---
import Layout from '../layouts/Layout_indicaciones.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import WhatsappFlotante from '../components/whatsapp_flotante.astro';
import polloLogo from '../assets/logo_pollo.png';
import polloEntero from '../assets/menu-pollo-entero.png';

const locations = [
  {
    id: 'abasolo-2295',
    zone: 'Bajada de San Martín',
    address: 'Calle Mariano Abasolo 2295',
    detail: 'Bajada de San Martín, C.P. 36555, Irapuato, Gto.',
    phone: '462 235 6448',
    phoneHref: 'tel:+524622356448',
    hours: 'Lunes a domingo · 9:00 a 18:00',
    badge: 'Ficha completa',
    className: 'verified',
    query: 'Pollo Fresa, Calle Mariano Abasolo 2295, Bajada de San Martín, Irapuato, Guanajuato',
  },
  {
    id: 'abasolo-1997',
    zone: 'Playa Azul',
    address: 'Calle Mariano Abasolo 1997',
    detail: 'Playa Azul, C.P. 36555, Irapuato, Gto.',
    phone: '462 660 0320',
    phoneHref: 'tel:+524626600320',
    hours: 'Horario por confirmar',
    badge: 'Teléfono disponible',
    className: 'verified',
    query: 'Pollo Fresa, Calle Mariano Abasolo 1997, Playa Azul, Irapuato, Guanajuato',
  },
  {
    id: 'alamos',
    zone: 'Los Álamos',
    address: 'Av. Mariano J. García 1254',
    detail: 'Los Álamos, C.P. 36568, Irapuato, Gto.',
    phone: '462 146 5811',
    secondPhone: '462 103 0742',
    phoneHref: 'tel:+524621465811',
    hours: 'Lunes a domingo · hasta las 18:30',
    badge: 'Ficha completa',
    className: 'verified',
    query: 'Pollos Fresa, Av Mariano J García 1254, Los Álamos, Irapuato, Guanajuato',
  },
  {
    id: 'san-pedro',
    zone: 'San Pedro',
    address: 'Avenida Independencia s/n',
    detail: 'San Pedro, C.P. 36550, Irapuato, Gto.',
    hours: 'Horario y teléfono por confirmar',
    badge: 'Registro público',
    className: 'public',
    query: 'Pollería Pollo Fresa, Avenida Independencia, San Pedro, Irapuato, Guanajuato 36550',
  },
  {
    id: 'sostenes-rocha',
    zone: 'Zona Centro',
    address: 'Calle Sóstenes Rocha 584 B',
    detail: 'C.P. 36530, Irapuato, Gto.',
    hours: 'Confirma la operación antes de visitar',
    badge: 'Ficha antigua',
    className: 'check',
    query: 'Pollería El Pollo Fresa, Sóstenes Rocha 584 B, Irapuato, Guanajuato',
  },
  {
    id: 'guerrero',
    zone: 'Colonia Rodríguez',
    address: 'Calle Guerrero',
    detail: 'Colonia Rodríguez, Irapuato, Gto.',
    hours: 'Número exterior y horario por confirmar',
    badge: 'Referencia pública',
    className: 'check',
    query: 'Pollos Rostizados Pollo Fresa, Calle Guerrero, Colonia Rodríguez, Irapuato, Guanajuato',
  },
  {
    id: 'leandro-valle',
    zone: 'Centro',
    address: 'Calle Leandro Valle',
    detail: 'Colonia Centro, Irapuato, Gto.',
    hours: 'Número exterior y horario por confirmar',
    badge: 'Referencia pública',
    className: 'check',
    query: 'Rosticería Pollo Fresa, Calle Leandro Valle, Centro, Irapuato, Guanajuato',
  },
];

const mapEmbed = (query: string) => `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const directions = (query: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(query)}`;
---

<Layout>
  <Header />
  <main>
    <section class="locations-hero">
      <div class="hero-media" aria-hidden="true"><img src={polloEntero.src} alt="" /></div>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="hero-map-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

      <div class="hero-shell">
        <div class="hero-copy">
          <p><span></span> Estamos en Irapuato, Guanajuato</p>
          <h1>Encuentra tu<br /><i>Pollo Fresa.</i></h1>
          <span class="hero-description">Del rosticero a tu mesa. Explora nuestros puntos, elige el más cercano y abre la ruta en un solo toque.</span>
          <div class="hero-actions">
            <a class="hero-primary" href="#sucursales">Ver ubicaciones <b>↓</b></a>
            <a class="hero-secondary" href={directions(locations[0].query)} target="_blank" rel="noreferrer">Abrir Google Maps <b>↗</b></a>
          </div>
          <div class="hero-facts">
            <div><strong>{locations.length}</strong><span>Puntos<br />encontrados</span></div>
            <div><strong>1</strong><span>Ciudad<br />con mucho sabor</span></div>
            <div><strong>100%</strong><span>Antojo<br />irresistible</span></div>
          </div>
        </div>

        <aside class="hero-locator" aria-label="Resumen de ubicaciones">
          <div class="locator-heading">
            <span class="locator-pin"><i></i></span>
            <div><small>POLLO FRESA CERCA DE TI</small><strong>Irapuato, Gto.</strong></div>
            <span class="locator-logo"><img src={polloLogo.src} alt="" /></span>
          </div>
          <div class="locator-route" aria-hidden="true">
            <span class="route-point point-one"><i>01</i></span>
            <span class="route-point point-two"><i>02</i></span>
            <span class="route-point point-three"><i>03</i></span>
            <svg viewBox="0 0 350 126" preserveAspectRatio="none"><path d="M18 96 C76 22, 113 110, 172 61 S267 17, 332 43" /></svg>
          </div>
          <div class="locator-bottom">
            <div><small>PRIMER PUNTO</small><strong>Bajada de San Martín</strong><span>Mariano Abasolo 2295</span></div>
            <a href="#sucursales" aria-label="Explorar todas las ubicaciones">{locations.length}<small>VER TODAS</small><b>↘</b></a>
          </div>
        </aside>
      </div>

      <div class="hero-city" aria-hidden="true">IRAPUATO</div>
      <a class="hero-scroll" href="#sucursales"><span></span><small>DESLIZA PARA EXPLORAR</small></a>
    </section>

    <section class="locations-intro" id="sucursales" aria-labelledby="locations-title">
      <div class="intro-heading">
        <p><span>01</span> Elige tu punto</p>
        <h2 id="locations-title">Pollo Fresa<br /><i>en Irapuato.</i></h2>
      </div>
      <div class="intro-copy">
        <p>Pollo Fresa en la ciudad.</p>
      </div>
    </section>

    <section class="locations-explorer" aria-label="Explorador de ubicaciones">
      <div class="map-panel">
        <div class="map-heading">
          <div><small>VIENDO EN EL MAPA</small><strong data-map-title>{locations[0].zone}</strong></div>
          <span><i></i> Google Maps</span>
        </div>
        <iframe
          data-location-map
          src={mapEmbed(locations[0].query)}
          title={`Mapa de Pollo Fresa en ${locations[0].zone}`}
          loading="eager"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <div class="map-footer"><span>Selecciona una tarjeta para mover el mapa</span><b>IRAPUATO, GTO.</b></div>
      </div>

      <div class="locations-list">
        {locations.map((location, index) => (
          <article class:list={['location-card', location.className, { active: index === 0 }]} data-location-card>
            <button
              class="location-select"
              type="button"
              data-map-src={mapEmbed(location.query)}
              data-map-title={location.zone}
              data-map-frame-title={`Mapa de Pollo Fresa en ${location.zone}`}
              aria-label={`Mostrar ${location.zone} en el mapa`}
            >
              <span class="location-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="location-main">
                <span class="location-top"><small>{location.badge}</small><i>↗</i></span>
                <strong>{location.zone}</strong>
                <span>{location.address}</span>
                <em>{location.detail}</em>
              </span>
            </button>
            <div class="location-meta">
              <span class="hours"><i></i>{location.hours}</span>
              {location.phone && <a href={location.phoneHref} aria-label={`Llamar a la sucursal ${location.zone}`}><small>LLAMAR</small>{location.phone}{location.secondPhone && <em> / {location.secondPhone}</em>}</a>}
            </div>
            <a class="directions-link" href={directions(location.query)} target="_blank" rel="noreferrer">
              <span>Cómo llegar</span><b>↗</b>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="location-note">
      <span class="note-icon">!</span>
      <div><small>ANTES DE VISITARNOS</small><h2>Que el antojo no<br /><i>te haga dar vueltas.</i></h2></div>
      <p>Algunas fichas comerciales no publican número exterior, teléfono u horario. En esos casos, abre la ruta y confirma que el punto siga operando.</p>
      <a href="/pedir">Pedir ahora <span>↗</span></a>
    </section>
  </main>
  <Footer />
  <WhatsappFlotante />
</Layout>

<script>
  const map = document.querySelector('[data-location-map]');
  const mapTitle = document.querySelector('[data-map-title]');
  const cards = document.querySelectorAll('[data-location-card]');

  cards.forEach((card) => {
    const button = card.querySelector('[data-map-src]');
    button?.addEventListener('click', () => {
      if (!(button instanceof HTMLElement) || !(map instanceof HTMLIFrameElement)) return;
      map.src = button.dataset.mapSrc ?? map.src;
      map.title = button.dataset.mapFrameTitle ?? map.title;
      if (mapTitle) mapTitle.textContent = button.dataset.mapTitle ?? '';
      cards.forEach((item) => item.classList.remove('active'));
      card.classList.add('active');
      if (window.innerWidth < 860) map.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>

<style>
  .locations-hero { position: relative; min-height: 820px; overflow: hidden; color: #fff4df; background: #210b06; isolation: isolate; }
  .hero-media { position: absolute; z-index: -4; inset: 0 0 0 39%; overflow: hidden; }
  .hero-media::after { position: absolute; content: ''; inset: 0; background: linear-gradient(90deg, #210b06 0%, transparent 45%), linear-gradient(0deg, #210b06 0%, transparent 35%), #c51f2b0d; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: 55% center; filter: saturate(1.26) contrast(1.12) brightness(.82); transform: scale(1.035); animation: hero-zoom 16s ease-in-out infinite alternate; }
  .hero-overlay { position: absolute; z-index: -3; inset: 0; background: linear-gradient(90deg, #210b06 0 39%, #210b06ec 48%, #210b0638 72%, #210b0699 100%), linear-gradient(0deg, #210b06 0%, transparent 29%); }
  .hero-overlay::before { position: absolute; content: ''; top: 0; bottom: 0; left: 0; width: 53%; background-image: radial-gradient(#ffd36a24 1px, transparent 1px); background-size: 12px 12px; mask-image: linear-gradient(90deg, #000 5%, transparent 95%); }
  .hero-overlay::after { position: absolute; content: ''; top: 112px; right: -115px; width: 510px; height: 510px; border: 1px solid #ffd36a55; border-radius: 50%; box-shadow: 0 0 0 78px #ffd36a0b, 0 0 0 156px #ffd36a08; }
  .hero-map-lines { position: absolute; z-index: -2; inset: 0; opacity: .55; pointer-events: none; }
  .hero-map-lines i { position: absolute; display: block; height: 1px; border-top: 1px dashed #ffd36a5c; transform-origin: left; }
  .hero-map-lines i:nth-child(1) { top: 196px; right: -50px; width: 510px; transform: rotate(22deg); }
  .hero-map-lines i:nth-child(2) { top: 300px; right: 230px; width: 390px; transform: rotate(73deg); }
  .hero-map-lines i:nth-child(3) { right: 45px; bottom: 245px; width: 450px; transform: rotate(-18deg); }
  .hero-map-lines i:nth-child(4) { top: 135px; right: 360px; width: 300px; transform: rotate(115deg); }
  .hero-shell { position: relative; display: grid; width: min(1180px, calc(100% - 64px)); min-height: 820px; grid-template-columns: minmax(0, 1fr) 385px; gap: 65px; align-items: center; margin: auto; padding: 135px 0 105px; }
  .hero-copy { position: relative; z-index: 3; padding-top: 20px; }
  .hero-copy > p { display: flex; align-items: center; gap: 11px; margin: 0 0 26px; color: #ffd36a; font-size: 9px; font-weight: 900; letter-spacing: .18em; text-transform: uppercase; }
  .hero-copy > p span { display: block; width: 33px; height: 3px; background: #c51f2b; box-shadow: 10px 0 0 #f28c16; }
  .hero-copy h1 { max-width: 770px; margin: 0; color: #fff4df; font-family: var(--font-display); font-size: clamp(79px, 8.3vw, 118px); font-weight: 400; letter-spacing: -.048em !important; line-height: .77; text-shadow: 0 18px 40px #17070455; }
  .hero-copy h1 i { color: #ffd36a; text-shadow: 4px 4px 0 #c51f2b; }
  .hero-description { display: block; max-width: 440px; margin-top: 30px; padding-left: 18px; border-left: 2px solid #c51f2b; color: #fff4dfbf; font-size: 13px; line-height: 1.72; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .hero-actions a { display: flex; min-width: 190px; justify-content: space-between; align-items: center; padding: 16px 18px; font-size: 9px; font-weight: 900; text-decoration: none; text-transform: uppercase; transition: transform .22s, background .22s, border-color .22s; }
  .hero-actions a:hover { transform: translateY(-3px); }
  .hero-primary { color: #fff; background: #c51f2b; box-shadow: 0 10px 25px #17070466; }
  .hero-primary:hover { background: #df2935; }
  .hero-primary b { color: #ffd36a; font-size: 17px; }
  .hero-secondary { border: 1px solid #ffd36a59; color: #ffd36a; background: #210b068f; backdrop-filter: blur(9px); }
  .hero-secondary:hover { border-color: #ffd36a; background: #ffd36a12; }
  .hero-secondary b { color: #fff4df; font-size: 16px; }
  .hero-facts { display: flex; width: min(515px, 100%); margin-top: 35px; border-top: 1px solid #ffd36a30; border-bottom: 1px solid #ffd36a30; }
  .hero-facts > div { display: flex; flex: 1; align-items: center; gap: 9px; padding: 13px 14px 13px 0; }
  .hero-facts > div + div { padding-left: 17px; border-left: 1px solid #ffd36a30; }
  .hero-facts strong { color: #f28c16; font-family: var(--font-display); font-size: 29px; font-weight: 400; line-height: 1; }
  .hero-facts span { color: #fff4df8c; font-size: 6px; font-weight: 900; line-height: 1.45; letter-spacing: .08em; text-transform: uppercase; }
  .hero-locator { position: relative; z-index: 3; align-self: end; margin-bottom: 77px; border: 1px solid #ffd36a54; color: #422018; background: #ffd36a; box-shadow: 18px 18px 0 #c51f2b, 0 28px 60px #17070480; transform: rotate(1.5deg); }
  .locator-heading { display: grid; grid-template-columns: 43px 1fr 65px; gap: 11px; align-items: center; min-height: 78px; padding: 12px 13px; border-bottom: 1px solid #42201826; }
  .locator-pin { position: relative; width: 34px; height: 34px; border-radius: 50% 50% 50% 7px; background: #c51f2b; transform: rotate(-45deg); }
  .locator-pin i { position: absolute; inset: 10px; border: 3px solid #fff4df; border-radius: 50%; }
  .locator-heading > div { display: grid; gap: 4px; }
  .locator-heading small { color: #c51f2b; font-size: 5px; font-weight: 900; letter-spacing: .13em; }
  .locator-heading strong { font-family: var(--font-display); font-size: 23px; font-weight: 400; }
  .locator-logo { position: relative; display: block; width: 65px; height: 58px; overflow: hidden; }
  .locator-logo img { position: absolute; top: 50%; left: 50%; width: 145px; max-width: none; transform: translate(-50%, -50%); }
  .locator-route { position: relative; height: 137px; overflow: hidden; background: #f6c651; }
  .locator-route::before { position: absolute; content: ''; inset: 0; opacity: .19; background-image: linear-gradient(#422018 1px, transparent 1px), linear-gradient(90deg, #422018 1px, transparent 1px); background-size: 24px 24px; }
  .locator-route svg { position: absolute; width: calc(100% - 25px); height: 126px; inset: 6px 12px; overflow: visible; }
  .locator-route path { fill: none; stroke: #c51f2b; stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 5 7; }
  .route-point { position: absolute; z-index: 2; display: grid; width: 24px; height: 24px; place-items: center; border: 3px solid #f6c651; border-radius: 50%; background: #422018; box-shadow: 0 0 0 1px #422018; }
  .route-point i { color: #fff4df; font-size: 5px; font-style: normal; font-weight: 900; }
  .point-one { left: 20px; bottom: 27px; }
  .point-two { top: 52px; left: 46%; background: #c51f2b; box-shadow: 0 0 0 1px #c51f2b; }
  .point-three { top: 30px; right: 23px; }
  .locator-bottom { display: grid; grid-template-columns: 1fr 85px; min-height: 92px; }
  .locator-bottom > div { display: grid; align-content: center; padding: 15px; }
  .locator-bottom > div small { color: #c51f2b; font-size: 5px; font-weight: 900; letter-spacing: .14em; }
  .locator-bottom > div strong { margin-top: 4px; font-family: var(--font-display); font-size: 18px; font-weight: 400; }
  .locator-bottom > div span { margin-top: 3px; color: #79584a; font-size: 7px; }
  .locator-bottom > a { display: grid; grid-template-columns: 1fr auto; align-items: center; padding: 11px; color: #fff4df; background: #422018; font-family: var(--font-display); font-size: 34px; line-height: 1; text-decoration: none; }
  .locator-bottom > a small { align-self: start; color: #ffd36a; font-family: var(--font-body); font-size: 5px; font-weight: 900; letter-spacing: .1em; writing-mode: vertical-rl; }
  .locator-bottom > a b { grid-column: 1 / -1; justify-self: end; color: #f28c16; font-size: 15px; }
  .hero-city { position: absolute; z-index: -1; right: -13px; bottom: -29px; color: transparent; font-family: var(--font-display); font-size: clamp(120px, 18vw, 260px); line-height: .75; letter-spacing: -.045em; -webkit-text-stroke: 1px #ffd36a1f; white-space: nowrap; }
  .hero-scroll { position: absolute; bottom: 35px; left: max(32px, calc((100vw - 1180px) / 2)); display: flex; align-items: center; gap: 10px; color: #fff4df70; text-decoration: none; }
  .hero-scroll span { position: relative; width: 24px; height: 38px; border: 1px solid #ffd36a55; border-radius: 14px; }
  .hero-scroll span::after { position: absolute; top: 7px; left: 10px; width: 2px; height: 8px; content: ''; background: #ffd36a; animation: scroll-dot 1.8s ease-in-out infinite; }
  .hero-scroll small { font-size: 6px; font-weight: 900; letter-spacing: .16em; }
  @keyframes hero-zoom { to { transform: scale(1.075); } }
  @keyframes scroll-dot { 50% { transform: translateY(10px); opacity: .25; } }

  .locations-intro { display: grid; width: min(1180px, calc(100% - 64px)); grid-template-columns: 1fr 390px; gap: 80px; align-items: end; margin: auto; padding: 120px 0 62px; color: #422018; scroll-margin-top: 80px; }
  .intro-heading > p { margin: 0 0 18px; color: #c51f2b; font-size: 8px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .intro-heading > p span { display: inline-grid; width: 31px; height: 31px; place-items: center; margin-right: 10px; border: 1px solid #c51f2b55; border-radius: 50%; }
  .intro-heading h2 { margin: 0; font-family: var(--font-display); font-size: clamp(59px, 6.6vw, 90px); font-weight: 400; line-height: .8; }
  .intro-heading h2 i { color: #c51f2b; }
  .intro-copy { padding-left: 25px; border-left: 2px solid #ffd36a; }
  .intro-copy p { margin: 0 0 13px; color: #422018; font-size: 13px; font-weight: 800; line-height: 1.55; }
  .intro-copy span { color: #79584a; font-size: 10px; line-height: 1.65; }

  .locations-explorer { display: grid; width: min(1180px, calc(100% - 64px)); grid-template-columns: minmax(0, 1.22fr) minmax(380px, .78fr); gap: 18px; align-items: start; margin: 0 auto 130px; }
  .map-panel { position: sticky; top: 95px; overflow: hidden; border: 1px solid #42201822; background: #2c100b; box-shadow: 17px 17px 0 #ffd36a; }
  .map-heading { display: flex; justify-content: space-between; align-items: center; min-height: 76px; padding: 16px 20px; color: #fff4df; }
  .map-heading > div { display: grid; gap: 4px; }
  .map-heading small { color: #f28c16; font-size: 6px; font-weight: 900; letter-spacing: .18em; }
  .map-heading strong { font-family: var(--font-display); font-size: 25px; font-weight: 400; }
  .map-heading > span { display: flex; align-items: center; gap: 7px; color: #fff4df83; font-size: 7px; font-weight: 800; text-transform: uppercase; }
  .map-heading > span i { width: 7px; height: 7px; border-radius: 50%; background: #f28c16; box-shadow: 0 0 0 4px #f28c1623; }
  .map-panel iframe { display: block; width: 100%; height: 535px; border: 0; filter: saturate(.82) contrast(1.05); }
  .map-footer { display: flex; justify-content: space-between; gap: 20px; padding: 14px 20px; color: #fff4df70; font-size: 7px; }
  .map-footer b { color: #ffd36a; letter-spacing: .14em; }
  .locations-list { display: grid; gap: 10px; }
  .location-card { position: relative; overflow: hidden; border: 1px solid #42201820; background: #f5e4c8; transition: border-color .2s, transform .2s, box-shadow .2s; }
  .location-card:hover { border-color: #c51f2b70; transform: translateX(-4px); }
  .location-card.active { border-color: #c51f2b; box-shadow: inset 4px 0 0 #c51f2b; background: #fff8ec; }
  .location-select { display: grid; width: 100%; grid-template-columns: 47px 1fr; gap: 13px; padding: 20px 18px 15px; border: 0; color: #422018; background: transparent; text-align: left; cursor: pointer; }
  .location-number { display: grid; width: 39px; height: 39px; place-items: center; border: 1px solid #42201830; border-radius: 50%; color: #c51f2b; font-family: var(--font-display); font-size: 14px; }
  .active .location-number { border-color: #c51f2b; color: #fff; background: #c51f2b; }
  .location-main { display: grid; }
  .location-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .location-top small { padding: 5px 7px; color: #422018; background: #ffd36a; font-size: 6px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .check .location-top small { color: #fff4df; background: #79584a; }
  .public .location-top small { color: #fff; background: #f28c16; }
  .location-top i { color: #c51f2b; font-size: 16px; font-style: normal; opacity: 0; transition: opacity .2s; }
